# Normalize line endings: force LF in the working tree and repo for all text
# files. Without this, core.autocrlf=true gives Windows checkouts CRLF working
# trees that mismatch the LF blobs, which makes formatters (e.g. Biome) report
# whole-file CRLF diffs. The binary/eol rules below override this per-path.
* text=auto eol=lf

# Generated data files - tracked but don't show diffs
# binary = -diff -merge -text
# -delta = skip delta compression (only for already-compressed files)
# linguist-generated = GitHub excludes from stats & collapses diffs
web/bible-on-site/src/data/db/*.tanah_view.json binary linguist-generated
app/BibleOnSite/Resources/Raw/*.tanah_view.sqlite binary -delta linguist-generated
app/BibleOnSite/Resources/Raw/*.perushim_catalog.sqlite binary -delta linguist-generated
app/BibleOnSite/Platforms/Android/AssetPacks/perushim_notes/*.sqlite.gz binary -delta linguist-generated
data/mysql/*_data.sql binary linguist-generated

# Shell scripts - force LF endings (required for Docker/Linux containers)
*.sh text eol=lf

# Font files - binary, no delta compression (already compressed)
*.ttf binary -delta
*.otf binary -delta
*.woff binary -delta
*.woff2 binary -delta