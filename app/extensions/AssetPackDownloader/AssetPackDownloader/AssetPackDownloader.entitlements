<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Same app group as the host app; Background Assets coordinates managed
	     asset-pack downloads between the extension and app through it. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.tanah.daily929.assets</string>
	</array>
</dict>
</plist>
