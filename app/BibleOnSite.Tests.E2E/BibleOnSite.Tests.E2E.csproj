<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit.net v3 test projects are self-running executables. -->
    <OutputType>Exe</OutputType>
    <!-- Run the test exe through Microsoft.Testing.Platform (app/global.json sets dotnet test's runner). -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <!-- Allow restore on non-Windows runners (e.g. GitHub dependency submission on Ubuntu);
         the tests still only execute on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Needed for WinUI3 automation -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <!-- FlaUI for Windows UI Automation -->
    <PackageReference Include="FlaUI.Core" Version="5.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

</Project>
