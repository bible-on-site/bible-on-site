<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net10.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>BibleOnSite</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Define MAUI symbol for conditional compilation -->
		<DefineConstants>$(DefineConstants);MAUI</DefineConstants>

		<!-- Analytics gating (#2120): Debug builds — local dev and every mobile-e2e
		     build (CompileMobileE2E also passes -p:DisableAnalytics=true explicitly
		     so the protection is build-flag driven, not just configuration-derived) —
		     get DISABLE_ANALYTICS: AnalyticsService becomes a no-op, the iOS Firebase
		     init is skipped entirely, and firebase_analytics_collection_deactivated
		     is baked into the Android manifest. Release builds default to analytics
		     on; pass -p:DisableAnalytics=false to force a Debug build back on. -->
		<DisableAnalytics Condition="'$(DisableAnalytics)' == '' AND '$(Configuration)' == 'Debug'">true</DisableAnalytics>
		<DefineConstants Condition="'$(DisableAnalytics)' == 'true'">$(DefineConstants);DISABLE_ANALYTICS</DefineConstants>

		<!-- Treat C# compiler warnings as errors so iOS/Android-only issues are caught early -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<!-- Suppress XamlC warnings: XC0022 bindings without x:DataType; XC0045 Path in MultiBinding with Source=page validated against template DataType (Article) -->
		<!-- Suppress MVVMTK0045: [ObservableProperty] field-based code gen is not WinRT AOT-compatible;
		     migration to partial properties requires CommunityToolkit.Mvvm 9.x — tracked separately -->
		<!-- NU1608: transitive AndroidX .Ktx packages have tight upper-bound constraints that
		     conflict with newer non-Ktx versions pulled by Play Asset Delivery 2.3.0.5;
		     the newer versions are backward-compatible so the warning is safe to suppress. -->
		<!-- XAAMM0000: manifest merger namespace-collision warnings from Firebase + PAD on .NET 10 —
		     re-evaluate if still needed after future Firebase/PAD package updates. -->
		<NoWarn>$(NoWarn);XC0022;XC0045;MVVMTK0045;NU1608;XAAMM0000</NoWarn>

		<!-- Enable compiled bindings with Source property -->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<!-- Enable XAML Hot Reload -->
		<MauiEnableXamlHotReload>true</MauiEnableXamlHotReload>

		<!-- Display name - must match Partner Center reserved name for MS Store -->
		<ApplicationTitle>929 - תנ"ך על הפרק</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.tanah.daily929</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>5.0.227</ApplicationDisplayVersion>
		<!-- Windows MSIX requires each version component ≤65535, so we use a separate incrementing value -->
		<!-- Android versionCode can be large, continuing from Play Store's 40000017 -->
		<ApplicationVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">50000227</ApplicationVersion>
		<ApplicationVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'">227</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<!-- WindowsPackageType None = unpackaged (fixes "Class not registered" when running from CLI). MSIX for Store: /p:WindowsPackageType=MSIX -->
		<WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<!-- For Release: embed assemblies in APK. For Debug: use Fast Deployment (much faster iteration) -->
		<EmbedAssembliesIntoApk Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' AND '$(Configuration)' == 'Release'">true</EmbedAssembliesIntoApk>
		<!-- Android Release: profiled AOT. The .NET 10 SDK (Microsoft.Android.Sdk 36.x)
		     already defaults RunAOTCompilation + AndroidEnableProfiledAot to true for
		     Release on the MonoVM runtime and feeds the bundled dotnet.aotprofile into
		     the compiler — the pins below keep that behavior explicit and durable:
		     the SDK default only applies while '$(_AndroidRuntime)' == 'MonoVM', so a
		     future CoreCLR/PublishAot experiment or SDK default change would otherwise
		     silently drop AOT back to JIT. The UseMonoRuntime guard keeps the pin
		     inert if someone explicitly opts out of MonoVM on the command line.
		     Full AOT (AndroidEnableProfiledAot=false) is not an option: the linker
		     emits zero-RVA method stubs (e.g. System.Net.Requests.HttpWebRequest
		     local functions) that abort mono-aot-cross with exit 1.
		     AndroidStripILAfterAOT is deliberately NOT set: profiled AOT only
		     precompiles profiled methods, so JIT fallback for everything else
		     (including non-profiled generic instantiations) needs the IL kept
		     in the embedded assemblies. -->
		<RunAOTCompilation Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' AND '$(Configuration)' == 'Release' AND '$(UseMonoRuntime)' != 'false'">true</RunAOTCompilation>
		<AndroidEnableProfiledAot Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' AND '$(Configuration)' == 'Release' AND '$(UseMonoRuntime)' != 'false'">true</AndroidEnableProfiledAot>
		<!-- Android Release: R8 shrinks the Java/Kotlin DEX (AndroidX, Firebase, Media3,
		     Glide, Play Asset Delivery bindings) instead of plain D8 dexing (#2355):
		     uncompressed DEX 25.4 -> 14.0 MB, arm64 install download -3.8 MB, installed
		     size -15 MB, with unchanged cold/warm startup and build time. The SDK's
		     generated proguard_xamarin.cfg plus each AAR's consumer rules keep the JNI
		     peers, so no project keep rules are needed.

		     AndroidR8ObfuscationMode=private-members (#2708): Google Play's technical
		     quality requirements enforce a minimum 25% for optimization, obfuscation
		     and shrinking on apps with over 10 MB of uncompressed DEX starting
		     February 2027; the flagged store build (5.0.139, cut before R8 landed)
		     reported "Low"/3% because it shipped the SDK's default -dontobfuscate
		     config. private-members switches R8 to the proguard-android-optimize.txt
		     baseline (real optimization passes) and obfuscates private/package-private
		     members while preserving every class/interface name and all
		     public/protected members — the exact surface JNI/ACW callbacks and the
		     SDK's generated keep rules cover. Requires Microsoft.Android.Sdk
		     36.1.118+ (workload set 10.0.402.1); older SDKs silently ignore the
		     property, so the _RequireR8ObfuscationSdkSupport target below fails
		     Release builds on stale workloads. The SDK embeds mapping.txt as
		     BUNDLE-METADATA/com.android.tools.build.obfuscation/proguard.map and
		     r8.json as BUNDLE-METADATA/com.android.tools/r8.json in the AAB — Play
		     ingests both with that exact versionCode (#1161) — and
		     devops/verify_android_dex_metadata.py asserts both on every packaged
		     bundle in CI.
		     Rollback: delete both properties to return to D8. -->
		<AndroidLinkTool Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' AND '$(Configuration)' == 'Release'">r8</AndroidLinkTool>
		<AndroidR8ObfuscationMode Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' AND '$(Configuration)' == 'Release'">private-members</AndroidR8ObfuscationMode>
		<!-- Debug APKs include the large commentary database. Store SQLite assets directly
		     to avoid recompressing it on every local edit; Release packaging keeps compression. -->
		<AndroidStoreUncompressedFileExtensions Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' AND '$(Configuration)' == 'Debug'">$(AndroidStoreUncompressedFileExtensions);.sqlite</AndroidStoreUncompressedFileExtensions>
		<!-- .NET 10 MAUI on Linux CI: the SDK infers RuntimeIdentifier=linux-x64 for
		     self-contained apps, appending it to RuntimeIdentifiers. The Android SDK then
		     fails with XA0035. The Nuke build script pins RuntimeIdentifier=android-arm64
		     on the command line (immutable global property). UseCurrentRuntimeIdentifier=false
		     provides defense-in-depth for local dev builds. -->
		<UseCurrentRuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</UseCurrentRuntimeIdentifier>
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm64;android-arm;android-x64;android-x86</RuntimeIdentifiers>
		<!-- Optional: Build AAB in Debug for local PAD testing (asset packs require AAB). Uncomment to test on-demand downloads. -->
		<!-- <AndroidPackageFormat Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' AND '$(Configuration)' == 'Debug'">aab</AndroidPackageFormat> -->
		<!-- <EmbedAssembliesIntoApk Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' AND '$(Configuration)' == 'Debug'">true</EmbedAssembliesIntoApk> -->
		<!-- Optional: AndroidBundleToolExtraArgs for Debug AAB (add flag for local testing) -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- #2708: AndroidR8ObfuscationMode only exists in Microsoft.Android.Sdk
	     36.1.118+ (workload set 10.0.402.1); on older packs the property is a
	     silent no-op and the build would ship a non-obfuscated bundle that looks
	     compliant on paper. Fail instead of silently shipping -dontobfuscate.
	     The version suffix is stripped so preview SDKs (e.g. 37.0.0-rc.1) compare
	     correctly; an empty version means the Android workload never loaded. -->
	<Target Name="_RequireR8ObfuscationSdkSupport" BeforeTargets="PrepareForBuild"
			Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' AND '$(AndroidR8ObfuscationMode)' != '' AND '$(AndroidR8ObfuscationMode)' != 'disabled'">
		<Error Condition="'$(AndroidNETSdkVersion)' == ''"
				Text="AndroidR8ObfuscationMode='$(AndroidR8ObfuscationMode)' requires the Android workload to report its SDK version; none was found." />
		<Error Condition="'$(AndroidNETSdkVersion)' != '' AND $([MSBuild]::VersionLessThan($(AndroidNETSdkVersion.Split('-')[0]), '36.1.118'))"
				Text="AndroidR8ObfuscationMode='$(AndroidR8ObfuscationMode)' requires Microsoft.Android.Sdk 36.1.118+ (workload set 10.0.402.1+); found $(AndroidNETSdkVersion). Run 'dotnet workload update' or install maui-android with --version 10.0.402.1." />
	</Target>

	<ItemGroup>
		<InternalsVisibleTo Include="BibleOnSite.Tests" />
	</ItemGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1552ac" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<!-- Launcher icons are not runtime images on iOS; bundle the same artwork for the loading page. -->
		<MauiImage Include="Resources\AppIcon\appicon.svg" Link="loading_logo.svg" BaseSize="150,150" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*.ttf;Resources\Fonts\*.otf" />
		<!-- The MauiFont glob covers the TTF only — ship the font's GPL
		     attribution inside the package too (#2623). -->
		<MauiAsset Include="Resources\Fonts\TaameyD-license.txt" LogicalName="TaameyD-license.txt" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- Firebase: google-services.json for Android (same Firebase project as legacy app: tanah-al-haperek) -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<GoogleServicesJson Include="Platforms\Android\google-services.json" />
	</ItemGroup>

	<!-- #2120: inject firebase_analytics_collection_deactivated into the merged
	     manifest so test builds permanently deactivate collection at the SDK
	     layer — setAnalyticsCollectionEnabled cannot re-enable it and nothing
	     is emitted, persisted or flushed. DisableAnalytics builds resolve to
	     true; everything else resolves to false so production analytics keep
	     working. The fallback guarantees the placeholder is always defined. -->
	<PropertyGroup>
		<FirebaseAnalyticsCollectionDeactivated Condition="'$(DisableAnalytics)' == 'true'">true</FirebaseAnalyticsCollectionDeactivated>
		<FirebaseAnalyticsCollectionDeactivated Condition="'$(FirebaseAnalyticsCollectionDeactivated)' == ''">false</FirebaseAnalyticsCollectionDeactivated>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidManifestPlaceholders>$(AndroidManifestPlaceholders);firebaseAnalyticsCollectionDeactivated=$(FirebaseAnalyticsCollectionDeactivated)</AndroidManifestPlaceholders>
	</PropertyGroup>

	<!-- Firebase: GoogleService-Info.plist for iOS (same Firebase project: tanah-al-haperek) -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<BundleResource Include="Platforms\iOS\GoogleService-Info.plist" LogicalName="GoogleService-Info.plist" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<BundleResource Include="Platforms\iOS\GoogleService-Info.plist" LogicalName="GoogleService-Info.plist" />
	</ItemGroup>

	<!-- ============================================================
	     Perushim Notes — on-demand delivery (Android PAD + iOS managed asset packs)
	     ============================================================ -->

	<!-- Codesigning entitlements: the iOS/MacCatalyst app groups entry shares a
	     container with the AssetPackDownloader extension (managed Background Assets).
	     Two SDK conventions shaped this wiring:
	     - MAUI's SingleProject targets auto-assign $(iOSProjectFolder)Entitlements.plist
	       to CodesignEntitlements whenever that exact path exists — bypassing any
	       per-RID condition — so the file is named Entitlements.App.plist.
	     - A non-empty CodesignEntitlements makes DetectSigningIdentity require a
	       provisioning profile + signing key, which unsigned iossimulator CI/e2e
	       builds do not have. RuntimeIdentifier defaults are only resolved after
	       csproj evaluation (a RID-less Debug build lands on iossimulator), so the
	       assignment runs in a target where the SDK-computed _SdkIsSimulator flag —
	       the same flag DetectSigningIdentity consumes — is already known. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<CodesignEntitlements>Platforms\MacCatalyst\Entitlements.plist</CodesignEntitlements>
	</PropertyGroup>
	<Target Name="_SetIosCodesignEntitlements" BeforeTargets="_DetectSigningIdentity" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' AND '$(_SdkIsSimulator)' != 'true' AND '$(EnableCodeSigning)' != 'false'">
		<PropertyGroup>
			<CodesignEntitlements>Platforms\iOS\Entitlements.App.plist</CodesignEntitlements>
		</PropertyGroup>
		<Message Importance="low" Text="=== iOS device/desktop build: CodesignEntitlements = $(CodesignEntitlements) ===" />
	</Target>

	<!-- Android: Play Asset Delivery SDK.
	     XAAMM0000 manifest collisions with Plugin.Firebase are suppressed in NoWarn above. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.Google.Android.Play.Asset.Delivery" Version="2.3.0.8" />
	</ItemGroup>

	<!-- D8 duplicate-class workaround: PAD + Firebase transitively pull in AndroidX
	     .Ktx/.Jvm packages that duplicate Java classes from the base .Android variant,
	     causing D8 JAVA0000 "defined multiple times" errors.
	     ExcludeAssets="all" prevents JARs from version-compatible packages entering D8.
	     For packages with NuGet version conflicts (where ExcludeAssets triggers NU1107),
	     a target strips the duplicate .aar from @(AndroidAarLibrary) before extraction. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.AndroidX.Compose.Runtime.Annotation.Jvm" Version="1.12.1" ExcludeAssets="all" />
		<!-- Fragment 1.9 merges Kotlin extensions into the main artifact. Keep Ktx
		     aligned so Firebase's older transitive Ktx does not duplicate those classes.
		     https://developer.android.com/jetpack/androidx/releases/fragment#1.9.0-alpha01 -->
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
	</ItemGroup>
	<Target Name="_RemoveDuplicateAndroidXAars" BeforeTargets="_ResolveAars;_ExtractAar;_GetLibraryImports" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<ItemGroup>
			<AndroidAarLibrary Remove="@(AndroidAarLibrary)" Condition="$([System.String]::new('%(Filename)').EndsWith('savedstate-ktx'))" />
		</ItemGroup>
	</Target>

	<!-- Auto-decompress perushim notes .gz → .sqlite if needed (checked out from git as compressed).
	     Calls the devops setup script which has the canonical decompress logic.
	     WorkingDirectory must be devops/ so the script's node_modules resolve. -->
	<Target Name="DecompressPerushimNotes" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' AND&#xD;&#xA;			((!Exists('Platforms\Android\AssetPacks\perushim_notes\sefaria-dump-5784-sivan-4.perushim_notes.sqlite') AND&#xD;&#xA;			Exists('Platforms\Android\AssetPacks\perushim_notes\sefaria-dump-5784-sivan-4.perushim_notes.sqlite.gz')) OR&#xD;&#xA;			(!Exists('Platforms\Android\AssetPacks\perushim_notes\sefaria-dump-5784-sivan-4.hebrew_search.sqlite') AND&#xD;&#xA;			Exists('Platforms\Android\AssetPacks\perushim_notes\sefaria-dump-5784-sivan-4.hebrew_search.sqlite.gz')))">
		<Exec Command="node setup-dev-env.mts decompress-perushim-notes" WorkingDirectory="$(MSBuildProjectDirectory)/../../devops" />
	</Target>

	<!-- Android: PAD on-demand asset pack. Run perushim-view pipeline to generate.
	     The prebuilt search index is required by prepare_perushim_assets.py
	     for CI and release packs. Local legacy packs retain the recovery path. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' AND (Exists('Platforms\Android\AssetPacks\perushim_notes\sefaria-dump-5784-sivan-4.perushim_notes.sqlite') OR Exists('Platforms\Android\AssetPacks\perushim_notes\sefaria-dump-5784-sivan-4.perushim_notes.sqlite.gz'))">
		<AndroidAsset Include="Platforms\Android\AssetPacks\perushim_notes\sefaria-dump-5784-sivan-4.perushim_notes.sqlite" Link="sefaria-dump-5784-sivan-4.perushim_notes.sqlite" AssetPack="perushim_notes" DeliveryType="OnDemand" />
		<AndroidAsset Include="Platforms\Android\AssetPacks\perushim_notes\sefaria-dump-5784-sivan-4.hebrew_search.sqlite" Condition="Exists('Platforms\Android\AssetPacks\perushim_notes\sefaria-dump-5784-sivan-4.hebrew_search.sqlite') OR Exists('Platforms\Android\AssetPacks\perushim_notes\sefaria-dump-5784-sivan-4.hebrew_search.sqlite.gz')" Link="sefaria-dump-5784-sivan-4.hebrew_search.sqlite" AssetPack="perushim_notes" DeliveryType="OnDemand" />
	</ItemGroup>

	<!-- iOS: decompress .gz → .sqlite payloads into the managed asset-pack folder (macOS only; gunzip is
	     always available). The pack directory layout is produced by prepare_perushim_assets.py; payloads
	     sit next to Manifest.json so `xcrun ba-package` can archive the pack for App Store Connect upload.
	     The prebuilt search index rides in the same pack — the manifest selects it and the
	     managed-delivery extraction requires it. -->
	<Target Name="DecompressPerushimNotesIos" BeforeTargets="PrepareForBuild;Build" Condition="($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' OR $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst') AND&#xD;&#xA;			((!Exists('Platforms\iOS\AssetPacks\perushim-notes\sefaria-dump-5784-sivan-4.perushim_notes.sqlite') AND&#xD;&#xA;			Exists('Platforms\Android\AssetPacks\perushim_notes\sefaria-dump-5784-sivan-4.perushim_notes.sqlite.gz')) OR&#xD;&#xA;			(!Exists('Platforms\iOS\AssetPacks\perushim-notes\sefaria-dump-5784-sivan-4.hebrew_search.sqlite') AND&#xD;&#xA;			Exists('Platforms\Android\AssetPacks\perushim_notes\sefaria-dump-5784-sivan-4.hebrew_search.sqlite.gz')))">
		<MakeDir Directories="Platforms\iOS\AssetPacks\perushim-notes" />
		<Exec Condition="!Exists('Platforms\iOS\AssetPacks\perushim-notes\sefaria-dump-5784-sivan-4.perushim_notes.sqlite') AND Exists('Platforms\Android\AssetPacks\perushim_notes\sefaria-dump-5784-sivan-4.perushim_notes.sqlite.gz')" Command="gunzip -c '$(MSBuildProjectDirectory)/Platforms/Android/AssetPacks/perushim_notes/sefaria-dump-5784-sivan-4.perushim_notes.sqlite.gz' &gt; '$(MSBuildProjectDirectory)/Platforms/iOS/AssetPacks/perushim-notes/sefaria-dump-5784-sivan-4.perushim_notes.sqlite'" />
		<Exec Condition="!Exists('Platforms\iOS\AssetPacks\perushim-notes\sefaria-dump-5784-sivan-4.hebrew_search.sqlite') AND Exists('Platforms\Android\AssetPacks\perushim_notes\sefaria-dump-5784-sivan-4.hebrew_search.sqlite.gz')" Command="gunzip -c '$(MSBuildProjectDirectory)/Platforms/Android/AssetPacks/perushim_notes/sefaria-dump-5784-sivan-4.hebrew_search.sqlite.gz' &gt; '$(MSBuildProjectDirectory)/Platforms/iOS/AssetPacks/perushim-notes/sefaria-dump-5784-sivan-4.hebrew_search.sqlite'" />
	</Target>

	<!-- Managed Background Assets need an ExtensionKit downloader extension embedded at
	     <app>/Extensions — a binary .NET cannot produce (Swift-only entry point), so the
	     packaging pipeline builds app/extensions/AssetPackDownloader via xcodebuild and
	     passes the .appex path plus its provisioning profile. Distribution packaging
	     requires both; unsigned development/simulator builds can omit the extension. -->
	<Target Name="_RequireAssetPackDownloader" BeforeTargets="PrepareForBuild" Condition="($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' OR $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst')">
		<PropertyGroup>
			<RequireAssetPackDownloader Condition="'$(RequireAssetPackDownloader)' == '' AND ('$(BuildIpa)' == 'true' OR '$(ArchiveOnBuild)' == 'true') AND '$(EnableCodeSigning)' != 'false'">true</RequireAssetPackDownloader>
		</PropertyGroup>
		<Error Condition="'$(RequireAssetPackDownloader)' == 'true' AND ('$(AssetPackDownloaderAppex)' == '' OR (!Exists('$(AssetPackDownloaderAppex)/Info.plist') AND !Exists('$(AssetPackDownloaderAppex)/Contents/Info.plist')))" Text="Signed distribution requires a built AssetPackDownloader.appex; set AssetPackDownloaderAppex to its device build directory." />
		<Error Condition="'$(RequireAssetPackDownloader)' == 'true' AND ('$(AssetPackDownloaderProfile)' == '' OR !Exists('$(AssetPackDownloaderProfile)'))" Text="Signed distribution requires the downloader provisioning profile with App Groups; set AssetPackDownloaderProfile." />
		<Error Condition="'$(AssetPackDownloaderAppex)' != '' AND !Exists('$(AssetPackDownloaderAppex)')" Text="AssetPackDownloaderAppex does not exist: $(AssetPackDownloaderAppex)" />
	</Target>
	<Target Name="_EmbedAssetPackDownloader" BeforeTargets="_CodesignAppBundle" Condition="'$(AssetPackDownloaderAppex)' != '' AND&#xD;&#xA;			Exists('$(AssetPackDownloaderAppex)') AND&#xD;&#xA;			($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' OR $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst')">
		<PropertyGroup>
			<_AssetPackExtensionDir Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">$(AppBundleDir)/Extensions</_AssetPackExtensionDir>
			<_AssetPackExtensionDir Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">$(AppBundleDir)/Contents/Extensions</_AssetPackExtensionDir>
			<_AssetPackExtensionProfile Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">embedded.mobileprovision</_AssetPackExtensionProfile>
			<_AssetPackExtensionProfile Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">embedded.provisionprofile</_AssetPackExtensionProfile>
			<_AssetPackSigningEntitlements>$(IntermediateOutputPath)asset-pack-downloader.entitlements</_AssetPackSigningEntitlements>
			<_AssetPackProfileArguments Condition="'$(AssetPackDownloaderProfile)' != ''">--profile &quot;$(AssetPackDownloaderProfile)&quot; --entitlements &quot;$(MSBuildProjectDirectory)/../extensions/AssetPackDownloader/AssetPackDownloader/AssetPackDownloader.entitlements&quot; --output-entitlements &quot;$(_AssetPackSigningEntitlements)&quot;</_AssetPackProfileArguments>
		</PropertyGroup>
		<Error Condition="'$(EnableCodeSigning)' == 'true' AND ('$(AssetPackDownloaderProfile)' == '' OR !Exists('$(AssetPackDownloaderProfile)'))" Text="Signing the downloader requires its own provisioning profile with the shared App Group." />
		<Error Condition="'$(EnableCodeSigning)' == 'true' AND '$(_CodeSigningKey)' == ''" Text="The app signing identity was not resolved before embedding the downloader." />
		<MakeDir Directories="$(_AssetPackExtensionDir)" />
		<Exec Command="ditto '$(AssetPackDownloaderAppex)' '$(_AssetPackExtensionDir)/AssetPackDownloader.appex'" />
		<Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../extensions/prepare_extension.py&quot; --extension &quot;$(_AssetPackExtensionDir)/AssetPackDownloader.appex&quot; --version &quot;$(ApplicationDisplayVersion)&quot; --build &quot;$(ApplicationVersion)&quot; $(_AssetPackProfileArguments)" />
		<Exec Command="cp '$(AssetPackDownloaderProfile)' '$(_AssetPackExtensionDir)/AssetPackDownloader.appex/$(_AssetPackExtensionProfile)'" Condition="'$(AssetPackDownloaderProfile)' != '' AND Exists('$(AssetPackDownloaderProfile)')" />
		<Exec Command="codesign --force --sign '$(_CodeSigningKey)' --entitlements '$(_AssetPackSigningEntitlements)' --timestamp=none '$(_AssetPackExtensionDir)/AssetPackDownloader.appex'" Condition="'$(EnableCodeSigning)' == 'true'" />
		<Exec Command="codesign --verify --strict '$(_AssetPackExtensionDir)/AssetPackDownloader.appex'" Condition="'$(EnableCodeSigning)' == 'true'" />
		<Message Importance="high" Text="=== Embedded AssetPackDownloader.appex into $(AppBundleDir) ===" />
	</Target>

	<!-- Generated book packs use the same delivery SDK, independently of perushim_notes. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidAsset Include="Platforms\Android\AssetPacks\recitation_*\*.zip" Link="%(Filename)%(Extension)" AssetPack="%(Filename)" DeliveryType="OnDemand" />
		<MauiAsset Include="Platforms\Android\AssetPacks\recitation_*\*.zip" LogicalName="%(Filename)%(Extension)" Condition="'$(Configuration)' == 'Debug'" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<MauiAsset Include="Platforms\Windows\Recitation\*.zip" LogicalName="%(Filename)%(Extension)" />
	</ItemGroup>
	<ItemGroup Condition="($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' OR $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst') AND '$(Configuration)' == 'Debug'">
		<MauiAsset Include="Platforms\iOS\AssetPacks\recitation-*\*.zip" LogicalName="%(Filename)%(Extension)" />
	</ItemGroup>
	<Target Name="RequireRecitationExtensionAssets" BeforeTargets="Build" Condition="'$(RequireRecitationAssets)' == 'true'">
		<Error Condition="!Exists('Resources/Raw/recitation-catalog.json')" Text="Generate the recitation catalog and book packs before packaging this release." />
	</Target>
	<!-- Android Debug fallback: bundle perushim notes in app package so they work without PAD (APK installs). -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' AND '$(Configuration)' == 'Debug' AND (Exists('Platforms\Android\AssetPacks\perushim_notes\sefaria-dump-5784-sivan-4.perushim_notes.sqlite') OR Exists('Platforms\Android\AssetPacks\perushim_notes\sefaria-dump-5784-sivan-4.perushim_notes.sqlite.gz'))">
		<MauiAsset Include="Platforms\Android\AssetPacks\perushim_notes\sefaria-dump-5784-sivan-4.perushim_notes.sqlite" LogicalName="sefaria-dump-5784-sivan-4.perushim_notes.sqlite" />
		<MauiAsset Include="Platforms\Android\AssetPacks\perushim_notes\sefaria-dump-5784-sivan-4.hebrew_search.sqlite" Condition="Exists('Platforms\Android\AssetPacks\perushim_notes\sefaria-dump-5784-sivan-4.hebrew_search.sqlite')" LogicalName="sefaria-dump-5784-sivan-4.hebrew_search.sqlite" />
	</ItemGroup>

	<!-- Simulator/local Debug installs cannot fetch a store-hosted asset pack (the
	     downloader extension is only embedded for signed Release packaging). -->
	<ItemGroup Condition="($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' OR $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst') AND '$(Configuration)' == 'Debug' AND Exists('Platforms\Android\AssetPacks\perushim_notes\sefaria-dump-5784-sivan-4.perushim_notes.sqlite.gz')">
		<MauiAsset Include="Platforms\iOS\AssetPacks\perushim-notes\sefaria-dump-5784-sivan-4.perushim_notes.sqlite" LogicalName="sefaria-dump-5784-sivan-4.perushim_notes.sqlite" />
		<MauiAsset Include="Platforms\iOS\AssetPacks\perushim-notes\sefaria-dump-5784-sivan-4.hebrew_search.sqlite" Condition="Exists('Platforms\iOS\AssetPacks\perushim-notes\sefaria-dump-5784-sivan-4.hebrew_search.sqlite')" LogicalName="sefaria-dump-5784-sivan-4.hebrew_search.sqlite" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="GraphQL.Client" Version="6.1.0" />
		<PackageReference Include="GraphQL.Client.Serializer.SystemTextJson" Version="6.1.0" />
		<PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.120" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.14" />
		<PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
	</ItemGroup>

	<!-- Desktop reliability fixes for navigation layout, focus and keyboard input. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
	</ItemGroup>

	<!-- Plugin.Firebase supports iOS and Android only (not MacCatalyst or Windows) -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' OR $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Plugin.Firebase.Analytics" Version="4.0.0" />
		<PackageReference Include="Plugin.Firebase.Core" Version="4.2.0" />
	</ItemGroup>

	<!-- ============================================================
	     E2E app-process coverage (#1232)
	     Activated only by -p:E2ECoverage=true on instrumented test builds
	     (mobile E2E, Windows FlaUI). AltCover weaves sequence/branch visit
	     calls into the compiled assembly; the BibleOnSite.E2eCoverage
	     project provides the AltCover.Recorder.g substitute that collects
	     the real hits and serves them to the E2E harness over a loopback
	     endpoint. Store and production builds never set E2ECoverage.
	     ============================================================ -->
	<PropertyGroup>
		<AltCoverVersion>9.0.145</AltCoverVersion>
		<_E2EAltCoverTool Condition="'$(NuGetPackageRoot)' != ''">$(NuGetPackageRoot)altcover\$(AltCoverVersion)\tools\net8.0\AltCover.dll</_E2EAltCoverTool>
		<_E2EAltCoverTool Condition="'$(_E2EAltCoverTool)' == '' AND '$(NUGET_PACKAGES)' != ''">$(NUGET_PACKAGES)\altcover\$(AltCoverVersion)\tools\net8.0\AltCover.dll</_E2EAltCoverTool>
		<_E2EAltCoverTool Condition="'$(_E2EAltCoverTool)' == '' AND '$(USERPROFILE)' != ''">$(USERPROFILE)\.nuget\packages\altcover\$(AltCoverVersion)\tools\net8.0\AltCover.dll</_E2EAltCoverTool>
		<_E2EAltCoverTool Condition="'$(_E2EAltCoverTool)' == '' AND '$(HOME)' != ''">$(HOME)/.nuget/packages/altcover/$(AltCoverVersion)/tools/net8.0/AltCover.dll</_E2EAltCoverTool>
	</PropertyGroup>
	<ItemGroup Condition="'$(E2ECoverage)' == 'true'">
		<!-- The recorder is built as a standalone netstandard2.0 library by the
		     devops target before the app build, then referenced by path. A
		     ProjectReference would inherit the app build's global
		     TargetFrameworks and restore for the app's TFM. -->
		<Reference Include="AltCover.Recorder.g">
			<HintPath>..\BibleOnSite.E2eCoverage\bin\$(Configuration)\AltCover.Recorder.g.dll</HintPath>
		</Reference>
		<PackageReference Include="altcover" Version="$(AltCoverVersion)" PrivateAssets="all" ExcludeAssets="all" />
	</ItemGroup>

	<!-- Weave coverage calls into the compiled assembly. Runs after XamlC so
	     Debug (Runtime inflator / validate-only) and Release (IL rewrite)
	     both instrument the final IL. The pristine assembly is preserved for
	     restore on plain builds. -->
	<Target Name="_E2ECoverageInstrument" AfterTargets="XamlC" Condition="'$(E2ECoverage)' == 'true'"
			Inputs="$(IntermediateOutputPath)$(TargetFileName);$(IntermediateOutputPath)$(TargetName).pdb"
			Outputs="$(IntermediateOutputPath)e2e-coverage.stamp">
		<PropertyGroup>
			<!-- Evaluated inside the target: at load time IntermediateOutputPath
			     is still empty, which would leak artifacts to the project root. -->
			<_E2EAltDir>$(IntermediateOutputPath)e2e-coverage\</_E2EAltDir>
		</PropertyGroup>
		<Error Condition="!Exists('$(_E2EAltCoverTool)')" Text="AltCover tool not found at $(_E2EAltCoverTool); restore the altcover package." />
		<Copy SourceFiles="$(IntermediateOutputPath)$(TargetFileName)" DestinationFiles="$(IntermediateOutputPath)$(TargetName).uninstrumented.dll" />
		<Copy SourceFiles="$(IntermediateOutputPath)$(TargetName).pdb" DestinationFiles="$(IntermediateOutputPath)$(TargetName).uninstrumented.pdb" Condition="Exists('$(IntermediateOutputPath)$(TargetName).pdb')" />
		<MakeDir Directories="$(_E2EAltDir)stage;$(_E2EAltDir)instr" />
		<Copy SourceFiles="$(IntermediateOutputPath)$(TargetFileName)" DestinationFolder="$(_E2EAltDir)stage" />
		<Copy SourceFiles="$(IntermediateOutputPath)$(TargetName).pdb" DestinationFolder="$(_E2EAltDir)stage" Condition="Exists('$(IntermediateOutputPath)$(TargetName).pdb')" />
		<Exec Command="dotnet &quot;$(_E2EAltCoverTool)&quot; -i &quot;$(_E2EAltDir)stage&quot; -o &quot;$(_E2EAltDir)instr&quot; --localSource --visibleBranches -r &quot;$(_E2EAltDir)template.opencover.xml&quot; -a ExcludeFromCodeCoverage -a GeneratedCodeAttribute -a CompilerGeneratedAttribute -a DebuggerNonUserCode -a Obsolete" />
		<Copy SourceFiles="$(_E2EAltDir)instr\$(TargetFileName)" DestinationFiles="$(IntermediateOutputPath)$(TargetFileName)" />
		<Copy SourceFiles="$(_E2EAltDir)instr\$(TargetName).pdb" DestinationFiles="$(IntermediateOutputPath)$(TargetName).pdb" Condition="Exists('$(_E2EAltDir)instr\$(TargetName).pdb')" />
		<Touch Files="$(IntermediateOutputPath)e2e-coverage.stamp" AlwaysCreate="true" />
		<Message Importance="high" Text="E2E coverage: instrumented $(TargetFileName); OpenCover template at $(_E2EAltDir)template.opencover.xml" />
	</Target>

	<!-- Plain builds after an instrumented one restore the untouched assembly
	     so coverage instrumentation never leaks into non-test builds. -->
	<Target Name="_E2ECoverageRestore" AfterTargets="XamlC" Condition="'$(E2ECoverage)' != 'true'">
		<PropertyGroup>
			<_E2EWasInstrumented Condition="Exists('$(IntermediateOutputPath)e2e-coverage.stamp')">true</_E2EWasInstrumented>
		</PropertyGroup>
		<Copy SourceFiles="$(IntermediateOutputPath)$(TargetName).uninstrumented.dll" DestinationFiles="$(IntermediateOutputPath)$(TargetFileName)"
				Condition="'$(_E2EWasInstrumented)' == 'true' AND Exists('$(IntermediateOutputPath)$(TargetName).uninstrumented.dll')" />
		<Copy SourceFiles="$(IntermediateOutputPath)$(TargetName).uninstrumented.pdb" DestinationFiles="$(IntermediateOutputPath)$(TargetName).pdb"
				Condition="'$(_E2EWasInstrumented)' == 'true' AND Exists('$(IntermediateOutputPath)$(TargetName).uninstrumented.pdb')" />
		<Delete Files="$(TargetDir)$(TargetFileName);$(TargetDir)$(TargetName).pdb;$(TargetDir)AltCover.Recorder.g.dll" Condition="'$(_E2EWasInstrumented)' == 'true'" />
		<Delete Files="$(IntermediateOutputPath)e2e-coverage.stamp" Condition="'$(_E2EWasInstrumented)' == 'true'" />
		<Message Importance="high" Text="E2E coverage: restored uninstrumented $(TargetFileName)" Condition="'$(_E2EWasInstrumented)' == 'true'" />
	</Target>

</Project>
