<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the AssetPackDownloader extension so Background Assets can
	     coordinate managed asset-pack downloads between the two processes. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.tanah.daily929.assets</string>
	</array>
	<!-- #1097: APNs push entitlement. Development profiles authorize
	     `development`; Release/distribution builds use Entitlements.Dist.plist
	     (`production`) because the signed value must match the provisioning
	     profile exactly. Requires the App ID's Push Notifications capability
	     enabled in the Apple portal (operator side — see
	     docs/app/push-notifications.md). -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
