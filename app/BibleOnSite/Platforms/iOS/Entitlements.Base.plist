<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the AssetPackDownloader extension so Background Assets can
	     coordinate managed asset-pack downloads between the two processes. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.tanah.daily929.assets</string>
	</array>
	<!-- #1097: no aps-environment — fallback for device builds whose
	     provisioning profile does not authorize `aps-environment` (local
	     development profiles that were not regenerated after the App ID's
	     Push Notifications capability was enabled). Such builds pass
	     -p:IosPushProvisioned=false; the default true selects
	     Entitlements.App.plist (development) / Entitlements.Dist.plist
	     (production) instead. -->
</dict>
</plist>
