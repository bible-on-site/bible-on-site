<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BibleOnSite.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="BibleOnSite.Controls.PerekPickerPopup"
             x:Name="PickerPopup"
             IsVisible="False"
             AutomationId="PerekPickerPopup"
             FlowDirection="RightToLeft">

    <!-- Popup container -->
    <Grid>
        <!-- Semi-transparent background for tap to dismiss -->
        <BoxView BackgroundColor="#80000000"
                 InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackgroundTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Picker container: from below perek header to above satellite buttons -->
        <Border Stroke="{StaticResource Primary}"
                StrokeThickness="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
                Padding="0"
                Margin="16,55,16,130"
                VerticalOptions="Fill"
                HorizontalOptions="Fill"
                InputTransparent="False">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header -->
                <Border Grid.Row="0"
                        BackgroundColor="{StaticResource Primary}"
                        Padding="16,12">
                    <Label Text="בחירת פרק"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"/>
                </Border>

                <!-- Three-column picker -->
                <Grid Grid.Row="1"
                      ColumnDefinitions="*,1.2*,0.7*"
                      Padding="8"
                      ColumnSpacing="6"
                      RowDefinitions="Auto,*"
                      RowSpacing="4">

                    <!-- Column headers -->
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="קטגוריה"
                           FontSize="12"
                           TextColor="{StaticResource Gray500}"
                           HorizontalTextAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="1"
                           Text="ספר"
                           FontSize="12"
                           TextColor="{StaticResource Gray500}"
                           HorizontalTextAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="2"
                           Text="פרק"
                           FontSize="12"
                           TextColor="{StaticResource Gray500}"
                           HorizontalTextAlignment="Center"/>

                    <!-- Column 1: Sefer Groups (Torah, Neviim, Ketuvim) -->
                    <Border Grid.Row="1" Grid.Column="0"
                            BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2E}"
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Label x:Name="SeferGroupUpArrow"
                                   Text="{x:Static fonts:FluentUI.chevron_up_20_regular}"
                                   FontFamily="FluentIcons" FontSize="14"
                                   TextColor="{StaticResource Gray400}"
                                   HeightRequest="22"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   AutomationId="PerekPickerGroupUp"
                                   SemanticProperties.Description="תחילת הרשימה"/>
                            <Grid Grid.Row="1">
                                <!-- invisible probe with the item template's metrics: its
                                     arranged height equals one item's height (items are
                                     uniform via MeasureAllItems) -->
                                <Label x:Name="SeferGroupItemSizer"
                                       Text="א" FontSize="16" Padding="8,12"
                                       Opacity="0"
                                       InputTransparent="True"
                                       VerticalOptions="Start"/>
                                <CollectionView x:Name="SeferGroupList"
                                        SelectionMode="Single"
                                        SelectionChanged="OnSeferGroupSelected"
                                        Scrolled="OnColumnScrolled"
                                        SizeChanged="OnColumnSizeChanged"
                                        AutomationId="PerekPickerGroupList"
                                        ItemSizingStrategy="MeasureAllItems"
                                        InputTransparent="False">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,12" AutomationId="PickerGroupItem">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal"/>
                                                <VisualState Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Label Text="{Binding Name}"
                                               FontSize="16"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                            <Label x:Name="SeferGroupDownArrow" Grid.Row="2"
                                   Text="{x:Static fonts:FluentUI.chevron_down_20_regular}"
                                   FontFamily="FluentIcons" FontSize="14"
                                   TextColor="{StaticResource Gray400}"
                                   HeightRequest="22"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   AutomationId="PerekPickerGroupDown"
                                   SemanticProperties.Description="סוף הרשימה"/>
                        </Grid>
                    </Border>

                    <!-- Column 2: Sefarim within group -->
                    <Border Grid.Row="1" Grid.Column="1"
                            BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2E}"
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Label x:Name="SeferUpArrow"
                                   Text="{x:Static fonts:FluentUI.chevron_up_20_regular}"
                                   FontFamily="FluentIcons" FontSize="14"
                                   TextColor="{StaticResource Gray400}"
                                   HeightRequest="22"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   AutomationId="PerekPickerSeferUp"
                                   SemanticProperties.Description="תחילת הרשימה"/>
                            <Grid Grid.Row="1">
                                <Label x:Name="SeferItemSizer"
                                       Text="א" FontSize="14" Padding="8,12"
                                       Opacity="0"
                                       InputTransparent="True"
                                       VerticalOptions="Start"/>
                                <CollectionView x:Name="SeferList"
                                        SelectionMode="Single"
                                        SelectionChanged="OnSeferSelected"
                                        Scrolled="OnColumnScrolled"
                                        SizeChanged="OnColumnSizeChanged"
                                        AutomationId="PerekPickerSeferList"
                                        ItemSizingStrategy="MeasureAllItems"
                                        InputTransparent="False">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,12" AutomationId="PickerSeferItem">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal"/>
                                                <VisualState Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Label Text="{Binding DisplayName}"
                                               FontSize="14"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                            <Label x:Name="SeferDownArrow" Grid.Row="2"
                                   Text="{x:Static fonts:FluentUI.chevron_down_20_regular}"
                                   FontFamily="FluentIcons" FontSize="14"
                                   TextColor="{StaticResource Gray400}"
                                   HeightRequest="22"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   AutomationId="PerekPickerSeferDown"
                                   SemanticProperties.Description="סוף הרשימה"/>
                        </Grid>
                    </Border>

                    <!-- Column 3: Perakim within sefer -->
                    <Border Grid.Row="1" Grid.Column="2"
                            BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2E}"
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Label x:Name="PerekUpArrow"
                                   Text="{x:Static fonts:FluentUI.chevron_up_20_regular}"
                                   FontFamily="FluentIcons" FontSize="14"
                                   TextColor="{StaticResource Gray400}"
                                   HeightRequest="22"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   AutomationId="PerekPickerPerekUp"
                                   SemanticProperties.Description="תחילת הרשימה"/>
                            <Grid Grid.Row="1">
                                <Label x:Name="PerekItemSizer"
                                       Text="א" FontSize="14" Padding="8,10"
                                       Opacity="0"
                                       InputTransparent="True"
                                       VerticalOptions="Start"/>
                                <CollectionView x:Name="PerekList"
                                        SelectionMode="Single"
                                        SelectionChanged="OnPerekSelected"
                                        Scrolled="OnColumnScrolled"
                                        SizeChanged="OnColumnSizeChanged"
                                        AutomationId="PerekPickerPerekList"
                                        ItemSizingStrategy="MeasureAllItems"
                                        InputTransparent="False">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,10" AutomationId="PickerPerekItem">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal"/>
                                                <VisualState Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Label Text="{Binding DisplayText}"
                                               FontSize="14"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                            <Label x:Name="PerekDownArrow" Grid.Row="2"
                                   Text="{x:Static fonts:FluentUI.chevron_down_20_regular}"
                                   FontFamily="FluentIcons" FontSize="14"
                                   TextColor="{StaticResource Gray400}"
                                   HeightRequest="22"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   AutomationId="PerekPickerPerekDown"
                                   SemanticProperties.Description="סוף הרשימה"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Footer buttons -->
                <Grid Grid.Row="2"
                      ColumnDefinitions="*,*"
                      Padding="12"
                      ColumnSpacing="12">
                    <Button Grid.Column="0"
                            Text="בטל"
                            AutomationId="PerekPickerCancel"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Gray600}"
                            BorderColor="{StaticResource Gray400}"
                            BorderWidth="1"
                            CornerRadius="8"
                            Clicked="OnCancelClicked"/>
                    <Button Grid.Column="1"
                            x:Name="ConfirmButton"
                            Text="בחר"
                            AutomationId="PerekPickerConfirm"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="8"
                            IsEnabled="False"
                            Clicked="OnConfirmClicked"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentView>
