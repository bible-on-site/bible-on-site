<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BibleOnSite.Controls"
             xmlns:viewmodels="clr-namespace:BibleOnSite.ViewModels"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="BibleOnSite.Controls.ExtensionPacksView"
             x:DataType="viewmodels:ExtensionPacksViewModel">
    <ScrollView Padding="16,12">
        <VerticalStackLayout Spacing="24">

            <!-- ═══ פירושים ═══ -->
            <VerticalStackLayout Spacing="8">
                <Label Text="פירושים"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"
                       Padding="4,0,0,0"/>

                <Border Padding="16"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="חבילת הפירושים (רש&quot;י, תרגום ועוד)"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                               LineBreakMode="WordWrap"/>
                        <Label Text="{Binding PerushimNotesStatusText}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               LineBreakMode="WordWrap"/>

                        <!-- One action area per lifecycle state: הורדה → מוריד…+ביטול → הסרה -->
                        <Button Style="{x:Static controls:AppButtonStyles.Primary}" Text="הורדת חבילת הפירושים"
                                Command="{Binding DownloadPerushimCommand}"
                                AutomationId="DownloadPerushimButton"
                                IsVisible="{Binding ShowPerushimDownloadButton}">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FluentIcons"
                                                 Glyph="{x:Static fonts:FluentUI.arrow_download_24_regular}"
                                                 Color="White"
                                                 Size="18"/>
                            </Button.ImageSource>
                        </Button>

                        <VerticalStackLayout Spacing="6" IsVisible="{Binding IsPerushimDownloading}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding PerushimDownloadStatusText}"
                                       FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                                       VerticalOptions="Center"/>
                                <ActivityIndicator Grid.Column="1"
                                                   IsRunning="{Binding IsPerushimDownloading}"
                                                   VerticalOptions="Center"
                                                   WidthRequest="18"
                                                   HeightRequest="18"/>
                            </Grid>
                            <ProgressBar Progress="{Binding PerushimDownloadProgress}"/>
                            <Button Style="{x:Static controls:AppButtonStyles.Secondary}" Text="ביטול ההורדה"
                                    Command="{Binding CancelPerushimDownloadCommand}"
                                    AutomationId="CancelPerushimDownloadButton"/>
                        </VerticalStackLayout>

                        <Button Style="{x:Static controls:AppButtonStyles.Destructive}" Text="הסרת חבילת הפירושים"
                                Command="{Binding RemovePerushimCommand}"
                                AutomationId="RemovePerushimButton"
                                IsVisible="{Binding ShowPerushimRemove}">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FluentIcons"
                                                 Glyph="{x:Static fonts:FluentUI.delete_24_regular}"
                                                 Color="{AppThemeBinding Light={x:Static controls:AppButtonStyles.DestructiveInkLight}, Dark={x:Static controls:AppButtonStyles.DestructiveInkDark}}"
                                                 Size="16"/>
                            </Button.ImageSource>
                        </Button>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ═══ קריינות ═══ -->
            <VerticalStackLayout Spacing="8">
                <Label Text="קריינות"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"
                       Padding="4,0,0,0"/>

                <Border Padding="16"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding Packs.SummaryText}"
                               AutomationId="RecitationSummaryState"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                        <Label Text="הורידו הקלטות לספרים שתבחרו או לכל תנ&quot;ך לשימוש ללא אינטרנט. חבילות ההקראה מתעדכנות יחד עם האפליקציה."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               LineBreakMode="WordWrap"/>
                        <Label Text="{Binding Packs.Status}"
                               AutomationId="RecitationPackageStatus"
                               FontSize="13"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>

                        <!-- Per-book lifecycle rows. The stack stays enabled during a
                             download (#3705): rows remain readable/scrollable and each
                             row guards its own actions instead of the list dimming. -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Packs.Books}"
                                             Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:RecitationBookChoice">
                                    <!-- Stacked, not side-by-side: wide actions (e.g. השלמת הורדה at
                                         increased text size) must never collide with the status text. -->
                                    <VerticalStackLayout Padding="0,4" Spacing="6">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Name}"
                                                   FontSize="15"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                                            <Label Text="{Binding Status}"
                                                   FontSize="12"
                                                   LineBreakMode="WordWrap"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                                        </VerticalStackLayout>
                                        <!-- On-row progress (#3705): the bar appears once the platform
                                             reports a fraction; before that the spinner below signals
                                             the download is running. -->
                                        <Grid ColumnDefinitions="*,Auto"
                                              IsVisible="{Binding ShowProgressBar}">
                                            <ProgressBar Progress="{Binding DownloadProgress}"
                                                         VerticalOptions="Center"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding ProgressText}"
                                                   FontSize="12"
                                                   Margin="8,0,0,0"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                        <!-- Shared action slot: every lifecycle action of a ספר keeps the
                                             same end-side margin so הסרה lands exactly where הורדה sat -
                                             the per-book action must not travel when the state flips (#3264). -->
                                        <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="End" HorizontalOptions="End">
                                            <ActivityIndicator IsVisible="{Binding ShowProgress}"
                                                               IsRunning="{Binding ShowProgress}"
                                                               AutomationId="BookDownloadSpinner"
                                                               WidthRequest="18"
                                                               HeightRequest="18"
                                                               VerticalOptions="Center"
                                                               Margin="8,0"
                                                               SemanticProperties.Description="מוריד את הקלטות הספר"/>
                                            <Button Style="{x:Static controls:AppButtonStyles.Secondary}" Text="ביטול"
                                                    Clicked="OnCancelBookDownloadClicked"
                                                    CommandParameter="{Binding}"
                                                    AutomationId="CancelBookDownloadButton"
                                                    IsVisible="{Binding ShowCancel}"
                                                    Margin="8,4"
                                                    SemanticProperties.Description="{Binding Name, StringFormat='ביטול הורדת הקלטות {0}'}"/>
                                            <Button Style="{x:Static controls:AppButtonStyles.Primary}" Text="{Binding DownloadLabel}"
                                                    Clicked="OnDownloadBookClicked"
                                                    CommandParameter="{Binding}"
                                                    AutomationId="DownloadBookButton"
                                                    SemanticProperties.Description="{Binding Name, StringFormat='הורדת הקלטות {0}'}"
                                                    IsVisible="{Binding ShowDownload}"
                                                    IsEnabled="{Binding ActionsEnabled}"
                                                    Margin="8,4"/>
                                            <Button Style="{x:Static controls:AppButtonStyles.Destructive}" Text="הסרה"
                                                    Clicked="OnRemoveBookClicked"
                                                    CommandParameter="{Binding}"
                                                    AutomationId="RemoveBookButton"
                                                    IsVisible="{Binding ShowRemove}"
                                                    IsEnabled="{Binding ActionsEnabled}"
                                                    Margin="8,4"
                                                    SemanticProperties.Description="{Binding Name, StringFormat='הסרת הקלטות {0}'}"/>
                                        </FlexLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Whole-pack actions: one-step download-all and remove-all -->
                        <Button Style="{x:Static controls:AppButtonStyles.Primary}" Text="הורדת כל תנ&quot;ך (כ-935 MB)"
                                Command="{Binding Packs.DownloadAllCommand}"
                                IsEnabled="{Binding Packs.IsIdle}"
                                AutomationId="RecitationDownloadAllButton">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FluentIcons"
                                                 Glyph="{x:Static fonts:FluentUI.arrow_download_24_regular}"
                                                 Color="White"
                                                 Size="18"/>
                            </Button.ImageSource>
                        </Button>
                        <!-- Aggregate progress block: only a multi-sefer scope
                             reports here — a single sefer's progress and cancel
                             live on its own row (#3705). -->
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding Packs.ShowAggregateProgress}">
                            <ProgressBar Progress="{Binding Packs.Progress}"/>
                            <Button Style="{x:Static controls:AppButtonStyles.Secondary}" Text="ביטול ההורדה"
                                    Command="{Binding Packs.CancelDownloadCommand}"
                                    AutomationId="RecitationCancelDownloadButton"/>
                        </VerticalStackLayout>
                        <Button Style="{x:Static controls:AppButtonStyles.Destructive}" Text="הסרת כל ההקלטות"
                                Command="{Binding Packs.RemoveAllCommand}"
                                AutomationId="RemoveAllRecitationButton"
                                IsEnabled="{Binding Packs.CanRemove}">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FluentIcons"
                                                 Glyph="{x:Static fonts:FluentUI.delete_24_regular}"
                                                 Color="{AppThemeBinding Light={x:Static controls:AppButtonStyles.DestructiveInkLight}, Dark={x:Static controls:AppButtonStyles.DestructiveInkDark}}"
                                                 Size="16"/>
                            </Button.ImageSource>
                        </Button>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
