<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BibleOnSite.ViewModels"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="BibleOnSite.Controls.ExtensionPacksView"
             x:DataType="viewmodels:ExtensionPacksViewModel">
    <ScrollView Padding="16,12">
        <VerticalStackLayout Spacing="24">

            <!-- ═══ פירושים ═══ -->
            <VerticalStackLayout Spacing="8">
                <Label Text="פירושים"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       Padding="4,0,0,0"/>

                <Border Padding="16"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="חבילת הפירושים (רש&quot;י, תרגום ועוד)"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                               LineBreakMode="WordWrap"/>
                        <Label Text="{Binding PerushimNotesStatusText}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               LineBreakMode="WordWrap"/>

                        <!-- One action area per lifecycle state: הורדה → מוריד…+ביטול → הסרה -->
                        <Button Text="הורדת חבילת הפירושים"
                                Command="{Binding DownloadPerushimCommand}"
                                AutomationId="DownloadPerushimButton"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="8"
                                IsVisible="{Binding ShowPerushimDownloadButton}">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FluentIcons"
                                                 Glyph="{x:Static fonts:FluentUI.arrow_download_24_regular}"
                                                 Color="White"
                                                 Size="18"/>
                            </Button.ImageSource>
                        </Button>

                        <VerticalStackLayout Spacing="6" IsVisible="{Binding IsPerushimDownloading}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding PerushimDownloadStatusText}"
                                       FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                                       VerticalOptions="Center"/>
                                <ActivityIndicator Grid.Column="1"
                                                   IsRunning="{Binding IsPerushimDownloading}"
                                                   Color="{StaticResource Primary}"
                                                   VerticalOptions="Center"
                                                   WidthRequest="18"
                                                   HeightRequest="18"/>
                            </Grid>
                            <ProgressBar Progress="{Binding PerushimDownloadProgress}"
                                         ProgressColor="{StaticResource Primary}"/>
                            <Button Text="ביטול ההורדה"
                                    Command="{Binding CancelPerushimDownloadCommand}"
                                    AutomationId="CancelPerushimDownloadButton"
                                    BackgroundColor="Transparent"
                                    BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                    BorderWidth="1"
                                    CornerRadius="8"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                    FontSize="13"/>
                        </VerticalStackLayout>

                        <Button Text="הסרת חבילת הפירושים"
                                Command="{Binding RemovePerushimCommand}"
                                AutomationId="RemovePerushimButton"
                                BackgroundColor="Transparent"
                                BorderColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                BorderWidth="1"
                                CornerRadius="8"
                                TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                FontSize="13"
                                IsVisible="{Binding ShowPerushimRemove}">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FluentIcons"
                                                 Glyph="{x:Static fonts:FluentUI.delete_24_regular}"
                                                 Color="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                 Size="16"/>
                            </Button.ImageSource>
                        </Button>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ═══ קריינות ═══ -->
            <VerticalStackLayout Spacing="8">
                <Label Text="קריינות"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       Padding="4,0,0,0"/>

                <Border Padding="16"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding Packs.SummaryText}"
                               AutomationId="RecitationSummaryState"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                        <Label Text="הורידו הקלטות לספרים שתבחרו או לכל תנ&quot;ך לשימוש ללא אינטרנט. חבילות ההקראה מתעדכנות יחד עם האפליקציה."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               LineBreakMode="WordWrap"/>
                        <Label Text="{Binding Packs.Status}"
                               AutomationId="RecitationPackageStatus"
                               FontSize="13"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>

                        <!-- Per-book lifecycle rows -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Packs.Books}"
                                             IsEnabled="{Binding Packs.IsIdle}"
                                             Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:RecitationBookChoice">
                                    <!-- Stacked, not side-by-side: wide actions (e.g. השלמת הורדה at
                                         increased text size) must never collide with the status text. -->
                                    <VerticalStackLayout Padding="0,4" Spacing="6">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Name}"
                                                   FontSize="15"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                                            <Label Text="{Binding Status}"
                                                   FontSize="12"
                                                   LineBreakMode="WordWrap"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                                        </VerticalStackLayout>
                                        <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="End" HorizontalOptions="End">
                                            <Label Text="מוריד…"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}"
                                                   VerticalOptions="Center"
                                                   Margin="8,0"
                                                   IsVisible="{Binding ShowProgress}"/>
                                            <Button Text="{Binding DownloadLabel}"
                                                    Clicked="OnDownloadBookClicked"
                                                    CommandParameter="{Binding}"
                                                    AutomationId="DownloadBookButton"
                                                    SemanticProperties.Description="{Binding Name, StringFormat='הורדת הקלטות {0}'}"
                                                    IsVisible="{Binding ShowDownload}"
                                                    BackgroundColor="{StaticResource Primary}"
                                                    TextColor="White"
                                                    CornerRadius="8"
                                                    FontSize="12"
                                                    Padding="12,4"
                                                    Margin="8,4"/>
                                            <Button Text="הסרה"
                                                    Clicked="OnRemoveBookClicked"
                                                    CommandParameter="{Binding}"
                                                    AutomationId="RemoveBookButton"
                                                    IsVisible="{Binding ShowRemove}"
                                                    BackgroundColor="Transparent"
                                                    BorderColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                    BorderWidth="1"
                                                    CornerRadius="8"
                                                    FontSize="12"
                                                    Padding="12,4"
                                                    Margin="0,4"
                                                    TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                    SemanticProperties.Description="{Binding Name, StringFormat='הסרת הקלטות {0}'}"/>
                                        </FlexLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Whole-pack actions: one-step download-all and remove-all -->
                        <Button Text="הורדת כל תנ&quot;ך (כ-935 MB)"
                                Command="{Binding Packs.DownloadAllCommand}"
                                IsEnabled="{Binding Packs.IsIdle}"
                                AutomationId="RecitationDownloadAllButton"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="8">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FluentIcons"
                                                 Glyph="{x:Static fonts:FluentUI.arrow_download_24_regular}"
                                                 Color="White"
                                                 Size="18"/>
                            </Button.ImageSource>
                        </Button>
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding Packs.IsDownloading}">
                            <ProgressBar Progress="{Binding Packs.Progress}"
                                         ProgressColor="{StaticResource Primary}"/>
                            <Button Text="ביטול ההורדה"
                                    Command="{Binding Packs.CancelDownloadCommand}"
                                    AutomationId="RecitationCancelDownloadButton"
                                    BackgroundColor="Transparent"
                                    BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                    BorderWidth="1"
                                    CornerRadius="8"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                    FontSize="13"/>
                        </VerticalStackLayout>
                        <Button Text="הסרת כל ההקלטות"
                                Command="{Binding Packs.RemoveAllCommand}"
                                AutomationId="RemoveAllRecitationButton"
                                IsEnabled="{Binding Packs.CanRemove}"
                                BackgroundColor="Transparent"
                                BorderColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                BorderWidth="1"
                                CornerRadius="8"
                                TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FluentIcons"
                                                 Glyph="{x:Static fonts:FluentUI.delete_24_regular}"
                                                 Color="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                 Size="16"/>
                            </Button.ImageSource>
                        </Button>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
