<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BibleOnSite.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="BibleOnSite.Controls.ArticleCard"
             x:Name="ThisCard"
             x:DataType="controls:ArticleCard">

    <Border Padding="0"
            StrokeShape="RoundRectangle 12"
            Stroke="Transparent"
            FlowDirection="RightToLeft"
            BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.15"/>
        </Border.Shadow>
        <!-- Rows: title (top) → reading-time badge → optional perek source → author (flexible,
             bottom-aligned so it sits directly above the footer) → footer. The * row absorbs
             title height differences so the author/footer block is anchored identically on
             every card in a grid row. -->
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
              Padding="12">
            <!-- Short Abstract (RTL: right-aligned) -->
            <Label Grid.Row="0"
                   Text="{Binding Article.ShortAbstract, Source={x:Reference ThisCard}}"
                   FontSize="12"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Start"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                   LineBreakMode="TailTruncation"
                   MaxLines="3"
                   Margin="0,0,0,4"/>

            <!-- Reading-time badge over the full article body (issue #2607);
                 hidden when the metric is unknown or verified-empty. -->
            <Label Grid.Row="1"
                   Text="{Binding Article.ReadingTimeBadge, Source={x:Reference ThisCard}}"
                   IsVisible="{Binding Article.ReadingTimeBadge, Source={x:Reference ThisCard}, Converter={StaticResource StringNotEmptyConverter}}"
                   FontSize="10"
                   AutomationId="ArticleReadingTimeBadge"
                   TextColor="{AppThemeBinding Light=#52647C, Dark=#B2C2D8}"
                   Margin="0,0,0,4"/>

            <!-- Perek Source (only shown when ShowPerekSource is true, e.g., rabbi articles) -->
            <Label Grid.Row="2"
                   Text="{Binding Article.PerekDisplayName, Source={x:Reference ThisCard}}"
                   FontSize="11"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                   IsVisible="{Binding ShowPerekSource, Source={x:Reference ThisCard}}"
                   Margin="0,0,0,4"/>

            <!-- Author Info (RTL: rabbi name on a full-width row, avatar centered on its own
                 row below so short names never sit next to a truncated "..."). -->
            <VerticalStackLayout Grid.Row="3"
                                 VerticalOptions="End"
                                 Spacing="4">
                <Label Text="{Binding Article.Author.Name, Source={x:Reference ThisCard}}"
                       FontSize="11"
                       LineBreakMode="TailTruncation"
                       MaxLines="2"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"/>
                <Border WidthRequest="26"
                        HeightRequest="26"
                        StrokeShape="RoundRectangle 13"
                        Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"
                        StrokeThickness="1"
                        HorizontalOptions="Center"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                    <Grid>
                        <!-- Placeholder glyph shown when the portrait fails to load -->
                        <Label Text="{x:Static fonts:FluentUI.person_16_regular}"
                               FontFamily="FluentIcons"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <Image Source="{Binding Article.Author.ImageUrl, Source={x:Reference ThisCard}}"
                               Aspect="AspectFill"
                               WidthRequest="24"
                               HeightRequest="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Read indicator pinned to the card bottom (RTL: left side) -->
            <HorizontalStackLayout Grid.Row="4"
                                   FlowDirection="RightToLeft"
                                   HorizontalOptions="End"
                                   Spacing="4"
                                   Margin="0,4,0,0">
                <Label Text="קרא עוד"
                       FontSize="11"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"
                       VerticalOptions="Center"/>
                <Label Text="{x:Static fonts:FluentUI.chevron_circle_left_12_regular}"
                       FontFamily="FluentIcons"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>
    </Border>

</ContentView>
