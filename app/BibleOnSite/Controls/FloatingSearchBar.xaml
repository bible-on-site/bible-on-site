<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BibleOnSite.ViewModels"
             xmlns:models="clr-namespace:BibleOnSite.Models"
             xmlns:controls="clr-namespace:BibleOnSite.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="BibleOnSite.Controls.FloatingSearchBar"
             x:DataType="viewmodels:SearchViewModel"
             FlowDirection="RightToLeft">
    <ContentView.Resources>
        <Style x:Key="SearchIconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="FluentIcons"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="WidthRequest" Value="44"/>
            <Setter Property="HeightRequest" Value="44"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="BorderWidth" Value="0"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark=#AACBFF}"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>
    </ContentView.Resources>
    <VerticalStackLayout x:Name="SearchLayout" BackgroundColor="Transparent">
        <Border x:Name="SearchHeader" StrokeShape="RoundRectangle 28" Padding="6,0" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark=#263244}">
            <Border.HeightRequest>
                <OnPlatform x:TypeArguments="x:Double" Default="48">
                    <On Platform="Android,iOS" Value="56"/>
                </OnPlatform>
            </Border.HeightRequest>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" FlowDirection="RightToLeft">
                <Button x:Name="NavigationButton" Style="{StaticResource SearchIconButton}"
                        Text="{x:Static fonts:FluentUI.search_24_regular}" AutomationId="SearchNavigationButton"
                        SemanticProperties.Description="חיפוש" Clicked="OnNavigationClicked"/>
                <controls:SearchEntry Grid.Column="1" x:Name="SearchInput" AutomationId="PerekSearchInput"
                                     Text="{Binding SearchPhrase, Mode=TwoWay}" Placeholder="חיפוש"
                                     FontSize="17" VerticalOptions="Center" HeightRequest="48"
                                     TextColor="{AppThemeBinding Light=#26384E, Dark=#E7EEF8}"
                                     PlaceholderColor="{AppThemeBinding Light=#52647C, Dark=#B2C2D8}"
                                     TextChanged="OnSearchTextChanged" Focused="OnSearchFocused" Completed="OnSearchSubmitted"/>
                <Button Grid.Column="2" x:Name="ClearButton" Style="{StaticResource SearchIconButton}" IsVisible="False"
                        Text="{x:Static fonts:FluentUI.dismiss_24_regular}" AutomationId="ClearSearchButton"
                        SemanticProperties.Description="ניקוי החיפוש" Clicked="OnClearClicked"/>
                <Button Grid.Column="3" x:Name="FiltersButton" Style="{StaticResource SearchIconButton}"
                        Text="{x:Static fonts:FluentUI.settings_24_regular}" AutomationId="SearchFiltersButton"
                        SemanticProperties.Description="הגדרות חיפוש" Clicked="OnFiltersClicked"/>
            </Grid>
        </Border>
        <Border x:Name="SearchPanel" AutomationId="SearchPanel" IsVisible="False"
                StrokeShape="RoundRectangle 20" Padding="12"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                Stroke="{AppThemeBinding Light=#D8E4F4, Dark=#46566D}">
            <VerticalStackLayout Spacing="6">
                <VerticalStackLayout x:Name="FiltersPanel" IsVisible="False" Spacing="4">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                        <Button Text="מה לחפש" AutomationId="SearchKindsTab" Clicked="OnKindsTabClicked" FontSize="13" Padding="2"/>
                        <Button Grid.Column="1" Text="היכן לחפש" AutomationId="SearchBooksTab" Clicked="OnBooksTabClicked" FontSize="13" Padding="2"/>
                        <Button Grid.Column="2" Text="הגדרות נוספות" AutomationId="SearchOptionsTab" Clicked="OnOptionsTabClicked" FontSize="13" Padding="2"/>
                    </Grid>
                    <ScrollView HeightRequest="220">
                        <VerticalStackLayout>
                            <VerticalStackLayout x:Name="KindsFilters"/>
                            <Grid x:Name="BookFilters" IsVisible="False" ColumnDefinitions="*,*,*" ColumnSpacing="6"/>
                            <VerticalStackLayout x:Name="MoreFilters" IsVisible="False" Padding="8" Spacing="8">
                                <Label Text="מספר תוצאות מרבי"/>
                                <Picker x:Name="LimitPicker" AutomationId="SearchLimitPicker"
                                        Title="מספר תוצאות" SelectedIndexChanged="OnLimitChanged"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
                <Grid ColumnDefinitions="Auto,*">
                    <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                       WidthRequest="24" HeightRequest="24"/>
                    <Label Grid.Column="1" x:Name="SearchStatus" AutomationId="SearchStatus" FontSize="13"
                           TextColor="{AppThemeBinding Light=#52647C, Dark=#B2C2D8}"
                           VerticalOptions="Center" Text="הקלידו פרק, פסוק, פירוש או שם רב"/>
                </Grid>
                <Label x:Name="ErrorText" IsVisible="False" Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light=#B02020, Dark=#FF9090}" FontSize="13"/>
                <Label x:Name="AvailabilityText" IsVisible="False" Text="{Binding AvailabilityMessage}" FontSize="13"/>
                <CollectionView x:Name="ResultsList" AutomationId="SearchResults"
                                ItemsSource="{Binding SearchResults}" HeightRequest="280"
                                SelectionMode="Single" SelectionChanged="OnResultSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SearchResult">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="4,10">
                                <Image Source="{Binding ThumbnailUrl}" IsVisible="{Binding HasThumbnail}"
                                       WidthRequest="36" HeightRequest="36" VerticalOptions="Start"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding Category}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#AACBFF}"/>
                                    <Label Text="{Binding Title}" AutomationId="SearchResultTitle" FontSize="16" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#26384E, Dark=#E7EEF8}"/>
                                    <Label Text="{Binding SubtitleHtml}" TextType="Html" FontSize="14" MaxLines="3"
                                           TextColor="{AppThemeBinding Light=#52647C, Dark=#B2C2D8}"/>
                                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E8F0FA, Dark=#46566D}"
                                             BackgroundColor="Transparent"/>
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
