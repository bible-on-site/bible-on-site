<?xml version="1.0" encoding="utf-8" ?>
<Grid xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
      xmlns:fonts="clr-namespace:Fonts"
      x:Class="BibleOnSite.Controls.ReaderSelectionBar"
      AutomationId="SelectionBar"
      IsVisible="False"
      BackgroundColor="{StaticResource Primary}"
      Padding="4,5"
      ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
    <Grid.HeightRequest>
        <OnPlatform x:TypeArguments="x:Double" Default="48">
            <On Platform="Android,iOS" Value="56"/>
        </OnPlatform>
    </Grid.HeightRequest>
    <!-- Back button -->
    <Button Grid.Column="0"
            x:Name="BackButton"
            AutomationId="SelectionBackButton"
            SemanticProperties.Description="ביטול הבחירה"
            ToolTipProperties.Text="ביטול הבחירה"
            Text="{x:Static fonts:FluentUI.arrow_right_24_regular}"
            FontFamily="FluentIcons"
            FontSize="20"
            WidthRequest="36"
            HeightRequest="36"
            Padding="0"
            BackgroundColor="Transparent"
            TextColor="White"
            Clicked="OnBackClicked"/>
    <!-- Badge with count -->
    <Border Grid.Column="1"
            x:Name="CountBadge"
            BackgroundColor="White"
            StrokeShape="RoundRectangle 12"
            Stroke="Transparent"
            Padding="8,2"
            MinimumWidthRequest="24"
            HeightRequest="24"
            VerticalOptions="Center"
            Margin="4,0">
        <Label x:Name="CountLabel"
               AutomationId="SelectionCountLabel"
               Text="0"
               FontSize="12"
               FontAttributes="Bold"
               TextColor="{StaticResource Primary}"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"/>
    </Border>
    <!-- Spacer (transparent) -->
    <ContentView Grid.Column="2"/>
    <!-- Recitation button -->
    <Button Grid.Column="3"
            x:Name="RecitationButton"
            AutomationId="SelectionRecitationButton"
            SemanticProperties.Description="השמעת הבחירה"
            ToolTipProperties.Text="השמעת הבחירה"
            Text="{x:Static fonts:FluentUI.headphones_24_regular}"
            FontFamily="FluentIcons" FontSize="20"
            WidthRequest="40" HeightRequest="36" Padding="0"
            BackgroundColor="Transparent" TextColor="White"
            IsVisible="False" Clicked="OnRecitationClicked"/>
    <!-- Share button -->
    <Button Grid.Column="4"
            x:Name="ShareButton"
            AutomationId="SelectionShareButton"
            SemanticProperties.Description="שיתוף הבחירה"
            ToolTipProperties.Text="שיתוף הבחירה"
            Text="{x:Static fonts:FluentUI.share_24_regular}"
            FontFamily="FluentIcons"
            FontSize="20"
            WidthRequest="36"
            HeightRequest="36"
            Padding="0"
            BackgroundColor="Transparent"
            TextColor="White"
            Clicked="OnShareClicked"/>
    <!-- Copy button -->
    <Button Grid.Column="5"
            x:Name="CopyButton"
            AutomationId="SelectionCopyButton"
            SemanticProperties.Description="העתקת הבחירה"
            ToolTipProperties.Text="העתקת הבחירה"
            Text="{x:Static fonts:FluentUI.copy_20_regular}"
            FontFamily="FluentIcons"
            FontSize="20"
            WidthRequest="36"
            HeightRequest="36"
            Padding="0"
            BackgroundColor="Transparent"
            TextColor="White"
            Clicked="OnCopyClicked"/>
</Grid>
