<?xml version="1.0" encoding="UTF-8" ?>
<!-- FlyoutBackdrop needed for iOS to show overlay when flyout is open.
     On iOS, the default is transparent unlike Android.
     See: https://github.com/xamarin/Xamarin.Forms/issues/15156 -->
<Shell
    x:Class="BibleOnSite.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BibleOnSite"
    xmlns:controls="clr-namespace:BibleOnSite.Controls"
    xmlns:pages="clr-namespace:BibleOnSite.Pages"
    xmlns:viewmodels="clr-namespace:BibleOnSite.ViewModels"
    xmlns:fonts="clr-namespace:Fonts"
    Shell.FlyoutBehavior="Flyout"
    FlyoutWidth="300"
    FlyoutBackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}"
    FlowDirection="RightToLeft"
    FlyoutBackdrop="#80000000">

    <Shell.Resources>
        <Style x:Key="FlyoutGroupHeading" TargetType="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="SemanticProperties.HeadingLevel" Value="Level2"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
            <Setter Property="Margin" Value="16,8,16,0"/>
        </Style>
        <Style x:Key="FlyoutGroupDivider" TargetType="BoxView">
            <Setter Property="HeightRequest" Value="1"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"/>
        </Style>
    </Shell.Resources>

    <!-- Flyout Header with Logo -->
    <Shell.FlyoutHeader>
        <Grid HeightRequest="180"
              BackgroundColor="White"
              Padding="0">
            <Image Source="logo_header.jpg"
                   Aspect="AspectFit"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   Margin="20"/>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Custom Flyout Content with Icons and Subtitles -->
    <Shell.FlyoutContentTemplate>
        <DataTemplate>
            <ScrollView AutomationId="FlyoutScrollView">
                <VerticalStackLayout Spacing="0" BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}">
                    <!-- iOS/MacCatalyst lay the flyout content under FlyoutHeader (the
                         header height is applied as a scroll inset that races header
                         measurement and can leave the first rows permanently hidden
                         under the opaque header) — the logo is rendered in-content
                         there instead; see AppShell.xaml.cs. -->
                    <Grid HeightRequest="100"
                          BackgroundColor="White"
                          Padding="0">
                        <Grid.IsVisible>
                            <OnPlatform x:TypeArguments="x:Boolean" Default="False">
                                <On Platform="iOS,MacCatalyst" Value="true"/>
                            </OnPlatform>
                        </Grid.IsVisible>
                        <Image Source="logo_header.jpg"
                               Aspect="AspectFit"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               Margin="12"/>
                    </Grid>

                    <!-- Destination rows share FlyoutMenuRow (#2766): on Windows
                         its handler wraps the row in a native Button so the menu is
                         reachable and activatable with keyboard/screen reader, with
                         hover/pressed/focus visuals; touch platforms keep the
                         identical tap layout. The order mirrors the website
                         drawer (#3731), with Preferences as a native destination. -->
                    <Label Style="{StaticResource FlyoutGroupHeading}" Text="לימוד על הפרק" Margin="16,12,16,0"/>

                    <!-- על הפרק -->
                    <controls:FlyoutMenuRow Icon="{x:Static fonts:FluentUI.calendar_today_24_regular}"
                                            Title="על הפרק"
                                            Subtitle="הלימוד בחלוקה המוכרת"
                                            AutomationId="FlyoutAlHaperek"
                                            IsSelected="{Binding Source={x:Static viewmodels:FlyoutMenuState.Instance}, Path=IsAlHaperekCurrent}"
                                            Activated="OnAlHaperekTapped"/>

                    <BoxView Style="{StaticResource FlyoutGroupDivider}"/>
                    <Label Style="{StaticResource FlyoutGroupHeading}" Text="חלוקות נוספות"/>

                    <!-- מסורה על הפרק — opt-in entry gated by the מסורה preference (#2181) -->
                    <controls:FlyoutMenuRow Icon="{x:Static fonts:FluentUI.split_horizontal_24_regular}"
                                            Title="מסורה על הפרק"
                                            Subtitle="חלוקת המסורה היהודית הקדומה"
                                            AutomationId="FlyoutMasora"
                                            IsSelected="{Binding Source={x:Static viewmodels:FlyoutMenuState.Instance}, Path=IsMasoraCurrent}"
                                            IsVisible="{Binding Source={x:Static viewmodels:FlyoutMenuState.Instance}, Path=ShowMasoraEntry}"
                                            Activated="OnMasoraTapped"/>

                    <!-- פרשה על הפרק -->
                    <controls:FlyoutMenuRow Icon="{x:Static fonts:FluentUI.book_open_24_regular}"
                                            Title="פרשה על הפרק"
                                            Subtitle="לימוד לפי סדר הפרשות"
                                            AutomationId="FlyoutParasha"
                                            IsSelected="{Binding Source={x:Static viewmodels:FlyoutMenuState.Instance}, Path=IsParashaCurrent}"
                                            Activated="OnParashaTapped"/>

                    <!-- מועדים על הפרק -->
                    <controls:FlyoutMenuRow Icon="{x:Static fonts:FluentUI.calendar_star_24_regular}"
                                            Title="מועדים על הפרק"
                                            Subtitle="לימוד במעגל השנה"
                                            AutomationId="FlyoutMoadim"
                                            IsSelected="{Binding Source={x:Static viewmodels:FlyoutMenuState.Instance}, Path=IsMoadimCurrent}"
                                            Activated="OnMoadimTapped"/>

                    <!-- הרבנים -->
                    <controls:FlyoutMenuRow Icon="{x:Static fonts:FluentUI.edit_person_24_regular}"
                                            Title="הרבנים"
                                            Subtitle="איתור מאמרים לפי המחברים"
                                            AutomationId="FlyoutAuthors"
                                            IsSelected="{Binding Source={x:Static viewmodels:FlyoutMenuState.Instance}, Path=IsAuthorsCurrent}"
                                            Activated="OnAuthorsTapped"/>

                    <BoxView Style="{StaticResource FlyoutGroupDivider}"/>
                    <Label Style="{StaticResource FlyoutGroupHeading}" Text="אפשרויות לימוד נוספות"/>

                    <!-- עלון יומי — join cards (#2806) -->
                    <controls:FlyoutMenuRow Icon="{x:Static fonts:FluentUI.news_24_regular}"
                                            Title="עלון יומי"
                                            Subtitle="הפרק היומי והמאמרים ישירות אליכם"
                                            AutomationId="FlyoutDailyBulletin"
                                            IsSelected="{Binding Source={x:Static viewmodels:FlyoutMenuState.Instance}, Path=IsDailyBulletinCurrent}"
                                            Activated="OnDailyBulletinTapped"/>

                    <BoxView Style="{StaticResource FlyoutGroupDivider}"/>
                    <Label Style="{StaticResource FlyoutGroupHeading}" Text="כלי לימוד"/>

                    <!-- תנכפדיה -->
                    <controls:FlyoutMenuRow Icon="{x:Static fonts:FluentUI.library_24_regular}"
                                            Title="תנכפדיה"
                                            Subtitle="אנציקלופדיה תנ&quot;כית"
                                            AutomationId="FlyoutTanahpedia"
                                            IsSelected="{Binding Source={x:Static viewmodels:FlyoutMenuState.Instance}, Path=IsTanahpediaCurrent}"
                                            Activated="OnTanahpediaTapped"/>

                    <!-- לוח לימוד יומי -->
                    <controls:FlyoutMenuRow Icon="{x:Static fonts:FluentUI.calendar_month_24_regular}"
                                            Title="לוח לימוד יומי"
                                            Subtitle="לוח עזר פרקים לפי תאריך"
                                            AutomationId="FlyoutLearningCalendar"
                                            IsSelected="{Binding Source={x:Static viewmodels:FlyoutMenuState.Instance}, Path=IsLearningCalendarCurrent}"
                                            Activated="OnLearningCalendarTapped"/>

                    <BoxView Style="{StaticResource FlyoutGroupDivider}"/>
                    <Label Style="{StaticResource FlyoutGroupHeading}" Text="שונות"/>

                    <!-- תנאי שימוש -->
                    <controls:FlyoutMenuRow Icon="{x:Static fonts:FluentUI.shield_question_24_regular}"
                                            Title="תנאי שימוש"
                                            Subtitle="והצהרות פרטיות ונגישות"
                                            AutomationId="FlyoutTerms"
                                            IsSelected="{Binding Source={x:Static viewmodels:FlyoutMenuState.Instance}, Path=IsTermsCurrent}"
                                            Activated="OnTermsTapped"/>

                    <!-- תרומות -->
                    <controls:FlyoutMenuRow Icon="{x:Static fonts:FluentUI.money_hand_24_regular}"
                                            Title="תרומות"
                                            AutomationId="FlyoutDonations"
                                            IsSelected="{Binding Source={x:Static viewmodels:FlyoutMenuState.Instance}, Path=IsDonationsCurrent}"
                                            Activated="OnDonationsTapped"/>

                    <!-- צור קשר -->
                    <controls:FlyoutMenuRow Icon="{x:Static fonts:FluentUI.contact_card_24_regular}"
                                            Title="צור קשר"
                                            AutomationId="FlyoutContact"
                                            IsSelected="{Binding Source={x:Static viewmodels:FlyoutMenuState.Instance}, Path=IsContactCurrent}"
                                            Activated="OnContactTapped"/>

                    <!-- העדפות -->
                    <controls:FlyoutMenuRow Icon="{x:Static fonts:FluentUI.settings_24_regular}"
                                            Title="העדפות"
                                            Subtitle="הגדרות משתמש"
                                            AutomationId="FlyoutPreferences"
                                            IsSelected="{Binding Source={x:Static viewmodels:FlyoutMenuState.Instance}, Path=IsPreferencesCurrent}"
                                            Activated="OnPreferencesTapped"/>
                </VerticalStackLayout>
            </ScrollView>
        </DataTemplate>
    </Shell.FlyoutContentTemplate>

    <!-- Startup and reading share one native navigation container. Flyout pages
         are pushed above it (AppRoutes.FlyoutPage), so back returns to the reader. -->
    <FlyoutItem FlyoutItemIsVisible="False">
        <ShellContent
            x:Name="ReaderContent"
            ContentTemplate="{DataTemplate pages:LoadingPage}"
            Route="PerekPage"/>
    </FlyoutItem>

</Shell>
