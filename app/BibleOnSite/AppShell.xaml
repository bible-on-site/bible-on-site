<?xml version="1.0" encoding="UTF-8" ?>
<!-- FlyoutBackdrop needed for iOS to show overlay when flyout is open.
     On iOS, the default is transparent unlike Android.
     See: https://github.com/xamarin/Xamarin.Forms/issues/15156 -->
<Shell
    x:Class="BibleOnSite.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BibleOnSite"
    xmlns:controls="clr-namespace:BibleOnSite.Controls"
    xmlns:pages="clr-namespace:BibleOnSite.Pages"
    xmlns:viewmodels="clr-namespace:BibleOnSite.ViewModels"
    xmlns:fonts="clr-namespace:Fonts"
    Shell.FlyoutBehavior="Flyout"
    FlyoutWidth="300"
    FlyoutBackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}"
    FlowDirection="RightToLeft"
    FlyoutBackdrop="#80000000">

    <!-- Flyout Header with Logo -->
    <Shell.FlyoutHeader>
        <Grid HeightRequest="180"
              BackgroundColor="White"
              Padding="0">
            <Image Source="logo_header.jpg"
                   Aspect="AspectFit"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   Margin="20"/>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Custom Flyout Content with Icons and Subtitles -->
    <Shell.FlyoutContentTemplate>
        <DataTemplate>
            <ScrollView>
                <VerticalStackLayout Spacing="0" BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}">
                    <!-- iOS/MacCatalyst lay the flyout content under FlyoutHeader (the
                         header height is applied as a scroll inset that races header
                         measurement and can leave the first rows permanently hidden
                         under the opaque header) — the logo is rendered in-content
                         there instead; see AppShell.xaml.cs. -->
                    <Grid HeightRequest="180"
                          BackgroundColor="White"
                          Padding="0">
                        <Grid.IsVisible>
                            <OnPlatform x:TypeArguments="x:Boolean" Default="False">
                                <On Platform="iOS,MacCatalyst" Value="true"/>
                            </OnPlatform>
                        </Grid.IsVisible>
                        <Image Source="logo_header.jpg"
                               Aspect="AspectFit"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               Margin="20"/>
                    </Grid>

                    <!-- Destination rows share FlyoutMenuRow (#2766): on Windows
                         its handler wraps the row in a native Button so the menu is
                         reachable and activatable with keyboard/screen reader, with
                         hover/pressed/focus visuals; touch platforms keep the
                         identical tap layout. -->
                    <!-- על הפרק -->
                    <controls:FlyoutMenuRow Icon="{x:Static fonts:FluentUI.calendar_today_24_regular}"
                                            Title="על הפרק"
                                            Subtitle="לימוד תנ&quot;ך יומי"
                                            AutomationId="FlyoutAlHaperek"
                                            Activated="OnAlHaperekTapped"/>

                    <!-- תנכפדיה -->
                    <controls:FlyoutMenuRow Icon="{x:Static fonts:FluentUI.library_24_regular}"
                                            Title="תנכפדיה"
                                            Subtitle="אנציקלופדיה לתנ&quot;ך"
                                            AutomationId="FlyoutTanahpedia"
                                            Activated="OnTanahpediaTapped"/>

                    <!-- לוח לימוד יומי -->
                    <controls:FlyoutMenuRow Icon="{x:Static fonts:FluentUI.calendar_month_24_regular}"
                                            Title="לוח לימוד יומי"
                                            Subtitle="הפרק היומי בלוח השנה"
                                            AutomationId="FlyoutLearningCalendar"
                                            Activated="OnLearningCalendarTapped"/>

                    <!-- מסורה על הפרק — opt-in entry gated by the מסורה preference (#2181) -->
                    <controls:FlyoutMenuRow Icon="{x:Static fonts:FluentUI.split_horizontal_24_regular}"
                                            Title="מסורה על הפרק"
                                            Subtitle="חלוקת פרשיות פתוחה וסתומה"
                                            AutomationId="FlyoutMasora"
                                            IsVisible="{Binding Source={x:Static viewmodels:FlyoutMenuState.Instance}, Path=ShowMasoraEntry}"
                                            Activated="OnMasoraTapped"/>

                    <!-- פרשה על הפרק -->
                    <controls:FlyoutMenuRow Icon="{x:Static fonts:FluentUI.book_open_24_regular}"
                                            Title="פרשה על הפרק"
                                            Subtitle="קריאת התורה וההפטרה"
                                            AutomationId="FlyoutParasha"
                                            Activated="OnParashaTapped"/>

                    <!-- רבנים -->
                    <controls:FlyoutMenuRow Icon="{x:Static fonts:FluentUI.edit_person_24_regular}"
                                            Title="רבנים"
                                            Subtitle="כותבים בתכנית"
                                            AutomationId="FlyoutAuthors"
                                            Activated="OnAuthorsTapped"/>

                    <!-- תנאי שימוש -->
                    <controls:FlyoutMenuRow Icon="{x:Static fonts:FluentUI.shield_question_24_regular}"
                                            Title="תנאי שימוש"
                                            Subtitle="הצהרות פרטיות ונגישות"
                                            AutomationId="FlyoutTerms"
                                            Activated="OnTermsTapped"/>

                    <!-- העדפות -->
                    <controls:FlyoutMenuRow Icon="{x:Static fonts:FluentUI.settings_24_regular}"
                                            Title="העדפות"
                                            Subtitle="הגדרות משתמש"
                                            AutomationId="FlyoutPreferences"
                                            Activated="OnPreferencesTapped"/>

                    <!-- צור קשר -->
                    <controls:FlyoutMenuRow Icon="{x:Static fonts:FluentUI.contact_card_24_regular}"
                                            Title="צור קשר"
                                            Subtitle="צוות התכנית"
                                            AutomationId="FlyoutContact"
                                            Activated="OnContactTapped"/>

                    <!-- תרומות -->
                    <controls:FlyoutMenuRow Icon="{x:Static fonts:FluentUI.money_hand_24_regular}"
                                            Title="תרומות"
                                            Subtitle="תמיכה בקיום התכנית"
                                            AutomationId="FlyoutDonations"
                                            Activated="OnDonationsTapped"/>
                </VerticalStackLayout>
            </ScrollView>
        </DataTemplate>
    </Shell.FlyoutContentTemplate>

    <!-- Startup and reading share one native navigation container. Flyout pages
         are pushed above it (AppRoutes.FlyoutPage), so back returns to the reader. -->
    <FlyoutItem FlyoutItemIsVisible="False">
        <ShellContent
            x:Name="ReaderContent"
            ContentTemplate="{DataTemplate pages:LoadingPage}"
            Route="PerekPage"/>
    </FlyoutItem>

</Shell>
