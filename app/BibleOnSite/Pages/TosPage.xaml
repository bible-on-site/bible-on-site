<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BibleOnSite.Controls"
             x:Class="BibleOnSite.Pages.TosPage"
             Title="תנאי שימוש"
             FlowDirection="RightToLeft"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <!-- The shared navigation capsule (#2467): hamburger far right, Back
         beside it (disabled at this root destination), title pill. -->
    <Grid RowDefinitions="Auto,*">
        <controls:SharedTopBar Grid.Row="0" NavigationAutomationId="TosMenuButton">
            <controls:SharedTopBar.CenterContent>
                <controls:ToolbarPill>
                    <Label Text="תנאי שימוש"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#AACBFF}"/>
                </controls:ToolbarPill>
            </controls:SharedTopBar.CenterContent>
        </controls:SharedTopBar>

    <ScrollView Grid.Row="1" Padding="16">
        <VerticalStackLayout Spacing="16">

            <!-- Main Title -->
            <Label Text="תנאי שימוש"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"/>

            <!-- Privacy Policy Section -->
            <VerticalStackLayout Spacing="8">
                <Label Text="מדיניות פרטיות"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                <Label Text="בתנ&quot;ך על הפרק אין הרשמה או חשבונות משתמשים. עם זאת, שימוש באתר או בישומון עשוי למסור נתונים טכניים, ובהם כתובת IP, פרטי מכשיר ומזהי מדידה, וכן מידע שתשלחו בפנייה אלינו. היעדר חשבון אינו הופך את כל הנתונים לאנונימיים. בישומון איסוף מזהי פרסום והתאמה אישית של פרסום מושבתים."
                       FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                <Label Text="לצורכי סטטיסטיקת שימוש ושיפור חוויית הלימוד היומי אנו משתמשים בשירותי אנליטיקה חיצוניים: Google Analytics באתר ו-Firebase Analytics בישומון (שניהם מסופקים על ידי Google), וכן Ahrefs באתר (מדידה ללא עוגיות). שירותים אלה עשויים לקבל מזהים טכניים ונתוני שימוש בהתאם למדיניות הפרטיות שלהם. המפות עשויות לטעון תוכן של Mapbox או OpenStreetMap; מוצגים בהן מקומות מקראיים ולא נאסף מיקום המכשיר."
                       FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                <Label Text="השירות מיועד לציבור בישראל. השירות פועל ללא מטרת רווח ואינו מציג פרסומות. נתוני שימוש נמדדים לשיפור הלימוד כחלק מפעילות השירות. העדפות הלימוד נשמרות במכשיר. פרטי יצירת קשר לבקשות הנוגעות לפרטיות מופיעים במדיניות הפרטיות המלאה."
                       FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                <Label Text="תשתית AWS של הפרויקט נמצאת באזור ישראל. שירותים חיצוניים, ובהם Google ו-Ahrefs, עשויים לעבד נתונים גם מחוץ לישראל בהתאם למדיניות שלהם. אין התחייבות שכל נתוני המדידה נשמרים בישראל."
                       FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                <Label Text="למדיניות הפרטיות המלאה: יצירת קשר, זכויות עיון ותיקון, תקופות שמירה וקישורים למדיניות ספקי השירותים"
                       FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}" TextDecorations="Underline"
                       SemanticProperties.Description="פתיחת מדיניות הפרטיות המלאה באתר התכנית"
                       AutomationId="PrivacyPolicyLink">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPrivacyPolicyTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

            <!-- Accessibility Statement Section -->
            <VerticalStackLayout Spacing="8">
                <Label Text="הצהרת נגישות"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                <Label Text="הצהרת הנגישות של התכנית מתוחזקת באתר ומכסה את האתר ואת היישומון."
                       FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                <Label Text="לצפייה בהצהרת הנגישות"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"
                       TextDecorations="Underline"
                       SemanticProperties.Description="פתיחת הצהרת הנגישות באתר התכנית"
                       AutomationId="AccessibilityStatementLink">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAccessibilityStatementTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

            <!-- Divider -->
            <BoxView HeightRequest="1" Color="{StaticResource Gray300}" Margin="0,8"/>

            <!-- Tanachpedia Section -->
            <VerticalStackLayout Spacing="8">
                <Label Text="תנכפדיה"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>

                <Label Text="שימוש"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"/>
                <Label Text="השימוש בתנכפדיה הוא על אחריות המשתמש, אין בעלי האתר והעורכים נושאים בשום נזק ישיר או עקיף מכל סוג שהוא שייגרמו משימוש במידע, שכן הוא מוגש 'כמות שהוא'."
                       FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                <Label Text="אנו מתפללים שלא תצא תקלה מתחת ידינו, עם זאת לפעמים נופלות טעויות בתחומים שונים, ביניהם כאלו שיכולות להזיק או לפגוע, אם הבחנתם בכאלה אתם יותר ממוזמנים לפנות ובע&quot;ה הנושא ייבחן ובמידת הצורך יטופל בהקדם."
                       FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>

                <Label Text="שימוש חוזר"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"
                       Margin="0,8,0,0"/>
                <Label FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="תנכפדיה "/>
                            <Span Text="אינה" FontAttributes="Bold"/>
                            <Span Text=" אנציקלופדיה חופשית כמו ויקיפדיה, ויקישיבה ודומיהם."/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>

            <!-- Divider -->
            <BoxView HeightRequest="1" Color="{StaticResource Gray300}" Margin="0,8"/>

            <!-- Tanach Al Haperek Section -->
            <VerticalStackLayout Spacing="8">
                <Label Text="תנ&quot;ך על הפרק"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>

                <Label Text="שימוש"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"/>
                <Label Text="ניתן להשתמש לכל צורך אישי או לימודי שאינם מסחריים."
                       FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                <Label Text="כמו כן ניתן להפנות אלינו שאלות ונעביר לרבנים הכותבים."
                       FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>

                <Label Text="שימוש חוזר"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"
                       Margin="0,8,0,0"/>
                <Label Text="מצווה להפיץ הפניות למאמרים אל מכריכם, אך אין להעתיק את המאמרים לאתר אחר או ספר וכד' ללא הסכמה מפורשת מהרב המחבר."
                       FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                <HorizontalStackLayout Spacing="4">
                    <Label Text="המפרשים על הפרק באדיבות"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                    <Label Text="ספאריה"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSefariaTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
                <Label Text=". שימוש חוזר על פי תנאי השימוש שלהם."
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>

                <HorizontalStackLayout Spacing="4">
                    <Label Text="הפרקים המוקלטים באדיבות"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                    <Label Text="הרב דן בארי"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDanBarryTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
                <Label Text=". שימוש חוזר על פי תנאי השימוש שיציב."
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>

            </VerticalStackLayout>

            <!-- Divider -->
            <BoxView HeightRequest="1" Color="{StaticResource Gray300}" Margin="0,8"/>

            <!-- Copyright & content reports Section -->
            <VerticalStackLayout Spacing="8">
                <Label Text="זכויות יוצרים ופניות בנושא תוכן"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                <Label Text="פרויקט תנ&quot;ך על הפרק פועל לשם לימוד וזיכוי הרבים, ללא מטרת רווח. אנו פועלים בתום לב ונוקטים מאמצים סבירים לכבד זכויות יוצרים ולשמור על ייחוס מתאים ליוצרים ולבעלי הזכויות."
                       FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                <Label Text="למיטב ידיעתנו ועל יסוד המידע המצוי בידינו:"
                       FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                <Label Text="• המאמרים מוצגים על סמך אישורים שקיבלנו מהרבנים המחברים או מההוצאה לאור, ובכפוף להיקף ההרשאה ולתנאיה."
                       FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                <Label Text="• התמונות צולמו על ידינו, סופקו לנו על ידי המצלמים, נוצרו באמצעות בינה מלאכותית, או מוצגות על בסיס שימוש הוגן או שימוש אחר המותר על פי דין, בהתאם לנסיבות העניין."
                       FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                <Label Text="• הערכים בתנכפדיה נכתבו במלואם על ידינו באופן מקורי ולא הועתקו מערכים במקורות קיימים."
                       FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                <Label Text="המידע בדבר מקור התכנים וההרשאות לשימוש בהם נמסר לפי המידע שבידינו, ואינו התחייבות לכך שלא תתעורר מחלוקת בנוגע לזכויות בפריט מסוים. אין בפרסום תוכן כדי להקנות זכויות שאין בידינו להקנותן, ואין בו לגרוע מזכויות היוצרים ובעלי הזכויות לפי דין."
                       FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                <!-- The report sentence and its email action stack
                     vertically so the address can never be pushed off a
                     narrow screen. A native button exposes keyboard and
                     assistive-technology activation as well as touch. -->
                <Label Text="אם זיהיתם פריט שקיים לגביו חשש להפרת זכויות יוצרים, אנא פנו אלינו בכתובת:"
                       FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                <Button Text="tanah.site@gmail.com"
                       FontSize="14"
                       BackgroundColor="Transparent"
                       Padding="0,8"
                       HorizontalOptions="Start"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"
                       SemanticProperties.Description="שליחת דיווח בנושא זכויות יוצרים בדוא&quot;ל"
                       AutomationId="CopyrightEmailLink"
                       Clicked="OnCopyrightEmailTapped"/>
                <Label Text="לצורך בירור הפנייה, נא לצרף פרטי קשר למענה, קישור או זיהוי ברור של הפריט, תיאור החשש ואסמכתאות ככל שהן מצויות ברשותכם."
                       FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                <Label Text="נבחן את הפנייה ונפעל לטיפול בה בהקדם האפשרי, בהתאם לנסיבותיה ולמידע שיתקבל. ככל שיתברר שיש להסיר פריט, לתקן ייחוס או לנקוט פתרון אחר, נפעל לכך בהקדם האפשרי ובהתאם לדין."
                       FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                <Label Text="המדווח יקבל מידע שקוף לאורך כל תהליך הטיפול: אישור על קבלת הפנייה, עדכונים על הטיפול ועל כל שינוי בסטטוס, ועדכון עם סיום הטיפול. עדכון הסיום יפרט את התוצאה, לרבות השארת הפריט, הסרתו או כל סיום אחר, ואת ההסבר המתאים. העדכונים יישלחו לפי פרטי הקשר שנמסרו בפנייה."
                       FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                <Label Text="עצם קבלת הפנייה, בירורה, מסירת עדכון, שינוי תוכן או הסרתו אינם מהווים, כשלעצמם, הודאה בהפרת זכויות או בחבות כלשהי, או ויתור על טענה, זכות או הגנה העומדות לנו על פי דין."
                       FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                <Label Text="הוראות סעיף זה כפופות לדין, ואין בהן כדי לגרוע מהוראות דין שאין להתנות עליהן."
                       FontSize="14"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
            </VerticalStackLayout>

            <!-- Bottom spacing -->
            <BoxView HeightRequest="20"/>

        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
