<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BibleOnSite.Controls"
             x:Class="BibleOnSite.Pages.DonationsPage"
             Title="תרומות"
             FlowDirection="RightToLeft"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <!-- The shared navigation capsule (#2467): hamburger far right, Back
         beside it (disabled at this root destination), title pill. -->
    <Grid RowDefinitions="Auto,*">
        <controls:SharedTopBar Grid.Row="0" NavigationAutomationId="DonationsMenuButton">
            <controls:SharedTopBar.CenterContent>
                <controls:ToolbarPill>
                    <Label Text="תרומות"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#AACBFF}"/>
                </controls:ToolbarPill>
            </controls:SharedTopBar.CenterContent>
        </controls:SharedTopBar>

    <ScrollView Grid.Row="1" Padding="16">
        <VerticalStackLayout Spacing="24">

            <!-- Introduction Text -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                    Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.1"/>
                </Border.Shadow>
                <Label Text="פיתוח ותחזוק התוכנית דורשים משאבים רבים.&#10;נשמח אם תוכלו להשתתף בנטל.&#10;איננו מציגים פרסומות.&#10;ההכנסות קודש ל'תנ&quot;ך על הפרק'.&#10;&#10;ניתן להקדיש לימוד למטרות קדושות כגון:&#10;לעילוי נשמת יקירכם, לרפואה, לזיווג וכדומה."
                       FontSize="16"
                       LineHeight="1.4"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
            </Border>

            <!-- Contact link for donations -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,20,0,0">
                <Label Text="צור קשר"
                       FontSize="16"
                       TextColor="{StaticResource Primary}"
                       TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnContactTapped"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="למתן תרומה"
                       FontSize="16"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
            </HorizontalStackLayout>

            <!-- Thank you message -->
            <Label Text="תודה רבה על תמיכתכם!"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource Primary}"
                   Margin="0,16,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
