<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BibleOnSite.ViewModels"
             xmlns:models="clr-namespace:BibleOnSite.Models"
             xmlns:controls="clr-namespace:BibleOnSite.Controls"
             xmlns:converters="clr-namespace:BibleOnSite.Converters"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="BibleOnSite.Pages.MasoraPage"
             x:Name="MasoraPageRoot"
             x:DataType="viewmodels:MasoraViewModel"
             Title="{Binding Heading}"
             BackgroundColor="{AppThemeBinding Light=#F2F7FE, Dark=#20304A}"
             FlowDirection="RightToLeft"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <x:Double x:Key="BottomBarTotalHeight">90</x:Double>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid x:Name="MainGrid" RowDefinitions="Auto,*">
        <Grid x:Name="ReaderToolbar" Grid.Row="0" MinimumHeightRequest="56"
              BackgroundColor="{AppThemeBinding Light=#F2F7FE, Dark=#20304A}">
            <controls:SharedTopBar x:Name="NormalNavigationBar" NavigationAutomationId="ReaderNavigationButton">
                <controls:SharedTopBar.CenterContent>
                <Button x:Name="NormalNavigationTitle"
                   AutomationId="MasoraSource"
                   Text="{Binding Heading}"
                   FontSize="20"
                   Padding="12,0"
                   HeightRequest="40"
                   CornerRadius="14"
                   BorderWidth="0"
                   BackgroundColor="{AppThemeBinding Light=#E4EFFD, Dark=#2C4569}"
                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"
                   VerticalOptions="Center"
                   HorizontalOptions="Fill"
                   Margin="4,0"
                   SemanticProperties.Hint="הקישו לפתיחת בחירת פרשה"
                   Clicked="OnUnitSourceClicked"/>
                </controls:SharedTopBar.CenterContent>
            </controls:SharedTopBar>
        </Grid>

        <!-- Exit Full Screen Button (floating, draggable, hidden by default) -->
        <controls:ReaderExitFullscreenButton x:Name="ExitFullScreenButton" Grid.Row="1"
                Margin="16,16,16,100"
                ZIndex="100"/>

        <!-- Main Content Area - fills entire viewport -->
        <Grid x:Name="ContentArea" Grid.Row="1" BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}"
              ZIndex="0"
              RowDefinitions="Auto,Auto,*">

            <!-- Loading overlay — shown while CarouselView initialises its adapter. -->
            <controls:ReaderLoadingOverlay x:Name="CarouselLoadingOverlay"
                  Grid.Row="1" Grid.RowSpan="2"
                  ZIndex="10"
                  LoadingText="מתחבר למסורה..."
                  ErrorTitle="שגיאה בטעינת המסורה"
                  AutomationIdPrefix="MasoraLoad"
                  RetryRequested="OnUnitLoadRetryClicked"/>

            <!-- CarouselView for unit-based swipe navigation (Row 1 + Row 2) -->
            <CarouselView Grid.Row="1"
                          Grid.RowSpan="2"
                          x:Name="MasoraCarousel"
                          ItemsSource="{Binding CarouselUnits}"
                          CurrentItem="{Binding CurrentCarouselUnit, Mode=TwoWay}"
                          Position="{Binding CarouselPosition, Mode=TwoWay}"
                          CurrentItemChanged="OnCarouselItemChanged"
                          Loop="False"
                          PeekAreaInsets="1"
                          Margin="0">
                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="models:MasoraUnit">
                        <!-- Unit page: header + CollectionView of rows -->
                        <Grid RowDefinitions="Auto,*">
                            <!-- Unit header: parasha-identity heading + break label -->
                            <VerticalStackLayout Grid.Row="0" Spacing="2" Padding="16,12,16,8">
                                <Label AutomationId="MasoraUnitHeading"
                                       Text="{Binding Heading}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"/>
                                <Label AutomationId="MasoraClosingBreak"
                                       Text="{Binding ClosingBreakLabel}"
                                       IsVisible="{Binding HasClosingBreak}"
                                       FontSize="14"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                            </VerticalStackLayout>

                            <!-- Unit text - pasuk rows clipped to the unit's canonical range -->
                            <CollectionView Grid.Row="1"
                                            x:Name="MasoraRowsCollection"
                                            AutomationId="MasoraRowsCollection"
                                            ItemsSource="{Binding Rows}"
                                            SelectionMode="None"
                                            Margin="8,0,8,0">
                                <CollectionView.Footer>
                                    <ContentView HeightRequest="{DynamicResource BottomBarTotalHeight}" BackgroundColor="Transparent"/>
                                </CollectionView.Footer>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:MasoraPasukRow">
                                        <VerticalStackLayout Spacing="0">
                                            <!-- No perek dividers or chapter pasuk numbers: the מסורה
                                                 reader presents the parasha as one continuous text. -->
                                            <controls:ReaderCellBorder Padding="12,8"
                                                    Margin="0,4"
                                                    StrokeShape="RoundRectangle 8"
                                                    Stroke="Transparent"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                                                <Border.FlowDirection>
                                                    <OnPlatform x:TypeArguments="FlowDirection">
                                                        <On Platform="iOS" Value="RightToLeft"/>
                                                        <On Platform="MacCatalyst" Value="RightToLeft"/>
                                                    </OnPlatform>
                                                </Border.FlowDirection>
                                                <Grid ColumnDefinitions="*"
                                                      FlowDirection="RightToLeft">
                                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                        <controls:PasukTextLabel AutomationId="PasukText"
                                                               FormattedText="{Binding Pasuk.FormattedText}"
                                                               FontSize="{Binding FontSize}"
                                                               FlowDirection="RightToLeft"
                                                               LineBreakMode="WordWrap"
                                                               LineHeight="1.4"/>
                                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Pasuk.VisiblePerushNotes}"
                                                                             Spacing="2"
                                                                             Margin="0,4,0,0">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="models:PerushNoteDisplay">
                                                                    <VerticalStackLayout Spacing="2">
                                                                        <Grid HeightRequest="36"
                                                                              IsVisible="{Binding IsContentReady, Source={x:Reference PerushContentView}, Converter={StaticResource InvertedBoolConverter}}">
                                                                            <ActivityIndicator IsRunning="True" WidthRequest="20" HeightRequest="20"
                                                                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                                                        </Grid>
                                                                        <VerticalStackLayout Spacing="2"
                                                                                             IsVisible="{Binding IsContentReady, Source={x:Reference PerushContentView}}">
                                                                            <Label Text="{Binding PerushName}"
                                                                                   AutomationId="InlinePerushName"
                                                                                   FontSize="{DynamicResource PerushNameFontSize}"
                                                                                   FontAttributes="Bold"
                                                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"/>
                                                                            <controls:HtmlView x:Name="PerushContentView" ContentLoader="{Binding ContentLoader}" HtmlContent="{Binding DisplayContent}"
                                                                                              FontSize="{DynamicResource PerushContentFontSize}"
                                                                                              TextAlignment="Justify"
                                                                                              TextDirection="Rtl"
                                                                                              LineHeight="1.4"/>
                                                                        </VerticalStackLayout>
                                                                    </VerticalStackLayout>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </VerticalStackLayout>
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </controls:ReaderCellBorder>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <VerticalStackLayout VerticalOptions="Center"
                                                         HorizontalOptions="Center"
                                                         Padding="20">
                                        <Image Source="loading_book_anim.gif"
                                               IsAnimationPlaying="True"
                                               HeightRequest="60"
                                               WidthRequest="60"
                                               Aspect="AspectFit"/>
                                        <Label Text="מתחבר לפרשה..."
                                               AutomationId="MasoraLoadingLabel"
                                               FontSize="18"
                                               HorizontalTextAlignment="Center"
                                               Margin="0,10,0,0"/>
                                    </VerticalStackLayout>
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </Grid>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>

            <!-- Articles View (hidden by default, shown when articles button clicked) -->
            <controls:ReaderArticlesView Grid.Row="2"
                            x:Name="ArticlesCollection"
                            EmptyText="אין מאמרים ליחידה זו"
                            SelectedArticleId="{Binding SelectedArticleId}"/>
        </Grid>

        <!-- Perushim Panel (slides up from bottom, above content but behind bottom bar) -->
        <controls:PerushimSheet x:Name="PerushimPanel" Grid.Row="1" ZIndex="50"/>

        <!-- Bottom Navigation Bar with Circular Menu - OVERLAY floating at bottom -->
        <controls:ReaderBottomBar x:Name="BottomBar" Grid.Row="1"
              ZIndex="100"
              ArticlesBadgeCount="{Binding ArticlesCount}"/>

        <!-- Circular navigation fan - shared layer (scrim + satellites + FAB) -->
        <controls:ReaderFanMenu x:Name="FanMenu" Grid.Row="1" ZIndex="150">
            <controls:ReaderFanMenu.Satellites>
                <!-- Previous unit (bottom-left satellite). Disabled at the first unit via Command.CanExecute. -->
                <controls:ReaderFanMenuSatellite x:Name="PrevUnitButton"
                        AutomationId="PrevUnitButton"
                        Text="{x:Static fonts:FluentUI.document_arrow_right_24_regular}"
                        Command="{Binding LoadPreviousCommand}"
                        Clicked="OnMenuItemClicked"/>

                <!-- Unit picker (top satellite) -->
                <controls:ReaderFanMenuSatellite x:Name="UnitPickerButton"
                        AutomationId="UnitPickerButton"
                        Text="{x:Static fonts:FluentUI.library_24_regular}"
                        Clicked="OnUnitPickerClicked"/>

                <!-- Next unit (bottom-right satellite). Disabled at the last unit via Command.CanExecute. -->
                <controls:ReaderFanMenuSatellite x:Name="NextUnitButton"
                        AutomationId="NextUnitButton"
                        Text="{x:Static fonts:FluentUI.document_arrow_right_24_regular}"
                        ScaleX="-1"
                        Command="{Binding LoadNextCommand}"
                        Clicked="OnMenuItemClicked"/>
            </controls:ReaderFanMenu.Satellites>
        </controls:ReaderFanMenu>

        <controls:MasoraUnitPickerPopup x:Name="MasoraUnitPickerPopup" Grid.Row="1"
                                        ZIndex="200"/>
    </Grid>

</ContentPage>
