<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BibleOnSite.ViewModels"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="BibleOnSite.Pages.LearningCalendarPage"
             x:DataType="viewmodels:LearningCalendarViewModel"
             Title="לוח לימוד יומי"
             FlowDirection="RightToLeft">

    <!-- Regular page presentation: the page stays on the navigation stack, so
         device/system Back returns to the previous page (e.g. from the reader). -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False"/>
    </Shell.BackButtonBehavior>

    <!-- Shared top bar: hamburger that opens the flyout, like every other page. -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
            <Button Text="{x:Static fonts:FluentUI.line_horizontal_3_20_regular}"
                    FontFamily="FluentIcons"
                    FontSize="20"
                    WidthRequest="40"
                    HeightRequest="40"
                    Padding="0"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                    SemanticProperties.Description="תפריט"
                    AutomationId="CalendarMenuButton"
                    VerticalOptions="Center"
                    HorizontalOptions="Start"
                    Clicked="OnMenuButtonClicked"/>
            <Label Grid.Column="1"
                   Text="לוח לימוד יומי"
                   FontSize="20"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"
                   TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource AccentOnDark}}"/>
        </Grid>
    </Shell.TitleView>

    <ContentPage.Resources>
        <Style x:Key="CalendarNavButton" TargetType="Button">
            <Setter Property="FontFamily" Value="FluentIcons"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="WidthRequest" Value="40"/>
            <Setter Property="HeightRequest" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"/>
        </Style>
        <Style x:Key="CalendarPicker" TargetType="Picker">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"/>
            <Setter Property="HeightRequest" Value="44"/>
        </Style>
        <!-- Unselected view-toggle state: quiet surface so the active segment's
             Primary fill reads as the selected option in both themes. -->
        <Style x:Key="CalendarToggleButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HeightRequest" Value="38"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F8FAFC, Dark=#1A1F2E}"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Padding="8">

        <!-- View toggle: monthly / yearly / full cycle (#2364) -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*" ColumnSpacing="4" Margin="0,0,0,4">
            <Button Grid.Column="0"
                    Text="חודשי"
                    Style="{StaticResource CalendarToggleButton}"
                    AutomationId="CalendarViewMonth"
                    SemanticProperties.Description="תצוגה חודשית"
                    Command="{Binding SetViewModeCommand}"
                    CommandParameter="{x:Static viewmodels:CalendarViewMode.Month}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding ViewMode}"
                                 Value="{x:Static viewmodels:CalendarViewMode.Month}">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                        <Setter Property="TextColor" Value="White"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1"
                    Text="שנתי"
                    Style="{StaticResource CalendarToggleButton}"
                    AutomationId="CalendarViewYear"
                    SemanticProperties.Description="תצוגה שנתית"
                    Command="{Binding SetViewModeCommand}"
                    CommandParameter="{x:Static viewmodels:CalendarViewMode.Year}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding ViewMode}"
                                 Value="{x:Static viewmodels:CalendarViewMode.Year}">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                        <Setter Property="TextColor" Value="White"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="2"
                    Text="מחזור מלא"
                    Style="{StaticResource CalendarToggleButton}"
                    AutomationId="CalendarViewCycle"
                    SemanticProperties.Description="תצוגת מחזור מלא"
                    Command="{Binding SetViewModeCommand}"
                    CommandParameter="{x:Static viewmodels:CalendarViewMode.Cycle}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding ViewMode}"
                                 Value="{x:Static viewmodels:CalendarViewMode.Cycle}">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                        <Setter Property="TextColor" Value="White"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- Period navigation: previous/today/next + month and year pickers + PDF export -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,*,Auto" ColumnSpacing="4">
            <Button Grid.Column="0"
                    Text="{x:Static fonts:FluentUI.chevron_right_24_regular}"
                    Style="{StaticResource CalendarNavButton}"
                    SemanticProperties.Description="חודש קודם"
                    AutomationId="CalendarPrevMonth"
                    Command="{Binding PrevMonthCommand}"/>
            <Button Grid.Column="1"
                    Text="היום"
                    FontSize="14"
                    FontFamily=""
                    HeightRequest="40"
                    Padding="10,0"
                    SemanticProperties.Description="חזרה לחודש הנוכחי"
                    AutomationId="CalendarToday"
                    Command="{Binding TodayCommand}"/>
            <Button Grid.Column="2"
                    Text="{x:Static fonts:FluentUI.chevron_left_24_regular}"
                    Style="{StaticResource CalendarNavButton}"
                    SemanticProperties.Description="חודש הבא"
                    AutomationId="CalendarNextMonth"
                    Command="{Binding NextMonthCommand}"/>
            <Picker Grid.Column="3"
                    ItemsSource="{Binding MonthOptions}"
                    SelectedItem="{Binding SelectedMonth}"
                    ItemDisplayBinding="{Binding Label}"
                    Title="חודש"
                    Style="{StaticResource CalendarPicker}"
                    AutomationId="CalendarMonthPicker"/>
            <Picker Grid.Column="4"
                    ItemsSource="{Binding YearOptions}"
                    SelectedItem="{Binding SelectedYear}"
                    ItemDisplayBinding="{Binding Label}"
                    Title="שנה"
                    Style="{StaticResource CalendarPicker}"
                    AutomationId="CalendarYearPicker"/>
            <Button Grid.Column="5"
                    Text="{x:Static fonts:FluentUI.arrow_download_24_regular}"
                    Style="{StaticResource CalendarNavButton}"
                    SemanticProperties.Description="הורדת לוח הלימוד כ-PDF"
                    AutomationId="CalendarDownloadPdf"
                    Command="{Binding DownloadPdfCommand}"/>
        </Grid>

        <!-- Period title -->
        <Label Grid.Row="2"
               Text="{Binding MonthLabel}"
               FontSize="22"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               Margin="0,4"
               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>

        <!-- Cycle picker + range -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Picker Grid.Column="0"
                    ItemsSource="{Binding CycleOptions}"
                    SelectedItem="{Binding SelectedCycle}"
                    ItemDisplayBinding="{Binding Label}"
                    Title="מחזור"
                    Style="{StaticResource CalendarPicker}"
                    AutomationId="CalendarCyclePicker"/>
            <Label Grid.Column="1"
                   Text="{Binding CycleLabel}"
                   FontSize="12"
                   VerticalOptions="Center"
                   LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
        </Grid>

        <!-- Weekday headers (RTL: first column is Sunday) -->
        <Grid Grid.Row="4" ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,4,0,0"
              IsVisible="{Binding IsMonthView}">
            <Label Grid.Column="0" Text="א" FontAttributes="Bold" HorizontalTextAlignment="Center" SemanticProperties.Description="ראשון" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
            <Label Grid.Column="1" Text="ב" FontAttributes="Bold" HorizontalTextAlignment="Center" SemanticProperties.Description="שני" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
            <Label Grid.Column="2" Text="ג" FontAttributes="Bold" HorizontalTextAlignment="Center" SemanticProperties.Description="שלישי" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
            <Label Grid.Column="3" Text="ד" FontAttributes="Bold" HorizontalTextAlignment="Center" SemanticProperties.Description="רביעי" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
            <Label Grid.Column="4" Text="ה" FontAttributes="Bold" HorizontalTextAlignment="Center" SemanticProperties.Description="חמישי" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
            <Label Grid.Column="5" Text="ו" FontAttributes="Bold" HorizontalTextAlignment="Center" SemanticProperties.Description="שישי" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
            <Label Grid.Column="6" Text="ש" FontAttributes="Bold" HorizontalTextAlignment="Center" SemanticProperties.Description="שבת" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
        </Grid>

        <!-- Month grid -->
        <CollectionView Grid.Row="5"
                        ItemsSource="{Binding Cells}"
                        ItemsLayout="VerticalGrid, 7"
                        SelectionMode="None"
                        IsVisible="{Binding IsMonthView}"
                        AutomationId="CalendarGrid">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:CalendarCellViewModel">
                    <Border Margin="1"
                            Padding="2"
                            HeightRequest="58"
                            StrokeShape="RoundRectangle 6"
                            Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1A1F2E}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCellTapped"
                                                  CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsToday}"
                                         Value="True">
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"/>
                                <Setter Property="StrokeThickness" Value="2"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsReview}"
                                         Value="True">
                                <Setter Property="StrokeDashArray" Value="3,3"/>
                                <Setter Property="BackgroundColor" Value="Transparent"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsNone}"
                                         Value="True">
                                <Setter Property="Stroke" Value="Transparent"/>
                                <Setter Property="BackgroundColor" Value="Transparent"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsBlank}"
                                         Value="True">
                                <Setter Property="Stroke" Value="Transparent"/>
                                <Setter Property="BackgroundColor" Value="Transparent"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid SemanticProperties.Description="{Binding AccessibilityText}">
                            <VerticalStackLayout IsVisible="{Binding IsBlank, Converter={StaticResource InvertedBoolConverter}}"
                                                 VerticalOptions="Center"
                                                 Spacing="0">
                                <Label Text="{Binding DayText}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                                <Label Text="{Binding PerekSource}"
                                       FontSize="10"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"/>
                                <Label Text="חזרה"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       IsVisible="{Binding IsReview}"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Yearly / full-cycle views: grouped mini-months (#2364) -->
        <CollectionView Grid.Row="5"
                        ItemsSource="{Binding MonthGroups}"
                        SelectionMode="None"
                        IsVisible="{Binding IsGroupedView}"
                        AutomationId="CalendarGroups">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:MiniMonthViewModel">
                    <VerticalStackLayout Margin="0,6" Spacing="2">
                        <Label Text="{Binding Title}"
                               AutomationId="MiniMonthTitle"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                            <Label Grid.Column="0" Text="א" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="Center" AutomationId="MiniMonthWeekday" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                            <Label Grid.Column="1" Text="ב" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="Center" AutomationId="MiniMonthWeekday" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                            <Label Grid.Column="2" Text="ג" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="Center" AutomationId="MiniMonthWeekday" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                            <Label Grid.Column="3" Text="ד" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="Center" AutomationId="MiniMonthWeekday" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                            <Label Grid.Column="4" Text="ה" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="Center" AutomationId="MiniMonthWeekday" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                            <Label Grid.Column="5" Text="ו" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="Center" AutomationId="MiniMonthWeekday" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                            <Label Grid.Column="6" Text="ש" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="Center" AutomationId="MiniMonthWeekday" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                        </Grid>
                        <!-- Week rows of plain layout cells: a nested CollectionView per
                             mini-month spun up a whole adapter/recycler per section and
                             was the dominant grouped-view realization cost (#2455).
                             A 7-star Grid keeps the columns equal; HorizontalStackLayout
                             ignores FillAndExpand in MAUI and shrank the rows to content
                             width on iOS. -->
                        <VerticalStackLayout Spacing="0"
                                             BindableLayout.ItemsSource="{Binding Weeks}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:MiniMonthWeekViewModel">
                                    <Grid ColumnDefinitions="*,*,*,*,*,*,*"
                                          AutomationId="MiniMonthWeek"
                                          BindableLayout.ItemsSource="{Binding Cells}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:CalendarCellViewModel">
                                            <Border Margin="1"
                                                    Padding="0"
                                                    HeightRequest="24"
                                                    Grid.Column="{Binding Column}"
                                                    AutomationId="MiniMonthDay"
                                                    StrokeShape="RoundRectangle 4"
                                                    Stroke="Transparent"
                                                    StrokeThickness="1"
                                                    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1A1F2E}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnCellTapped"
                                                                          CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding IsToday}"
                                                                 Value="True">
                                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"/>
                                                        <Setter Property="StrokeThickness" Value="2"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding IsReview}"
                                                                 Value="True">
                                                        <Setter Property="StrokeDashArray" Value="3,3"/>
                                                        <Setter Property="BackgroundColor" Value="Transparent"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding IsNone}"
                                                                 Value="True">
                                                        <Setter Property="BackgroundColor" Value="Transparent"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding IsBlank}"
                                                                 Value="True">
                                                        <Setter Property="BackgroundColor" Value="Transparent"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding IsDimmed}"
                                                                 Value="True">
                                                        <Setter Property="Opacity" Value="0.3"/>
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="{Binding DayText}"
                                                       FontSize="11"
                                                       IsVisible="{Binding IsBlank, Converter={StaticResource InvertedBoolConverter}}"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center"
                                                       AutomationId="MiniMonthDayText"
                                                       SemanticProperties.Description="{Binding AccessibilityText}"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                                            </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Legend -->
        <HorizontalStackLayout Grid.Row="6"
                               HorizontalOptions="Center"
                               Spacing="14"
                               Margin="0,6,0,0">
            <HorizontalStackLayout Spacing="4">
                <!-- Legend swatch mirrors the day-cell surface in both themes -->
                <BoxView WidthRequest="12" HeightRequest="12" CornerRadius="3" Color="{AppThemeBinding Light=#F8FAFC, Dark=#1A1F2E}"/>
                <Label Text="יום לימוד" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="4">
                <Border WidthRequest="12" HeightRequest="12" StrokeShape="RoundRectangle 3" StrokeDashArray="2,2" Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" BackgroundColor="Transparent"/>
                <Label Text="יום חזרה" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="4">
                <Border WidthRequest="12" HeightRequest="12" StrokeShape="RoundRectangle 3" Stroke="Transparent" BackgroundColor="Transparent"/>
                <Label Text="לא משובץ" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
            </HorizontalStackLayout>
        </HorizontalStackLayout>

        <!-- Loading / error overlay -->
        <Grid Grid.RowSpan="7"
              IsVisible="{Binding IsLoading}">
            <ActivityIndicator IsRunning="True"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>
        </Grid>
        <Label Grid.RowSpan="7"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
               TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
               FontSize="14"
               HorizontalTextAlignment="Center"
               VerticalOptions="Center"
               Padding="20"/>
    </Grid>
</ContentPage>
