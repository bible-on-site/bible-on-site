<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BibleOnSite.ViewModels"
             xmlns:models="clr-namespace:BibleOnSite.Models"
             xmlns:controls="clr-namespace:BibleOnSite.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="BibleOnSite.Pages.TanahpediaPage"
             x:Name="Page"
             x:DataType="viewmodels:TanahpediaViewModel"
             Title="תנכפדיה"
             FlowDirection="RightToLeft">

    <!-- Flyout landing page: the page stays on the navigation stack, so the
         device/system Back still returns to the reader. -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False"/>
    </Shell.BackButtonBehavior>

    <!-- Shared top bar: hamburger that opens the flyout, like every
         other page in the app. -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
            <Button Text="{x:Static fonts:FluentUI.line_horizontal_3_20_regular}"
                    FontFamily="FluentIcons"
                    FontSize="20"
                    WidthRequest="40"
                    HeightRequest="40"
                    Padding="0"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                    SemanticProperties.Description="תפריט"
                    AutomationId="TanahpediaMenuButton"
                    VerticalOptions="Center"
                    HorizontalOptions="Start"
                    Clicked="OnMenuButtonClicked"/>
            <!-- Title pill like the reader's source pill: opens the scoped
                 Tanahpedia search overlay. -->
            <Button Grid.Column="1"
                    Text="תנכפדיה"
                    FontSize="20"
                    Padding="12,0"
                    HeightRequest="40"
                    CornerRadius="14"
                    BorderWidth="0"
                    BackgroundColor="{AppThemeBinding Light=#E4EFFD, Dark=#2C4569}"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#AACBFF}"
                    VerticalOptions="Center"
                    HorizontalOptions="Start"
                    SemanticProperties.Hint="הקישו לפתיחת החיפוש"
                    AutomationId="TanahpediaSearchTitle"
                    Clicked="OnSearchTitleClicked"/>
        </Grid>
    </Shell.TitleView>

    <Grid>
        <!-- Content -->
        <ScrollView IsVisible="{Binding HasError, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Padding="16" Spacing="20">
                <!-- Header -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="אנציקלופדיה לתנ&quot;ך - אישים, מקומות, אירועים, חפצים ועוד"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                </VerticalStackLayout>

                <!-- היום בתנ"ך -->
                <VerticalStackLayout Spacing="8"
                                     IsVisible="{Binding HasToday}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="היום בתנ&quot;ך"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                        <Label Grid.Column="1"
                               Text="{Binding HebrewDateText}"
                               FontSize="13"
                               VerticalTextAlignment="End"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                    </Grid>
                    <VerticalStackLayout Spacing="4"
                                         BindableLayout.ItemsSource="{Binding TodayEntities}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:TanahpediaEntityItem">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="●"
                                           FontSize="10"
                                           VerticalTextAlignment="Center"
                                           TextColor="{StaticResource Primary}"/>
                                    <Label Text="{Binding EntityName}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           VerticalTextAlignment="Center"
                                           IsVisible="{Binding ShowNamePlain}"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Links}"
                                                           IsVisible="{Binding ShowLinks}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:TanahpediaEntryLink">
                                                <HorizontalStackLayout>
                                                    <Label Text="{Binding Prefix}"
                                                           FontSize="15"
                                                           VerticalTextAlignment="Center"
                                                           IsVisible="{Binding Prefix, Converter={StaticResource StringNotEmptyConverter}}"
                                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                                                    <Label Text="{Binding Title}"
                                                           FontSize="15"
                                                           TextColor="{StaticResource Primary}"
                                                           TextDecorations="Underline"
                                                           VerticalTextAlignment="Center">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenEntryCommand}"
                                                                                  CommandParameter="{Binding UniqueName}"/>
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                    <Label Text="{Binding Suffix}"
                                                           FontSize="15"
                                                           VerticalTextAlignment="Center"
                                                           IsVisible="{Binding Suffix, Converter={StaticResource StringNotEmptyConverter}}"
                                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                                                </HorizontalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- קטגוריות -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="קטגוריות"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                    <VerticalStackLayout Spacing="12"
                                         BindableLayout.ItemsSource="{Binding CategoryGroups}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:TanahpediaCategoryGroup">
                                <VerticalStackLayout Spacing="6">
                                    <!-- Parent category card -->
                                    <Border Padding="14,10"
                                            StrokeShape="RoundRectangle 12"
                                            Stroke="Transparent"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                                        <Border.Shadow>
                                            <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.15"/>
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenCategoryCommand}"
                                                                  CommandParameter="{Binding Parent}"/>
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Parent.Label}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                                            <Label Grid.Column="1"
                                                   FontSize="13"
                                                   VerticalTextAlignment="Center"
                                                   TextColor="{StaticResource Primary}">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="{}{0} ערכים">
                                                        <Binding Path="Parent.Count"/>
                                                    </MultiBinding>
                                                </Label.Text>
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding Parent.IsComingSoon}"
                                                                 Value="True">
                                                        <Setter Property="Text" Value="בקרוב"/>
                                                        <Setter Property="TextColor" Value="{StaticResource Gray400}"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Grid>
                                    </Border>

                                    <!-- Subcategory chips -->
                                    <FlexLayout Wrap="Wrap"
                                                BindableLayout.ItemsSource="{Binding Children}"
                                                IsVisible="{Binding HasChildren}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:TanahpediaCategoryItem">
                                                <Border Padding="10,5"
                                                        Margin="0,0,8,8"
                                                        StrokeShape="RoundRectangle 16"
                                                        Stroke="{StaticResource Gray200}"
                                                        StrokeThickness="1"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenCategoryCommand}"
                                                                              CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                    <HorizontalStackLayout Spacing="6">
                                                        <Label Text="{Binding Label}"
                                                               FontSize="13"
                                                               TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"/>
                                                        <Label Text="{Binding Count}"
                                                               FontSize="12"
                                                               TextColor="{StaticResource Primary}"
                                                               IsVisible="{Binding IsComingSoon, Converter={StaticResource InvertedBoolConverter}}"/>
                                                        <Label Text="בקרוב"
                                                               FontSize="12"
                                                               TextColor="{StaticResource Gray400}"
                                                               IsVisible="{Binding IsComingSoon}"/>
                                                    </HorizontalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- עודכנו לאחרונה -->
                <VerticalStackLayout Spacing="8"
                                     IsVisible="{Binding HasRecent}">
                    <Label Text="עודכנו לאחרונה"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                    <VerticalStackLayout Spacing="4"
                                         BindableLayout.ItemsSource="{Binding RecentEntries}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:TanahpediaEntry">
                                <Label Text="{Binding Title}"
                                       FontSize="15"
                                       TextColor="{StaticResource Primary}"
                                       TextDecorations="Underline"
                                       Margin="0,2">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenEntryCommand}"
                                                              CommandParameter="{Binding UniqueName}"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading overlay -->
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             IsVisible="{Binding IsLoading}">
            <Image Source="loading_book_anim.gif"
                   IsAnimationPlaying="True"
                   HeightRequest="60"
                   WidthRequest="60"
                   Aspect="AspectFit"/>
            <Label Text="טוען תנכפדיה..."
                   FontSize="16"
                   HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>

        <!-- Error state with retry -->
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Padding="24"
                             Spacing="12"
                             IsVisible="{Binding HasError}">
            <Label Text="התוכן אינו זמין כרגע"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
            <Label Text="אירעה שגיאה בטעינת הנתונים"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
            <Button Text="נסו שוב"
                    Command="{Binding LoadCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- Scoped Tanahpedia search overlay — same interaction as the
             reader's floating search, Tanahpedia provider only, all
             categories selected by default on the landing page. -->
        <controls:TanahpediaSearchPanel x:Name="TanahpediaSearch" />
    </Grid>
</ContentPage>
