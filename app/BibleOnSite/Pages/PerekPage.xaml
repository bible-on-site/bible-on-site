<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:BibleOnSite.ViewModels"
             xmlns:models="clr-namespace:BibleOnSite.Models"
             xmlns:controls="clr-namespace:BibleOnSite.Controls"
             xmlns:behaviors="clr-namespace:BibleOnSite.Behaviors"
             xmlns:converters="clr-namespace:BibleOnSite.Converters"
             xmlns:helpers="clr-namespace:BibleOnSite.Helpers"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="BibleOnSite.Pages.PerekPage"
             x:Name="PerekPageRoot"
             x:DataType="viewmodels:PerekViewModel"
             Title="{Binding Source}"
             BackgroundColor="{AppThemeBinding Light=#F2F7FE, Dark=#20304A}"
             FlowDirection="RightToLeft"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="SelectedPasukBackground">#E3F2FD</Color>
            <Color x:Key="SelectedPasukBackgroundDark">#3D5A80</Color>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <converters:PasukDisplayItemsConverter x:Key="PasukDisplayItemsConverter"/>
            <converters:PasukMarkerTextConverter x:Key="PasukMarkerTextConverter" MarkerColor="{StaticResource Primary}" MarkerColorDark="{StaticResource AccentOnDark}"/>
            <x:Double x:Key="BottomBarTotalHeight">90</x:Double>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid x:Name="MainGrid" RowDefinitions="Auto,*">
        <Grid x:Name="ReaderToolbar" Grid.Row="0" MinimumHeightRequest="56"
              BackgroundColor="{AppThemeBinding Light=#F2F7FE, Dark=#20304A}">
            <controls:SharedTopBar x:Name="NormalNavigationBar" NavigationAutomationId="ReaderNavigationButton">
                <controls:SharedTopBar.CenterContent>
                    <Grid>
                <Button x:Name="NormalNavigationTitle"
                   AutomationId="PerekSource"
                   Text="{Binding Source}"
                   FontSize="20"
                   Padding="12,0"
                   HeightRequest="40"
                   CornerRadius="14"
                   BorderWidth="0"
                   IsVisible="True"
                   BackgroundColor="{AppThemeBinding Light=#E4EFFD, Dark=#2C4569}"
                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"
                   VerticalOptions="Center"
                   HorizontalOptions="Fill"
                   Margin="4,0"
                   SemanticProperties.Hint="הקישו לפתיחת החיפוש"
                   ToolTipProperties.Text="חיפוש (Ctrl+F)"
                   Clicked="OnPerekSourceClicked"/>
                <Border x:Name="SearchIntroduction" HorizontalOptions="Fill" VerticalOptions="Center"
                        HeightRequest="40" Margin="4,0" Padding="12,0" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                        BackgroundColor="{AppThemeBinding Light=#E4EFFD, Dark=#2C4569}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPerekSourceClicked"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="SearchIntroductionText" Text="חיפוש בתנ&quot;ך..." FontSize="20" VerticalOptions="Center"
                           HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"/>
                </Border>
                    </Grid>
                </controls:SharedTopBar.CenterContent>
                <controls:SharedTopBar.TrailingContent>
                <Button x:Name="ReaderMenuButton" AutomationId="ReaderMenuButton"
                        Text="{x:Static fonts:FluentUI.more_vertical_24_regular}" FontFamily="FluentIcons" FontSize="20"
                        WidthRequest="48" HeightRequest="44" Padding="0" BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"
                        VerticalOptions="Center" SemanticProperties.Description="אפשרויות הקריאה"
                        Clicked="OnReaderMenuButtonClicked"/>
                </controls:SharedTopBar.TrailingContent>
            </controls:SharedTopBar>
            <ContentView x:Name="SearchTitleHost" IsVisible="False" Margin="0" VerticalOptions="Center"/>
            <controls:ReaderSelectionBar x:Name="SelectionBar"
                  BackRequested="OnSelectionBackClicked"
                  RecitationRequested="OnSelectionRecitationClicked"
                  ShareRequested="OnSelectionShareClicked"
                  CopyRequested="OnSelectionCopyClicked"/>
        </Grid>

        <controls:FloatingSearchBar x:Name="ChapterSearch" Grid.Row="1" ZIndex="300"
                                    IsVisible="False" VerticalOptions="Fill" Margin="0"
                                    ResultSelected="OnSearchResultSelected"/>

        <!-- Exit Full Screen Button (floating, draggable, hidden by default) -->
        <controls:ReaderExitFullscreenButton x:Name="ExitFullScreenButton" Grid.Row="1"
                Margin="16,16,16,100"
                ZIndex="100"/>

        <!-- Word-weighted reading position over the stored pasuk metrics
             (issue #2607): a hairline at the top of the reader viewport. -->
        <ProgressBar x:Name="ReadingProgressBar"
                   AutomationId="ReadingProgressBar"
                   Grid.Row="1"
                   ZIndex="50"
                   HeightRequest="3"
                   Margin="0"
                   VerticalOptions="Start"
                   Progress="{Binding ReadingProgress}"
                   ProgressColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"
                   BackgroundColor="Transparent"/>

        <!-- Main Content Area - fills entire viewport -->
        <Grid x:Name="ContentArea" Grid.Row="1" BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}"
              ZIndex="0"
              RowDefinitions="Auto,Auto,*">

            <!-- Loading overlay — shown while CarouselView initialises its 929-item
                 adapter.  Uses a native ActivityIndicator which animates on the GPU
                 even when the main thread is blocked by the CarouselView layout pass. -->
            <!-- Loading overlay — shown while CarouselView initialises its 929-item adapter. -->
            <controls:ReaderLoadingOverlay x:Name="CarouselLoadingOverlay"
                  Grid.Row="1" Grid.RowSpan="2"
                  ZIndex="10"
                  LoadingText="מתחבר לפרק..."
                  ErrorTitle="שגיאה בטעינת הפרק"
                  AutomationIdPrefix="PerekLoad"
                  RetryRequested="OnPerekLoadRetryClicked"/>

            <!-- CarouselView for page-based swipe navigation (Row 1 + Row 2) -->
            <!-- Each carousel page contains header + full perek view (pasukim CollectionView) -->
            <CarouselView Grid.Row="1"
                          Grid.RowSpan="2"
                          x:Name="PerekCarousel"
                          ItemsSource="{Binding CarouselPerakim}"
                          CurrentItem="{Binding CurrentCarouselPerek, Mode=TwoWay}"
                          Position="{Binding CarouselPosition, Mode=TwoWay}"
                          CurrentItemChanged="OnCarouselItemChanged"
                          Loop="False"
                          PeekAreaInsets="1"
                          Margin="0">
                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="models:Perek">
                        <!-- Full perek page: header + CollectionView of pasukim.
                             On Windows the column caps at ReaderColumnMaxWidth and
                             centers (#2766) — full-bleed text on a maximized
                             monitor is unreadable; touch platforms fill. -->
                        <Grid RowDefinitions="Auto,*"
                              AutomationProperties.ExcludedWithChildren="{Binding IsOffscreenCarouselPage}">
                            <!-- Default must be PositiveInfinity — an explicit -1
                                 collapses the element on mobile (it counts as a set
                                 maximum, not as "unset"). -->
                            <Grid.MaximumWidthRequest>
                                <OnPlatform x:TypeArguments="x:Double" Default="{x:Static x:Double.PositiveInfinity}">
                                    <On Platform="Windows" Value="{x:Static helpers:DesktopLayout.ReaderColumnMaxWidth}"/>
                                </OnPlatform>
                            </Grid.MaximumWidthRequest>
                            <Grid.HorizontalOptions>
                                <OnPlatform x:TypeArguments="LayoutOptions" Default="Fill">
                                    <On Platform="Windows" Value="Center"/>
                                </OnPlatform>
                            </Grid.HorizontalOptions>
                            <!-- Perek Header (Row 0) with קריינות play button -->
                            <Grid Grid.Row="0">
                                <VerticalStackLayout>
                                    <Label AutomationId="PerekHeader"
                                           Text="{Binding Header}"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           Padding="16,12"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}">
                                        <Label.Triggers>
                                            <!-- Keep wrapped header text clear of the floating play button -->
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding BindingContext.ShowHeaderPlayButton, Source={x:Reference PerekPageRoot}}"
                                                         Value="True">
                                                <Setter Property="Padding" Value="56,12"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                        <Label.GestureRecognizers>
                                            <PointerGestureRecognizer PointerPressed="OnHeaderPointerPressed" PointerReleased="OnHeaderPointerReleased" PointerMoved="OnHeaderPointerMoved"/>
                                        </Label.GestureRecognizers>
                                        <Label.Behaviors>
                                            <behaviors:LongPressBehavior LongPressDuration="600" LongPressed="OnHeaderLongPressed"/>
                                        </Label.Behaviors>
                                    </Label>
                                    <!-- Reading-time badge over the whole chapter (issue #2607);
                                         hidden when the stored metric is unknown or empty. -->
                                    <Label AutomationId="PerekReadingTimeBadge"
                                           Text="{Binding ReadingTimeBadge}"
                                           IsVisible="{Binding ReadingTimeBadge, Converter={StaticResource StringNotEmptyConverter}}"
                                           FontSize="12"
                                           HorizontalTextAlignment="Center"
                                           Padding="16,0,16,6"
                                           TextColor="{AppThemeBinding Light=#52647C, Dark=#B2C2D8}"/>
                                    <!-- Perek/sefer/helek dedications (#2731) — bound to the page's
                                         view model, which tracks the displayed perek -->
                                    <VerticalStackLayout Spacing="0"
                                                         Padding="16,0,16,8"
                                                         BindableLayout.ItemsSource="{Binding BindingContext.DedicationLines, Source={x:Reference PerekPageRoot}}"
                                                         IsVisible="{Binding BindingContext.HasDedications, Source={x:Reference PerekPageRoot}}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Label Text="{Binding .}"
                                                       FontSize="13"
                                                       FontAttributes="Italic"
                                                       HorizontalTextAlignment="Center"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                                <!-- קריינות: plays the whole perek; shown when the global
                                     קריינות preference is on and this perek has audio -->
                                <Button x:Name="HeaderPlayButton"
                                        AutomationId="HeaderPlayButton"
                                        Text="{x:Static fonts:FluentUI.headphones_24_regular}"
                                        FontFamily="FluentIcons"
                                        FontSize="20"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Center"
                                        Margin="8,0"
                                        SemanticProperties.Description="השמעת קריאת הפרק"
                                        ToolTipProperties.Text="השמעת קריאת הפרק"
                                        IsVisible="{Binding BindingContext.ShowHeaderPlayButton, Source={x:Reference PerekPageRoot}}"
                                        Clicked="OnHeaderPlayClicked"/>
                            </Grid>

                            <!-- Perek Text - Pasukim List (Row 1) with perushim inline -->
                            <CollectionView Grid.Row="1"
                                            x:Name="PasukimCollection"
                                            AutomationId="PasukimCollection"
                                            IsVisible="{Binding BindingContext.IsTikkunKorimEnabled, Source={x:Reference PerekPageRoot}, Converter={StaticResource InvertedBoolConverter}}"
                                            SelectionMode="None"
                                            Loaded="OnReaderListLoaded"
                                            Scrolled="OnPasukimScrolled"
                                            Margin="8,0,8,0">
                                <CollectionView.ItemsSource>
                                    <MultiBinding Converter="{StaticResource PasukDisplayItemsConverter}">
                                        <Binding Path="Pasukim"/>
                                        <Binding Path="BindingContext.IsShnayimMikraEnabled" Source="{x:Reference PerekPageRoot}"/>
                                        <Binding Path="BindingContext.FontFactor" Source="{x:Reference PerekPageRoot}"/>
                                        <!-- Re-evaluates the items when הסתר שם השם changes so every
                                             realized/recycled row re-reads Pasuk.FormattedText. -->
                                        <Binding Path="BindingContext.DivineNameMaskingRevision" Source="{x:Reference PerekPageRoot}"/>
                                    </MultiBinding>
                                </CollectionView.ItemsSource>
                                <CollectionView.Footer>
                                    <ContentView HeightRequest="{DynamicResource BottomBarTotalHeight}" BackgroundColor="Transparent"/>
                                </CollectionView.Footer>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PasukDisplayItem">
                                        <controls:ReaderCellBorder Padding="12,8"
                                                Margin="0,4"
                                                StrokeShape="RoundRectangle 8"
                                                Stroke="Transparent"
                                                x:Name="PasukBorder"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                                            <Border.FlowDirection>
                                                <OnPlatform x:TypeArguments="FlowDirection">
                                                    <On Platform="iOS" Value="RightToLeft"/>
                                                    <On Platform="MacCatalyst" Value="RightToLeft"/>
                                                </OnPlatform>
                                            </Border.FlowDirection>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Pasuk.IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SelectedPasukBackground}, Dark={StaticResource SelectedPasukBackgroundDark}}"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnPasukTapped"
                                                                      CommandParameter="{Binding PasukNum}"/>
                                                <TapGestureRecognizer Tapped="OnPasukDoubleTapped" NumberOfTapsRequired="2"
                                                                      CommandParameter="{Binding PasukNum}"/>
                                                <TapGestureRecognizer Tapped="OnPasukRightClicked"
                                                                      CommandParameter="{Binding PasukNum}"
                                                                      Buttons="Secondary"/>
                                                <PointerGestureRecognizer PointerPressed="OnPasukPointerPressed"
                                                                          PointerReleased="OnPasukPointerReleased"/>
                                            </Border.GestureRecognizers>
                                            <Border.Behaviors>
                                                <behaviors:LongPressBehavior LongPressDuration="600"
                                                                             LongPressed="OnPasukLongPressed"
                                                                             NativeTapped="OnPasukNativeTapped"/>
                                            </Border.Behaviors>
                                            <VerticalStackLayout Spacing="2">
                                                <controls:PasukTextLabel AutomationId="PasukText"
                                                         FontSize="{Binding FontSize}"
                                                         FlowDirection="RightToLeft"
                                                         LineBreakMode="WordWrap"
                                                         LineHeight="1.4">
                                                    <controls:PasukTextLabel.FormattedText>
                                                        <MultiBinding Converter="{StaticResource PasukMarkerTextConverter}">
                                                            <Binding Path="Pasuk.FormattedText"/>
                                                            <Binding Path="PasukNumHeb"/>
                                                            <Binding Path="MarkerFontSize"/>
                                                        </MultiBinding>
                                                    </controls:PasukTextLabel.FormattedText>
                                                </controls:PasukTextLabel>
                                                <!-- Perushim render once per pasuk on its last copy so
                                                     שניים מקרא reads מקרא, מקרא, פירוש (#2403) -->
                                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding PerushNotes}"
                                                                     IsVisible="{Binding IsLastCopy}"
                                                                     Spacing="2"
                                                                     Margin="0,4,0,0">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="models:PerushNoteDisplay">
                                                            <!-- The whole perush surfaces as one update: a
                                                                 fixed-height loading slot holds the row until
                                                                 the HtmlView publishes its contents, so the
                                                                 name never flashes alone and recycled cells
                                                                 never pair a new name with stale contents (#2451). -->
                                                            <VerticalStackLayout Spacing="2">
                                                                <Grid HeightRequest="36"
                                                                      IsVisible="{Binding IsContentReady, Source={x:Reference PerushContentView}, Converter={StaticResource InvertedBoolConverter}}">
                                                                    <ActivityIndicator IsRunning="True" WidthRequest="20" HeightRequest="20"
                                                                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                                                </Grid>
                                                                <VerticalStackLayout Spacing="2"
                                                                                     IsVisible="{Binding IsContentReady, Source={x:Reference PerushContentView}}">
                                                                    <Label Text="{Binding PerushName}"
                                                                           AutomationId="InlinePerushName"
                                                                           FontSize="{DynamicResource PerushNameFontSize}"
                                                                           FontAttributes="Bold"
                                                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"/>
                                                                    <controls:HtmlView x:Name="PerushContentView" ContentLoader="{Binding ContentLoader}" HtmlContent="{Binding DisplayContent}"
                                                                                      FontSize="{DynamicResource PerushContentFontSize}"
                                                                                      TextAlignment="Justify"
                                                                                      TextDirection="Rtl"
                                                                                      LineHeight="1.4"/>
                                                                </VerticalStackLayout>
                                                            </VerticalStackLayout>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </controls:ReaderCellBorder>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <VerticalStackLayout VerticalOptions="Center"
                                                         HorizontalOptions="Center"
                                                         Padding="20">
                                        <Image Source="loading_book_anim.gif"
                                               IsAnimationPlaying="True"
                                               HeightRequest="60"
                                               WidthRequest="60"
                                               Aspect="AspectFit"/>
                                        <Label Text="מתחבר לפרק..."
                                               AutomationId="PerekLoadingLabel"
                                               FontSize="18"
                                               HorizontalTextAlignment="Center"
                                               Margin="0,10,0,0"/>
                                    </VerticalStackLayout>
                                </CollectionView.EmptyView>
                            </CollectionView>

                            <!-- תיקון קוראים: the whole perek as one continuous flow.
                                 Tapping anywhere toggles niqqud+taamim for the entire perek. -->
                            <ScrollView Grid.Row="1"
                                        AutomationId="TikkunScrollView"
                                        IsVisible="{Binding BindingContext.IsTikkunKorimEnabled, Source={x:Reference PerekPageRoot}}"
                                        Margin="8,0,8,0"
                                        Loaded="OnTikkunLoaded"
                                        Scrolled="OnTikkunScrolled">
                                <VerticalStackLayout>
                                    <!-- MAUI TapGestureRecognizer fails inside CarouselView
                                         templates on Android; LongPressBehavior.NativeTapped
                                         detects the tap natively (same as pasuk rows). The
                                         behavior must sit on the flow view itself — native
                                         Touch fires only on the actual touch target. -->
                                    <controls:TikkunFlowView AutomationId="TikkunText"
                                                             Pasukim="{Binding Pasukim}"
                                                             RepeatEachPasuk="{Binding BindingContext.IsShnayimMikraEnabled, Source={x:Reference PerekPageRoot}}"
                                                             HideMarks="{Binding BindingContext.TikkunMarksHidden, Source={x:Reference PerekPageRoot}}"
                                                             MaskingRevision="{Binding BindingContext.DivineNameMaskingRevision, Source={x:Reference PerekPageRoot}}"
                                                             TextFontSize="{DynamicResource PasukFontSize}">
                                        <controls:TikkunFlowView.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnTikkunTextTapped"/>
                                        </controls:TikkunFlowView.GestureRecognizers>
                                        <controls:TikkunFlowView.Behaviors>
                                            <behaviors:LongPressBehavior NativeTapped="OnTikkunNativeTapped"/>
                                        </controls:TikkunFlowView.Behaviors>
                                    </controls:TikkunFlowView>
                                    <ContentView HeightRequest="{DynamicResource BottomBarTotalHeight}"
                                                 BackgroundColor="Transparent"/>
                                </VerticalStackLayout>
                            </ScrollView>
                        </Grid>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>

            <!-- Articles View (hidden by default, shown when articles button clicked) -->
            <!-- Uses shared ArticleCard component -->
            <!-- Articles View (hidden by default, shown when articles button clicked) -->
            <controls:ReaderArticlesView Grid.Row="2"
                            x:Name="ArticlesCollection"
                            EmptyText="אין מאמרים לפרק זה"
                            SelectedArticleId="{Binding SelectedArticleId}"/>
        </Grid>

        <!-- Perushim Panel (slides up from bottom, above content but behind bottom bar) -->
        <controls:PerushimSheet x:Name="PerushimPanel" Grid.Row="1" ZIndex="50"/>

        <!-- Reader options menu - dropdown anchored under the ⋮ button -->
        <controls:ReaderMenuPanel x:Name="ReaderMenuOverlay" Grid.Row="1" ZIndex="160"
              ShnayimMikraToggled="OnShnayimMikraTapped"
              TikkunKorimToggled="OnTikkunKorimTapped"
              DivineNameMaskingToggled="OnDivineNameMaskingTapped"/>

        <!-- Bottom Navigation Bar - OVERLAY floating at bottom -->
        <controls:ReaderBottomBar x:Name="BottomBar" Grid.Row="1"
              ZIndex="100"/>

        <!-- Circular navigation fan - shared layer (scrim + satellites + FAB) -->
        <controls:ReaderFanMenu x:Name="FanMenu" Grid.Row="1" ZIndex="150">
            <controls:ReaderFanMenu.Satellites>
                <!-- Previous perek (bottom-left satellite). Disabled at perek 1 via Command.CanExecute. -->
                <controls:ReaderFanMenuSatellite x:Name="PrevPerekButton"
                        AutomationId="PrevPerekButton"
                        SemanticProperties.Description="הפרק הקודם"
                        ToolTipProperties.Text="הפרק הקודם"
                        Text="{x:Static fonts:FluentUI.document_arrow_right_24_regular}"
                        Command="{Binding LoadPreviousCommand}"
                        Clicked="OnMenuItemClicked"/>

                <!-- Today's perek (top-left satellite) -->
                <controls:ReaderFanMenuSatellite x:Name="TodayButton"
                        AutomationId="TodayButton"
                        SemanticProperties.Description="הפרק של היום"
                        ToolTipProperties.Text="הפרק של היום"
                        Text="{x:Static fonts:FluentUI.calendar_date_24_regular}"
                        Command="{Binding LoadTodayCommand}"
                        Clicked="OnMenuItemClicked"/>

                <!-- Perek Picker (top-right satellite) -->
                <controls:ReaderFanMenuSatellite x:Name="PerekPickerButton"
                        AutomationId="PerekPickerButton"
                        SemanticProperties.Description="בחירת פרק"
                        ToolTipProperties.Text="בחירת פרק"
                        Text="{x:Static fonts:FluentUI.library_24_regular}"
                        Clicked="OnPerekPickerClicked"/>

                <!-- Next perek (bottom-right satellite). Disabled at perek 929 via Command.CanExecute. -->
                <controls:ReaderFanMenuSatellite x:Name="NextPerekButton"
                        AutomationId="NextPerekButton"
                        SemanticProperties.Description="הפרק הבא"
                        ToolTipProperties.Text="הפרק הבא"
                        Text="{x:Static fonts:FluentUI.document_arrow_right_24_regular}"
                        ScaleX="-1"
                        Command="{Binding LoadNextCommand}"
                        Clicked="OnMenuItemClicked"/>
            </controls:ReaderFanMenu.Satellites>
        </controls:ReaderFanMenu>

        <!-- Focused pasuk overlay - double-tap pasuk detail + its perushim -->
        <controls:FocusedPasukOverlay x:Name="FocusedPasukOverlay" Grid.Row="1" ZIndex="150"
              PlayRequested="OnFocusedPlayClicked"/>
        <controls:RecitationDecoderHost x:Name="RecitationDecoder" Grid.Row="1"/>
        <controls:RecitationPlaybackHost x:Name="RecitationPlayerHost" Grid.Row="1"/>
        <controls:PerekPickerPopup x:Name="PerekPickerPopup" Grid.Row="1"
                                   ZIndex="200"
                                   PerekSelected="OnPerekPickerSelected"/>
    </Grid>

</ContentPage>
