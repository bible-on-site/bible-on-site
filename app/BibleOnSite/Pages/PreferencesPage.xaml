<?xml version="1.0" encoding="utf-8" ?>
<controls:PreferencesPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:controls="clr-namespace:BibleOnSite.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BibleOnSite.ViewModels"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:helpers="clr-namespace:BibleOnSite.Helpers"
             x:Class="BibleOnSite.Pages.PreferencesPage"
             x:DataType="viewmodels:PreferencesViewModel"
             Shell.NavBarIsVisible="False"
             ControlTemplate="{StaticResource PreferencesPageTemplate}"
             Title="העדפות"
             FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource SurfaceDark}}">

    <ScrollView Padding="16,12">
        <!-- Windows: preference rows at monitor width are unscanable (#2766) -->
        <Border Padding="0"
                StrokeShape="RoundRectangle 12"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                StrokeThickness="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
            <Border.MaximumWidthRequest>
                <!-- +∞ = uncapped; an explicit -1 collapses the element on mobile. -->
                <OnPlatform x:TypeArguments="x:Double" Default="{x:Static x:Double.PositiveInfinity}">
                    <On Platform="Windows" Value="{x:Static helpers:DesktopLayout.ContentColumnMaxWidth}"/>
                </OnPlatform>
            </Border.MaximumWidthRequest>
            <Border.HorizontalOptions>
                <OnPlatform x:TypeArguments="LayoutOptions" Default="Fill">
                    <On Platform="Windows" Value="Center"/>
                </OnPlatform>
            </Border.HorizontalOptions>
            <VerticalStackLayout Spacing="0">

                <!-- תצוגה -->
                <Grid ColumnDefinitions="Auto,*,Auto"
                      Padding="16,14"
                      AutomationId="SettingsDisplayRow"
                      SemanticProperties.Description="תצוגה">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenDisplayCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Text="{x:Static fonts:FluentUI.text_font_size_24_regular}"
                           FontFamily="FluentIcons"
                           FontSize="24"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray350}}"
                           VerticalOptions="Center"
                           Margin="0,0,12,0"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="תצוגה"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                        <Label Text="{Binding FontFactor, StringFormat='גודל גופן {0:P0}'}"
                               FontSize="13"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="2"
                           Text="{x:Static fonts:FluentUI.chevron_circle_left_12_regular}"
                           FontFamily="FluentIcons"
                           FontSize="20"
                           TextColor="{StaticResource Gray400}"
                           VerticalOptions="Center"/>
                </Grid>

                <BoxView HeightRequest="1"
                         Margin="0,0,52,0"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"/>

                <!-- על הפרק -->
                <Grid ColumnDefinitions="Auto,*,Auto"
                      Padding="16,14"
                      AutomationId="SettingsPerekRow"
                      SemanticProperties.Description="על הפרק">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenPerekCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Text="{x:Static fonts:FluentUI.calendar_today_24_regular}"
                           FontFamily="FluentIcons"
                           FontSize="24"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray350}}"
                           VerticalOptions="Center"
                           Margin="0,0,12,0"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="על הפרק"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                        <Label Text="{Binding PerekToLoadSummary}"
                               FontSize="13"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="2"
                           Text="{x:Static fonts:FluentUI.chevron_circle_left_12_regular}"
                           FontFamily="FluentIcons"
                           FontSize="20"
                           TextColor="{StaticResource Gray400}"
                           VerticalOptions="Center"/>
                </Grid>

                <BoxView HeightRequest="1"
                         Margin="0,0,52,0"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"/>

                <!-- חבילות הרחבה -->
                <Grid ColumnDefinitions="Auto,*,Auto"
                      Padding="16,14"
                      AutomationId="SettingsPacksRow"
                      SemanticProperties.Description="חבילות הרחבה">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenExtensionPacksCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Text="{x:Static fonts:FluentUI.puzzle_piece_24_regular}"
                           FontFamily="FluentIcons"
                           FontSize="24"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray350}}"
                           VerticalOptions="Center"
                           Margin="0,0,12,0"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="חבילות הרחבה"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                        <Label Text="{Binding PacksSummaryText}"
                               AutomationId="PacksSummaryState"
                               FontSize="13"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="2"
                           Text="{x:Static fonts:FluentUI.chevron_circle_left_12_regular}"
                           FontFamily="FluentIcons"
                           FontSize="20"
                           TextColor="{StaticResource Gray400}"
                           VerticalOptions="Center"/>
                </Grid>

                <BoxView HeightRequest="1"
                         Margin="0,0,52,0"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"/>

                <!-- קריינות -->
                <Grid ColumnDefinitions="Auto,*,Auto"
                      Padding="16,14"
                      AutomationId="RecitationSettingsRow"
                      SemanticProperties.Description="קריינות">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenRecitationCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Text="{x:Static fonts:FluentUI.headphones_24_regular}"
                           FontFamily="FluentIcons"
                           FontSize="24"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray350}}"
                           VerticalOptions="Center"
                           Margin="0,0,12,0"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="קריינות"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                        <Label Text="{Binding RecitationPlaybackSummary}"
                               FontSize="13"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="2"
                           Text="{x:Static fonts:FluentUI.chevron_circle_left_12_regular}"
                           FontFamily="FluentIcons"
                           FontSize="20"
                           TextColor="{StaticResource Gray400}"
                           VerticalOptions="Center"/>
                </Grid>

                <BoxView HeightRequest="1"
                         Margin="0,0,52,0"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"/>

                <!-- שמע -->
                <Grid ColumnDefinitions="Auto,*,Auto"
                      Padding="16,14"
                      AutomationId="SettingsSoundRow"
                      SemanticProperties.Description="שמע">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSoundCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Text="{x:Static fonts:FluentUI.speaker_2_24_regular}"
                           FontFamily="FluentIcons"
                           FontSize="24"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray350}}"
                           VerticalOptions="Center"
                           Margin="0,0,12,0"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="שמע"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                        <Label Text="{Binding SoundSummaryText}"
                               FontSize="13"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="2"
                           Text="{x:Static fonts:FluentUI.chevron_circle_left_12_regular}"
                           FontFamily="FluentIcons"
                           FontSize="20"
                           TextColor="{StaticResource Gray400}"
                           VerticalOptions="Center"/>
                </Grid>

                <BoxView HeightRequest="1"
                         Margin="0,0,52,0"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"/>

                <!-- תמיכה -->
                <Grid ColumnDefinitions="Auto,*,Auto"
                      Padding="16,14"
                      AutomationId="SettingsSupportRow"
                      SemanticProperties.Description="תמיכה">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSupportCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Text="{x:Static fonts:FluentUI.question_circle_24_regular}"
                           FontFamily="FluentIcons"
                           FontSize="24"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray350}}"
                           VerticalOptions="Center"
                           Margin="0,0,12,0"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="תמיכה"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                        <Label Text="ייצוא לוגים לתמיכה"
                               FontSize="13"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="2"
                           Text="{x:Static fonts:FluentUI.chevron_circle_left_12_regular}"
                           FontFamily="FluentIcons"
                           FontSize="20"
                           TextColor="{StaticResource Gray400}"
                           VerticalOptions="Center"/>
                </Grid>

            </VerticalStackLayout>
        </Border>
    </ScrollView>
</controls:PreferencesPageBase>
