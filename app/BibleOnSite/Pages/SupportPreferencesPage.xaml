<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BibleOnSite.ViewModels"
             x:Class="BibleOnSite.Pages.SupportPreferencesPage"
             x:DataType="viewmodels:SupportPreferencesViewModel"
             Title="תמיכה"
             FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource SurfaceDark}}">

    <ScrollView Padding="16,12">
        <VerticalStackLayout Spacing="24">

            <!-- ═══ אבחון ═══ -->
            <VerticalStackLayout Spacing="8">
                <Label Text="אבחון"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       Padding="4,0,0,0"/>

                <Border Padding="16"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="אם משהו לא עובד כצפוי, ייצאו את הלוגים ושלחו אותם לצוות התמיכה."
                               FontSize="15"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                        <Button Text="ייצוא לוגים לתמיכה"
                                Command="{Binding ExportLogsCommand}"
                                AutomationId="ExportPerushimLogsButton"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="8"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ═══ מידע ═══ -->
            <VerticalStackLayout Spacing="8">
                <Label Text="מידע"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       Padding="4,0,0,0"/>

                <Border Padding="16"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="הצהרת הנגישות של התכנית מתוחזקת באתר ומכסה את האתר ואת היישומון."
                               FontSize="15"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                        <Button Text="הצהרת נגישות"
                                Command="{Binding OpenAccessibilityStatementCommand}"
                                AutomationId="AccessibilityStatementButton"
                                SemanticProperties.Description="פתיחת הצהרת הנגישות באתר התכנית"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="8"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
