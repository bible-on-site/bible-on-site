<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BibleOnSite.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="BibleOnSite.Pages.HomePage"
             Title="בית" FlowDirection="RightToLeft" Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F5F7FB, Dark=#162236}">
    <ContentPage.Resources>
        <Style x:Key="HomeHeading" TargetType="Label">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#17283F, Dark=#EDF3FD}"/>
        </Style>
        <Style x:Key="HomeSecondary" TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#637187, Dark=#B8C7DD}"/>
        </Style>
        <Style x:Key="HomeCard" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 18"/>
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#DEE7F4, Dark=#3B5273}"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#20304A}"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="MinimumHeightRequest" Value="98"/>
        </Style>
        <Style x:Key="HomeLink" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#536781, Dark=#B8C7DD}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,12"/>
            <Setter Property="MinimumHeightRequest" Value="48"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
    </ContentPage.Resources>
    <Grid>
        <ScrollView AutomationId="HomeScrollView">
            <VerticalStackLayout Padding="22,24,22,30" Spacing="22" MaximumWidthRequest="680" HorizontalOptions="Fill">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="על הפרק" FontSize="32" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1552AC, Dark=#AACBFF}"/>
                        <Label Text="פותחים את היום בלימוד תנ&quot;ך" Style="{StaticResource HomeSecondary}"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="העדפות" Style="{StaticResource HomeLink}" Clicked="OnPreferencesClicked" VerticalOptions="Center"/>
                </Grid>

                <controls:TappableView x:Name="DailyPerekCard" AutomationId="HomeDailyPerek" Activated="OnDailyPerekTapped"
                                       SemanticProperties.Description="פתיחת הפרק היומי" IsEnabled="False">
                    <Border StrokeShape="RoundRectangle 24" StrokeThickness="0" BackgroundColor="#1552AC" Padding="23">
                        <VerticalStackLayout Spacing="15">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="הפרק היומי" FontSize="15" TextColor="#DCE9FF" FontAttributes="Bold"/>
                                <Label Grid.Column="1" Text="{x:Static fonts:FluentUI.book_open_24_regular}" FontFamily="FluentIcons" FontSize="27" TextColor="White"/>
                            </Grid>
                            <Label x:Name="DailySource" AutomationId="HomeDailySource" Text="טוען את הפרק..." FontSize="32" FontAttributes="Bold" TextColor="White"/>
                            <Label x:Name="DailyTitle" FontSize="16" TextColor="#ECF3FF" MaxLines="2" LineBreakMode="TailTruncation"/>
                            <FlexLayout Wrap="Wrap" AlignItems="Start">
                                <Border BackgroundColor="#3067B7" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12,8" Margin="0,0,0,8">
                                    <Label x:Name="VerseCount" AutomationId="HomeVerseCount" Text="פסוקים" FontSize="14" TextColor="White"/>
                                </Border>
                                <Border BackgroundColor="#3067B7" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12,8" Margin="12,0,0,8">
                                    <Label x:Name="ArticleCount" AutomationId="HomeArticleCount" Text="מאמרים" FontSize="14" TextColor="White"/>
                                </Border>
                            </FlexLayout>
                            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 13" Padding="16,12" Margin="0,3,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="לקריאת הפרק" FontSize="17" FontAttributes="Bold" TextColor="#1552AC" HorizontalTextAlignment="Center"/>
                                    <Label Grid.Column="1" Text="←" FontSize="21" TextColor="#1552AC" VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </controls:TappableView>
                <VerticalStackLayout x:Name="HomeError" IsVisible="False" Spacing="8">
                    <Label Text="לא ניתן לטעון את הפרק כרגע" Style="{StaticResource HomeSecondary}"/>
                    <Button Text="ניסיון נוסף" Clicked="OnRetryClicked"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Label Text="לאן ממשיכים?" Style="{StaticResource HomeHeading}"/>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                        <controls:TappableView AutomationId="HomeIndex" Activated="OnIndexTapped" SemanticProperties.Description="חיפוש לפי אינדקס">
                            <Border Style="{StaticResource HomeCard}" BackgroundColor="{AppThemeBinding Light=#EDF4FF, Dark=#233D60}">
                                <VerticalStackLayout Spacing="9">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="חיפוש" Style="{StaticResource HomeHeading}" TextColor="{AppThemeBinding Light=#1552AC, Dark=#AACBFF}"/>
                                        <Label Grid.Column="1" Text="{x:Static fonts:FluentUI.search_24_regular}" FontFamily="FluentIcons" FontSize="23" TextColor="{AppThemeBinding Light=#1552AC, Dark=#AACBFF}"/>
                                    </Grid>
                                    <Label Text="לפי ספר ופרק" Style="{StaticResource HomeSecondary}"/>
                                </VerticalStackLayout>
                            </Border>
                        </controls:TappableView>
                        <controls:TappableView Grid.Column="1" AutomationId="HomeCalendar" Activated="OnCalendarTapped" SemanticProperties.Description="לוח לימוד יומי">
                            <Border Style="{StaticResource HomeCard}" BackgroundColor="{AppThemeBinding Light=#F4EFFC, Dark=#352C4C}">
                                <VerticalStackLayout Spacing="9">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="לוח שנה" Style="{StaticResource HomeHeading}" TextColor="{AppThemeBinding Light=#7251A1, Dark=#D5B6FF}"/>
                                        <Label Grid.Column="1" Text="{x:Static fonts:FluentUI.calendar_date_24_regular}" FontFamily="FluentIcons" FontSize="23" TextColor="{AppThemeBinding Light=#7251A1, Dark=#D5B6FF}"/>
                                    </Grid>
                                    <Label Text="הפרק לפי תאריך" Style="{StaticResource HomeSecondary}"/>
                                </VerticalStackLayout>
                            </Border>
                        </controls:TappableView>
                        <controls:TappableView Grid.Row="1" AutomationId="HomeMasora" Activated="OnMasoraTapped" SemanticProperties.Description="מסורה על הפרק">
                            <Border Style="{StaticResource HomeCard}">
                                <VerticalStackLayout Spacing="9">
                                    <Label Text="מסורה" Style="{StaticResource HomeHeading}"/>
                                    <Label Text="חלוקת הפרשיות" Style="{StaticResource HomeSecondary}"/>
                                </VerticalStackLayout>
                            </Border>
                        </controls:TappableView>
                        <controls:TappableView Grid.Row="1" Grid.Column="1" AutomationId="HomeAuthors" Activated="OnAuthorsTapped" SemanticProperties.Description="רבנים וכותבים">
                            <Border Style="{StaticResource HomeCard}">
                                <VerticalStackLayout Spacing="9">
                                    <Label Text="רבנים וכותבים" Style="{StaticResource HomeHeading}" FontSize="17"/>
                                    <Label Text="לימוד מזווית נוספת" Style="{StaticResource HomeSecondary}"/>
                                </VerticalStackLayout>
                            </Border>
                        </controls:TappableView>
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="עוד עולמות של לימוד" Style="{StaticResource HomeHeading}"/>
                    <FlexLayout Wrap="Wrap" JustifyContent="Start">
                        <Button Text="תנכפדיה" Style="{StaticResource HomeLink}" Clicked="OnTanahpediaClicked"/>
                        <Button Text="פרשת השבוע" Style="{StaticResource HomeLink}" Clicked="OnParashaClicked"/>
                        <Button Text="מועדים" Style="{StaticResource HomeLink}" Clicked="OnMoadimClicked"/>
                        <Button Text="עלון יומי" Style="{StaticResource HomeLink}" Clicked="OnBulletinClicked"/>
                    </FlexLayout>
                </VerticalStackLayout>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#DEE7F4, Dark=#3B5273}"/>
                <FlexLayout Wrap="Wrap" JustifyContent="Center">
                    <Button Text="צור קשר" Style="{StaticResource HomeLink}" Clicked="OnContactClicked"/>
                    <Button Text="תנאי שימוש" Style="{StaticResource HomeLink}" Clicked="OnTermsClicked"/>
                    <Button Text="תרומות" Style="{StaticResource HomeLink}" Clicked="OnDonationsClicked"/>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
        <controls:PerekPickerPopup x:Name="HomeIndexPicker" AutomationId="HomeIndexPicker" PerekSelected="OnIndexPerekSelected" ZIndex="100"/>
    </Grid>
</ContentPage>
