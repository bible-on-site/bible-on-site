<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BibleOnSite.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="BibleOnSite.Pages.HomePage"
             Title="בית" FlowDirection="RightToLeft" Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F5F7FB, Dark=#111C2C}">
    <ContentPage.Resources>
        <Style x:Key="HomeHeading" TargetType="Label">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#192B45, Dark=#F5F7FB}"/>
        </Style>
        <Style x:Key="HomeSecondary" TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#63738C, Dark=#B8CBE5}"/>
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*">
            <VerticalStackLayout Grid.Row="0" Padding="22,8,22,12" Spacing="10" MaximumWidthRequest="680" HorizontalOptions="Fill">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <HorizontalStackLayout Spacing="9" VerticalOptions="Center">
                        <Border BackgroundColor="#2866E7" StrokeThickness="0" StrokeShape="RoundRectangle 9" WidthRequest="32" HeightRequest="32" Rotation="-8">
                            <Label Text="{x:Static fonts:FluentUI.book_open_24_regular}" FontFamily="FluentIcons" FontSize="20" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False"/>
                        </Border>
                        <Label Text="על הפרק" FontSize="22" FontAttributes="Bold" CharacterSpacing="-0.5"
                               TextColor="{AppThemeBinding Light=#192B45, Dark=#F5F7FB}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Button Grid.Column="1" Text="העדפות" AutomationId="HomePreferences" Clicked="OnPreferencesClicked"
                            FontSize="17" FontAttributes="Bold" HeightRequest="56" MinimumWidthRequest="118" Padding="14,0" CornerRadius="18" ContentLayout="Left,8"
                            BackgroundColor="{AppThemeBinding Light=#E4EAF4, Dark=#243C5D}"
                            TextColor="{AppThemeBinding Light=#1552AC, Dark=#AACBFF}">
                        <Button.ImageSource>
                            <FontImageSource Glyph="{x:Static fonts:FluentUI.settings_24_regular}" FontFamily="FluentIcons" Size="22"
                                             Color="{AppThemeBinding Light=#1552AC, Dark=#AACBFF}"/>
                        </Button.ImageSource>
                    </Button>
                </Grid>
                <controls:TappableView AutomationId="HomeGlobalSearch" Activated="OnGlobalSearchTapped" SemanticProperties.Description="חיפוש בתנ&quot;ך ובפריטי הניווט באפליקציה">
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1D2D43}" Stroke="{AppThemeBinding Light=#D7E1F2, Dark=#334B6C}"
                            StrokeShape="RoundRectangle 16" Padding="16,13">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="{x:Static fonts:FluentUI.search_24_regular}" FontFamily="FluentIcons" FontSize="23"
                                   TextColor="{AppThemeBinding Light=#1552AC, Dark=#AACBFF}" AutomationProperties.IsInAccessibleTree="False"/>
                            <Label Grid.Column="1" Text="חיפוש בתנ&quot;ך ובאפליקציה" FontSize="16" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#63738C, Dark=#B8CBE5}" MaxLines="1" LineBreakMode="TailTruncation"/>
                        </Grid>
                    </Border>
                </controls:TappableView>
            </VerticalStackLayout>
        <ScrollView Grid.Row="1" AutomationId="HomeScrollView">
            <VerticalStackLayout Padding="22,8,22,30" Spacing="20" MaximumWidthRequest="680" HorizontalOptions="Fill">

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="פרק אחד.&#10;עולם שלם." FontSize="43" FontAttributes="Bold" CharacterSpacing="-0.5" LineHeight="1.02"
                           TextColor="{AppThemeBinding Light=#192B45, Dark=#F5F7FB}"/>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="End" Spacing="4" Margin="0,0,0,7">
                        <BoxView HeightRequest="5" WidthRequest="35" Color="#2866E7" HorizontalOptions="End"/>
                        <Label x:Name="TodayLabel" Text="היום" FontSize="13" TextColor="{AppThemeBinding Light=#63738C, Dark=#B8CBE5}"/>
                    </VerticalStackLayout>
                </Grid>

                <controls:TappableView x:Name="DailyPerekCard" AutomationId="HomeDailyPerek" Activated="OnDailyPerekTapped"
                                       SemanticProperties.Description="פתיחת הפרק היומי" IsEnabled="False">
                    <Border StrokeShape="RoundRectangle 28" StrokeThickness="0" BackgroundColor="#102648">
                        <Grid Padding="22">
                            <Label x:Name="DailyGlyph" FontSize="156" FontFamily="TaameyD" TextColor="#AACBFF" Opacity="0.13" Rotation="-12"
                                   HorizontalOptions="End" VerticalOptions="Center" Margin="0,-12,4,0" InputTransparent="True" AutomationProperties.IsInAccessibleTree="False"/>
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="הפרק היומי" FontSize="14" TextColor="#AACBFF" FontAttributes="Bold"/>
                                    <Label Grid.Column="1" Text="פותחים היום" FontSize="12" TextColor="#BCCFEE"/>
                                </Grid>
                                <Label x:Name="DailySource" AutomationId="HomeDailySource" Text="טוען את הפרק..." FontSize="32" FontAttributes="Bold" TextColor="#F8F6EC"/>
                                <Label x:Name="DailyTitle" FontSize="14" TextColor="#D6E2F8" MaxLines="2" LineBreakMode="TailTruncation"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4,0,0">
                                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                        <Label x:Name="VerseCount" AutomationId="HomeVerseCount" Text="פסוקים" FontSize="13" TextColor="#C5D7F4"/>
                                        <Label x:Name="ArticleCount" AutomationId="HomeArticleCount" Text="מאמרים" FontSize="13" TextColor="#C5D7F4"/>
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" BackgroundColor="#2866E7" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="17,13">
                                        <HorizontalStackLayout Spacing="16">
                                            <Label Text="לפרק של היום" FontSize="16" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                                            <Label Text="←" FontSize="22" TextColor="White" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </controls:TappableView>
                <VerticalStackLayout x:Name="HomeError" IsVisible="False" Spacing="8">
                    <Label Text="לא ניתן לטעון את הפרק כרגע" Style="{StaticResource HomeSecondary}"/>
                    <Button Text="ניסיון נוסף" Clicked="OnRetryClicked"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="לאן הסקרנות לוקחת אותך?" Style="{StaticResource HomeHeading}" FontSize="18"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <controls:TappableView AutomationId="HomeIndex" Activated="OnIndexTapped" SemanticProperties.Description="חיפוש לפי אינדקס">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" BackgroundColor="{AppThemeBinding Light=#DEE7F7, Dark=#233956}" Padding="17" MinimumHeightRequest="110">
                                <Grid RowDefinitions="*,Auto" RowSpacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="אינדקס התנ&quot;ך" Style="{StaticResource HomeHeading}" FontSize="18"/>
                                        <Label Grid.Column="1" Text="{x:Static fonts:FluentUI.library_24_regular}" FontFamily="FluentIcons" FontSize="27"
                                               TextColor="{AppThemeBinding Light=#1552AC, Dark=#AACBFF}" AutomationProperties.IsInAccessibleTree="False"/>
                                    </Grid>
                                    <Label Grid.Row="1" Text="לפי ספר ופרק" Style="{StaticResource HomeSecondary}"/>
                                </Grid>
                            </Border>
                        </controls:TappableView>
                        <controls:TappableView Grid.Column="1" AutomationId="HomeCalendar" Activated="OnCalendarTapped" SemanticProperties.Description="לוח לימוד יומי">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" BackgroundColor="#2866E7" Padding="17" MinimumHeightRequest="110">
                                <Grid RowDefinitions="*,Auto" RowSpacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="לוח שנה" FontSize="22" FontAttributes="Bold" TextColor="White"/>
                                        <Label Grid.Column="1" Text="{x:Static fonts:FluentUI.calendar_date_24_regular}" FontFamily="FluentIcons" FontSize="27" TextColor="#C5DAFF" AutomationProperties.IsInAccessibleTree="False"/>
                                    </Grid>
                                    <Label Grid.Row="1" Text="בקצב של היום שלך" FontSize="13" TextColor="#D7E7FF"/>
                                </Grid>
                            </Border>
                        </controls:TappableView>
                    </Grid>
                    <controls:TappableView AutomationId="HomeMasora" Activated="OnMasoraTapped" SemanticProperties.Description="מסורה על הפרק">
                        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#233956}" StrokeThickness="0" StrokeShape="RoundRectangle 22" Padding="18">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" MinimumHeightRequest="58">
                            <Label Text="{x:Static fonts:FluentUI.book_open_24_regular}" FontFamily="FluentIcons" FontSize="30"
                                   TextColor="{AppThemeBinding Light=#2866E7, Dark=#AACBFF}" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="מסורה" Style="{StaticResource HomeHeading}"/>
                                <Label Text="חלוקה מסורתית" Style="{StaticResource HomeSecondary}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="←" FontSize="24" TextColor="{AppThemeBinding Light=#1552AC, Dark=#AACBFF}" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False"/>
                        </Grid>
                        </Border>
                    </controls:TappableView>
                    <controls:TappableView AutomationId="HomeAuthors" Activated="OnAuthorsTapped" SemanticProperties.Description="רבנים וכותבים">
                        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#233956}" StrokeThickness="0" StrokeShape="RoundRectangle 22" Padding="18">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" MinimumHeightRequest="58">
                            <Label Text="{x:Static fonts:FluentUI.people_24_regular}" FontFamily="FluentIcons" FontSize="30"
                                   TextColor="{AppThemeBinding Light=#2866E7, Dark=#AACBFF}" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="עוד קולות" Style="{StaticResource HomeHeading}"/>
                                <Label Text="רבנים וכותבים" Style="{StaticResource HomeSecondary}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="←" FontSize="24" TextColor="{AppThemeBinding Light=#1552AC, Dark=#AACBFF}" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False"/>
                        </Grid>
                        </Border>
                    </controls:TappableView>
                </VerticalStackLayout>

                <controls:TappableView AutomationId="HomeLibrary" Activated="OnLibraryTapped">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 22" Padding="22" MinimumHeightRequest="96"
                            BackgroundColor="{AppThemeBinding Light=#DEE7F7, Dark=#233956}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Label Text="{x:Static fonts:FluentUI.library_24_regular}" FontFamily="FluentIcons" FontSize="30"
                                   TextColor="{AppThemeBinding Light=#1552AC, Dark=#AACBFF}" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                <Label Text="הספרייה" Style="{StaticResource HomeHeading}" FontSize="22"/>
                                <Label Text="עוד דרכים לגלות וללמוד" Style="{StaticResource HomeSecondary}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="←" FontSize="28" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#1552AC, Dark=#AACBFF}"/>
                        </Grid>
                    </Border>
                </controls:TappableView>
            </VerticalStackLayout>
        </ScrollView>
        <controls:PerekPickerPopup x:Name="HomeIndexPicker" Grid.RowSpan="2" AutomationId="HomeIndexPicker" PerekSelected="OnIndexPerekSelected" ZIndex="100"/>
    </Grid>
</ContentPage>
