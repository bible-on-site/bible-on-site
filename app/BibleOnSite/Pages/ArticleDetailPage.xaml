<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BibleOnSite.ViewModels"
             xmlns:controls="clr-namespace:BibleOnSite.Controls"
             x:Class="BibleOnSite.Pages.ArticleDetailPage"
             x:DataType="viewmodels:ArticleDetailViewModel"
             Title="{Binding ArticleName}"
             FlowDirection="RightToLeft"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <!-- The shared navigation capsule (#2467) plus the unified article
             command group (#2786): hamburger and the capsule Back own the
             return affordance at the leading edge, the title pill sits in
             the center slot, and the actions pill (share + fullscreen) owns
             the trailing edge — the same command surface the readers run. -->
        <controls:SharedTopBar x:Name="TopBar" Grid.Row="0" NavigationAutomationId="ArticleDetailMenuButton">
            <controls:SharedTopBar.CenterContent>
                <controls:ToolbarPill>
                    <Label Text="{Binding ArticleName}"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#AACBFF}"/>
                </controls:ToolbarPill>
            </controls:SharedTopBar.CenterContent>
            <controls:SharedTopBar.TrailingContent>
                <controls:ArticleActionsBar x:Name="ArticleActions"
                                            ShareCommand="{Binding ShareCommand}"/>
            </controls:SharedTopBar.TrailingContent>
        </controls:SharedTopBar>

        <!-- Content -->
        <ScrollView x:Name="ArticleScroll"
                    Grid.Row="1"
                    Padding="16,0">
            <VerticalStackLayout Spacing="16">
                <!-- Author section -->
                <VerticalStackLayout HorizontalOptions="Center"
                                     Spacing="8"
                                     Margin="0,16,0,0">
                    <!-- Author Image (tappable) -->
                    <Border WidthRequest="80"
                            HeightRequest="80"
                            StrokeShape="RoundRectangle 40"
                            Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"
                            StrokeThickness="2"
                            HorizontalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToAuthorCommand}"/>
                        </Border.GestureRecognizers>
                        <Image Source="{Binding AuthorImageUrl}"
                               Aspect="AspectFill"
                               WidthRequest="76"
                               HeightRequest="76"/>
                    </Border>

                    <!-- Author Name -->
                    <Label Text="{Binding AuthorName}"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToAuthorCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

                <!-- Divider -->
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                         Margin="32,8"/>

                <!-- Loading indicator -->
                <Image Source="loading_book_anim.gif"
                       IsAnimationPlaying="{Binding IsLoading}"
                       IsVisible="{Binding IsLoading}"
                       HeightRequest="60"
                       WidthRequest="60"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"/>

                <!-- Article Content (dynamic: HtmlView + MediaElement segments) -->
                <VerticalStackLayout x:Name="ArticleContentContainer"
                                     IsVisible="{Binding HasContent}"
                                     Spacing="8"
                                     Margin="0,0,0,32"/>

                <!-- No content message -->
                <Label Text="אין תוכן זמין"
                       IsVisible="{Binding HasContent, Converter={StaticResource InvertedBoolConverter}}"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                       FontSize="14"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- The shared floating exit control — the same draggable button the
             readers show while fullscreen (#2786). -->
        <controls:ReaderExitFullscreenButton x:Name="ExitFullScreenButton" Grid.Row="1"
                Margin="16"
                ZIndex="100"/>
    </Grid>
</ContentPage>
