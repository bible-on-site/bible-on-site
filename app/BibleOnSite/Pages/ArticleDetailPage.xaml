<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BibleOnSite.ViewModels"
             xmlns:controls="clr-namespace:BibleOnSite.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:helpers="clr-namespace:BibleOnSite.Helpers"
             x:Class="BibleOnSite.Pages.ArticleDetailPage"
             x:DataType="viewmodels:ArticleDetailViewModel"
             Title="{Binding ArticleName}"
             FlowDirection="RightToLeft"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <!-- Header with back button, title, and share button -->
        <Grid Grid.Row="0"
              Padding="8,8,8,4"
              ColumnDefinitions="Auto,*,Auto"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
            <Button Grid.Column="0"
                    x:Name="BackButton"
                    Text="→"
                    FontSize="24"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                    Command="{Binding GoBackCommand}"
                    SemanticProperties.Description="חזור"/>

            <Label Grid.Column="1"
                   Text="{Binding ArticleName}"
                   FontSize="16"
                   FontAttributes="Bold"
                   VerticalTextAlignment="Center"
                   LineBreakMode="TailTruncation"
                   MaxLines="1"
                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>

            <Button Grid.Column="2"
                    Text="{x:Static fonts:FluentUI.share_android_24_regular}"
                    FontFamily="FluentIcons"
                    FontSize="22"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                    Command="{Binding ShareCommand}"
                    SemanticProperties.Description="שתף"/>
        </Grid>

        <!-- Content -->
        <ScrollView x:Name="ArticleScroll"
                    Grid.Row="1"
                    Padding="16,0">
            <VerticalStackLayout Spacing="16">
                <VerticalStackLayout.MaximumWidthRequest>
                    <OnPlatform x:TypeArguments="x:Double" Default="-1">
                        <On Platform="Windows" Value="{x:Static helpers:DesktopLayout.ContentColumnMaxWidth}"/>
                    </OnPlatform>
                </VerticalStackLayout.MaximumWidthRequest>
                <VerticalStackLayout.HorizontalOptions>
                    <OnPlatform x:TypeArguments="LayoutOptions" Default="Fill">
                        <On Platform="Windows" Value="Center"/>
                    </OnPlatform>
                </VerticalStackLayout.HorizontalOptions>
                <!-- Author section -->
                <VerticalStackLayout HorizontalOptions="Center"
                                     Spacing="8"
                                     Margin="0,16,0,0">
                    <!-- Author Image (tappable) -->
                    <Border WidthRequest="80"
                            HeightRequest="80"
                            StrokeShape="RoundRectangle 40"
                            Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"
                            StrokeThickness="2"
                            HorizontalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToAuthorCommand}"/>
                        </Border.GestureRecognizers>
                        <Image Source="{Binding AuthorImageUrl}"
                               Aspect="AspectFill"
                               WidthRequest="76"
                               HeightRequest="76"/>
                    </Border>

                    <!-- Author Name -->
                    <Label Text="{Binding AuthorName}"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToAuthorCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

                <!-- Divider -->
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                         Margin="32,8"/>

                <!-- Loading indicator -->
                <Image Source="loading_book_anim.gif"
                       IsAnimationPlaying="{Binding IsLoading}"
                       IsVisible="{Binding IsLoading}"
                       HeightRequest="60"
                       WidthRequest="60"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"/>

                <!-- Article Content (dynamic: HtmlView + MediaElement segments) -->
                <VerticalStackLayout x:Name="ArticleContentContainer"
                                     IsVisible="{Binding HasContent}"
                                     Spacing="8"
                                     Margin="0,0,0,32"/>

                <!-- No content message -->
                <Label Text="אין תוכן זמין"
                       IsVisible="{Binding HasContent, Converter={StaticResource InvertedBoolConverter}}"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                       FontSize="14"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
