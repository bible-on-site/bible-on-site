<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BibleOnSite.ViewModels"
             xmlns:controls="clr-namespace:BibleOnSite.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:helpers="clr-namespace:BibleOnSite.Helpers"
             x:Class="BibleOnSite.Pages.ArticleDetailPage"
             x:DataType="viewmodels:ArticleDetailViewModel"
             Title="{Binding ArticleName}"
             FlowDirection="RightToLeft"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <!-- The shared navigation capsule (#2467): hamburger at the far-right
             edge, Back immediately beside it, title pill, and the article's
             share action in the trailing slot. -->
        <controls:SharedTopBar Grid.Row="0" NavigationAutomationId="ArticleDetailMenuButton">
            <controls:SharedTopBar.CenterContent>
                <controls:ToolbarPill>
                    <Label Text="{Binding ArticleName}"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#AACBFF}"/>
                </controls:ToolbarPill>
            </controls:SharedTopBar.CenterContent>
            <controls:SharedTopBar.TrailingContent>
                <Button Text="{x:Static fonts:FluentUI.share_android_24_regular}"
                        FontFamily="FluentIcons"
                        FontSize="22"
                        WidthRequest="40"
                        Padding="0"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                        Command="{Binding ShareCommand}"
                        VerticalOptions="Center"
                        SemanticProperties.Description="שתף"/>
            </controls:SharedTopBar.TrailingContent>
        </controls:SharedTopBar>

        <!-- Content -->
        <ScrollView x:Name="ArticleScroll"
                    Grid.Row="1"
                    Padding="16,0">
            <VerticalStackLayout Spacing="16">
                <VerticalStackLayout.MaximumWidthRequest>
                    <!-- +∞ = uncapped; an explicit -1 collapses the element on mobile. -->
                    <OnPlatform x:TypeArguments="x:Double" Default="{x:Static x:Double.PositiveInfinity}">
                        <On Platform="Windows" Value="{x:Static helpers:DesktopLayout.ContentColumnMaxWidth}"/>
                    </OnPlatform>
                </VerticalStackLayout.MaximumWidthRequest>
                <VerticalStackLayout.HorizontalOptions>
                    <OnPlatform x:TypeArguments="LayoutOptions" Default="Fill">
                        <On Platform="Windows" Value="Center"/>
                    </OnPlatform>
                </VerticalStackLayout.HorizontalOptions>
                <!-- Author section -->
                <VerticalStackLayout HorizontalOptions="Center"
                                     Spacing="8"
                                     Margin="0,16,0,0">
                    <!-- Author Image (tappable) -->
                    <Border WidthRequest="80"
                            HeightRequest="80"
                            StrokeShape="RoundRectangle 40"
                            Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"
                            StrokeThickness="2"
                            HorizontalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToAuthorCommand}"/>
                        </Border.GestureRecognizers>
                        <Image Source="{Binding AuthorImageUrl}"
                               Aspect="AspectFill"
                               WidthRequest="76"
                               HeightRequest="76"/>
                    </Border>

                    <!-- Author Name -->
                    <Label Text="{Binding AuthorName}"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToAuthorCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

                <!-- Reading-time badge over the full article body (issue #2607);
                     hidden when the metric is unknown or verified-empty. -->
                <Label Text="{Binding ReadingTimeBadge}"
                       IsVisible="{Binding ReadingTimeBadge, Converter={StaticResource StringNotEmptyConverter}}"
                       FontSize="12"
                       AutomationId="ArticleDetailReadingTimeBadge"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#52647C, Dark=#B2C2D8}"/>

                <!-- Divider -->
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                         Margin="32,8"/>

                <!-- Loading indicator -->
                <Image Source="loading_book_anim.gif"
                       IsAnimationPlaying="{Binding IsLoading}"
                       IsVisible="{Binding IsLoading}"
                       HeightRequest="60"
                       WidthRequest="60"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"/>

                <!-- Article Content (dynamic: HtmlView + MediaElement segments) -->
                <VerticalStackLayout x:Name="ArticleContentContainer"
                                     IsVisible="{Binding HasContent}"
                                     Spacing="8"
                                     Margin="0,0,0,32"/>

                <!-- No content message -->
                <Label Text="אין תוכן זמין"
                       IsVisible="{Binding HasContent, Converter={StaticResource InvertedBoolConverter}}"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                       FontSize="14"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
