<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BibleOnSite"
             xmlns:controls="clr-namespace:BibleOnSite.Controls"
             xmlns:converters="clr-namespace:BibleOnSite.Converters"
             x:Class="BibleOnSite.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml"/>
                <ResourceDictionary Source="Resources/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ControlTemplate x:Key="PreferencesPageTemplate">
                <Grid RowDefinitions="Auto,*">
                    <!-- The capsule Back inside SharedTopBar replaces the old
                         text "חזור" button — one recognizable icon at one
                         stable slot on every page (#2467). -->
                    <controls:SharedTopBar NavigationAutomationId="PreferencesNavigationButton"
                                           ShowBack="{TemplateBinding ShowBack}">
                        <controls:SharedTopBar.CenterContent>
                            <controls:ToolbarPill>
                                <Label Text="{TemplateBinding Title}"
                                       AutomationId="PreferencesTitle"
                                       FontSize="16"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentOnDark}}"/>
                            </controls:ToolbarPill>
                        </controls:SharedTopBar.CenterContent>
                    </controls:SharedTopBar>
                    <ContentPresenter Grid.Row="1"/>
                </Grid>
            </ControlTemplate>

            <controls:BottomBarDrawable x:Key="BottomBarDrawable"/>

            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <converters:ZeroToTrueConverter x:Key="ZeroToTrueConverter"/>
            <converters:NotNullConverter x:Key="NotNullConverter"/>
            <converters:FontFactorToSizeConverter x:Key="FontFactorToSizeConverter"/>
            <converters:TanahpediaCategoryLabelConverter x:Key="TanahpediaCategoryLabelConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
