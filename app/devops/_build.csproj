<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <!-- .NET 11's `dotnet run` launches the apphost, making argv[0] the .exe
         while the entry assembly stays the .dll. NUKE 10.1.0 asserts the two
         are equal and crashes on startup. UseAppHost=false keeps `dotnet run`
         invoking `dotnet _build.dll`, which satisfies it. -->
    <UseAppHost>false</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace></RootNamespace>
    <NoWarn>CS0649;CS0169</NoWarn>
    <NukeTelemetryVersion>1</NukeTelemetryVersion>
    <!-- NUKE internals use fields that appear unused -->
  </PropertyGroup>

  <ItemGroup>
    <!-- devops.Tests exercises the pure coverage-merge helpers (#1232). -->
    <InternalsVisibleTo Include="devops.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.AndroidPublisher.v3" Version="1.78.0.4316" />
    <PackageReference Include="Nuke.Common" Version="10.1.0" />
    <!-- Match the NuGet.Frameworks assembly used by .NET SDK 11.0.100's MSBuild. -->
    <PackageReference Include="NuGet.Packaging" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="11.0.0" />
  </ItemGroup>

</Project>
