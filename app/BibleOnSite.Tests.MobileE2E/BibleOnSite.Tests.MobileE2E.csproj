<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit.net v3 test projects are self-running executables. -->
    <OutputType>Exe</OutputType>
    <!-- Run the test exe through Microsoft.Testing.Platform (app/global.json sets dotnet test's runner). -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- #3185: shares the app's endpoint parser and launch-channel constant so
         the harness can never drift from the payload the app consumes. -->
    <Compile Include="..\BibleOnSite\Services\FirebaseEmulatorEndpoint.cs" Link="Services\FirebaseEmulatorEndpoint.cs" />
    <None Update="testconfig.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Appium.WebDriver" Version="9.0.0" />
    <!-- Direct pin lifts the transitive floor (Appium.WebDriver requires >= 4.46.0) to current stable. -->
    <PackageReference Include="Selenium.WebDriver" Version="4.52.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.2" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
