{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", ":dependencyDashboard"],
	"packageRules": [
		{
			"matchUpdateTypes": ["minor", "patch", "pin", "digest"],
			"matchDepTypes": ["devDependencies"],
			"automerge": true
		},
		{
			"labels": ["linting"],
			"matchPackageNames": ["/eslint/", "/biome/"]
		},
		{
			"matchDepTypes": ["optionalDependencies"],
			"addLabels": ["optional"],
			"automerge": true
		},
		{
			"groupName": "all non-major dependencies",
			"groupSlug": "all-minor-patch",
			"matchPackageNames": ["*"],
			"matchUpdateTypes": ["minor", "patch"],
			"automerge": true
		},
		{
			"description": "macos-26 breaks the .NET MAUI iOS build (default Xcode 26); see https://github.com/bible-on-site/bible-on-site/issues/1627",
			"matchManagers": ["github-actions"],
			"matchPackageNames": ["macos"],
			"allowedVersions": "<26"
		},
		{
			"description": "Keep the iOS SDK pins aligned with the Xcode 26.6-compatible workload set; see https://github.com/bible-on-site/bible-on-site/issues/1871",
			"matchManagers": ["github-actions"],
			"matchPackageNames": ["dotnet-sdk"],
			"matchFileNames": [".github/workflows/ci.yml", ".github/workflows/app-package.yml", ".github/workflows/app-mobile-e2e.yml"],
			"matchCurrentValue": "10.0.401",
			"enabled": false
		}
	],
	"vulnerabilityAlerts": {
		"automerge": true,
		"labels": ["security"],
		"groupName": null,
		"schedule": [],
		"dependencyDashboardApproval": false,
		"minimumReleaseAge": null,
		"rangeStrategy": "update-lockfile",
		"commitMessageSuffix": "[SECURITY]",
		"branchTopic": "{{{datasource}}}-{{{depName}}}-vulnerability",
		"prCreation": "immediate"
	},
	"labels": ["dependencies"]
}
