{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", ":dependencyDashboard"],
	"packageRules": [
		{
			"matchUpdateTypes": ["minor", "patch", "pin", "digest"],
			"matchDepTypes": ["devDependencies"],
			"automerge": true
		},
		{
			"labels": ["linting"],
			"matchPackageNames": ["/eslint/", "/biome/"]
		},
		{
			"matchDepTypes": ["optionalDependencies"],
			"addLabels": ["optional"],
			"automerge": true
		},
		{
			"groupName": "all non-major dependencies",
			"groupSlug": "all-minor-patch",
			"matchPackageNames": ["*"],
			"matchUpdateTypes": ["minor", "patch"],
			"automerge": true
		},
		{
			"description": "macos-26 breaks the .NET MAUI iOS build (default Xcode 26); see https://github.com/bible-on-site/bible-on-site/issues/1627",
			"matchManagers": ["github-actions"],
			"matchPackageNames": ["macos"],
			"allowedVersions": "<26"
		},
		{
			"description": "Android 8.7.0 and iOS 12.15.0 bundle vulnerable dependencies that npm overrides cannot replace. The root shell-quote override patches only the non-bundled copy. Update to patched upstream bundles when available; see https://github.com/bible-on-site/bible-on-site/issues/1995",
			"matchManagers": ["npm"],
			"matchFileNames": ["app/mobile-e2e/package.json"],
			"matchPackageNames": ["appium-uiautomator2-driver", "appium-xcuitest-driver"]
		},
		{
			"description": "Jest coverage tooling still pulls unpatched sprintf-js through legacy YAML/argparse. Retain updates and verify removal or a fixed upstream release; see https://github.com/bible-on-site/bible-on-site/issues/1996",
			"matchManagers": ["npm"],
			"matchFileNames": ["web/bible-on-site/package.json"],
			"matchPackageNames": [
				"jest",
				"jest-environment-jsdom",
				"babel-plugin-istanbul",
				"@istanbuljs/load-nyc-config",
				"js-yaml",
				"argparse",
				"sprintf-js"
			]
		}
	],
	"vulnerabilityAlerts": {
		"automerge": true,
		"labels": ["security"],
		"groupName": null,
		"schedule": [],
		"dependencyDashboardApproval": false,
		"minimumReleaseAge": null,
		"rangeStrategy": "update-lockfile",
		"commitMessageSuffix": "[SECURITY]",
		"branchTopic": "{{{datasource}}}-{{{depName}}}-vulnerability",
		"prCreation": "immediate"
	},
	"labels": ["dependencies"]
}
