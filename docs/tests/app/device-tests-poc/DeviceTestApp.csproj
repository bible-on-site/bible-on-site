<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DeviceTestApp</RootNamespace>
    <ApplicationId>com.bibleonsite.devicetests</ApplicationId>
    <ApplicationTitle>DeviceTests PoC</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!-- Results export goes through MediaStore.Downloads, which exists only on
         API 29+ — keep the minimum there so instrumentation can always hand the
         XML back to XHarness. -->
    <SupportedOSPlatformVersion>29.0</SupportedOSPlatformVersion>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.120" />
    <PackageReference Include="Microsoft.DotNet.XHarness.TestRunners.Xunit" Version="11.0.0-prerelease.26466.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.abstractions" Version="2.0.3" />
    <PackageReference Include="xunit.runner.utility" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Parity check: the exact production source the portable suite links,
         compiled here for android so the same assertions run on-device.
         Resolves against the repo root four levels above this project. -->
    <Compile Include="..\..\..\..\app\BibleOnSite\Converters\PasukMarkerTextConverter.cs"
             Link="Linked\PasukMarkerTextConverter.cs" />
  </ItemGroup>

</Project>
