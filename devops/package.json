{
	"type": "module",
	"engines": {
		"node": ">=26.10.0 <27"
	},
	"devDependencies": {
		"@types/node": "26.6.4",
		"@types/semver": "7.8.0",
		"@types/yargs": "17.0.35",
		"tsx": "4.23.15"
	},
	"scripts": {
		"coverage:merge": "node --import tsx ./merge-lcov.mts --out ../.coverage/lcov.info --require ../web/bible-on-site/.coverage/merged/lcov.info --require ../web/api/.coverage/merged/lcov.info --optional ../web/admin/.coverage/merged/lcov.info --optional ../app/.coverage/merged/lcov.info --optional ../data/.coverage/merged/lcov.info --rm-input-dirs",
		"coverage:gaps": "node ./coverage-gaps.mjs",
		"dev": "node --import tsx ./dev-all.mts",
		"setup_dev_env": "node --import tsx ./setup-dev-env.mts",
		"tanahpedia:apply": "node ./tanahpedia-apply.mjs",
		"test:version": "node --import tsx --test merge-lcov.test.mts github/ci/bump-module-versions.test.mts github/ci/publish-version-bumps.test.mts github/release/check-deployment.test.mjs github/release/shared-release.test.mjs github/release/deployment-state.test.mjs github/release/release-assets.test.mjs github/release/data-artifact.test.mjs",
		"bump:module-versions": "node --import tsx ./github/ci/bump-module-versions.ts",
		"deploy": "echo 'Use deploy:ecr, deploy:data, or deploy:bulletin' && exit 1",
		"deploy:ecr": "node --import tsx ./deploy/ecr-deploy/index.mts",
		"deploy:data": "node --import tsx ./deploy/data-deploy/index.mts",
		"test:deploy-data": "node --test deploy/data-deploy/lambda-invocation.test.mts",
		"deploy:bulletin": "node --import tsx ./deploy/bulletin-deploy/index.mts",
		"bump:cargo": "node --import tsx ./bump-cargo-version.ts"
	},
	"dependencies": {
		"@aws-sdk/client-ec2": "3.1146.0",
		"@aws-sdk/client-ecr": "3.1146.0",
		"@aws-sdk/client-lambda": "3.1146.0",
		"@aws-sdk/client-s3": "3.1146.0",
		"@aws-sdk/client-ssm": "3.1146.0",
		"@aws-sdk/client-sts": "3.1146.0",
		"@aws-sdk/credential-providers": "3.1146.0",
		"dotenv": "18.0.5",
		"semver": "7.8.5",
		"yargs": "18.2.0"
	},
	"allowScripts": {
		"esbuild@0.28.1": true
	}
}
