{
	"editor.formatOnSave": true,
	"files.exclude": {
		"data/.s3-sync-temp": true,
		"**/test-results": true,
		"**/.venv": true,
		"**/node_modules": true,
		"app/.artifacts": true,
		"app/.nuke": true,
		"app/**/obj": true,
		"app/**/bin": true,
		"**/__pycache__": true
	},
	"search.exclude": {
		"**/*.tanah_view.json": true,
		"**/*.tanah_view.sqlite": true,
		"**/.output/**": true
	},
	// Keep the file watcher off build/output trees (node_modules and .git are
	// excluded by VS Code defaults).
	"files.watcherExclude": {
		"**/target/**": true,
		"**/.next/**": true,
		"**/.output/**": true,
		"**/artifacts-*/**": true,
		"**/monocart-report/**": true,
		"**/test-results/**": true,
		"**/.coverage/**": true,
		"**/__pycache__/**": true,
		"app/**/bin/**": true,
		"app/**/obj/**": true
	},
	// TODO: Re-enable GitHub Actions extension when modifying workflows
	// See docs/practices/implementation.md for instructions
	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[json]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"rust-analyzer.linkedProjects": [
		"web/api/Cargo.toml",
		"web/api/entities/Cargo.toml",
		"data/Cargo.toml"
	],
	"rust-analyzer.check.command": "clippy",
	"sonarlint.analysisExcludesStandalone": "**/web/**",
	"coverage-gutters.coverageFileNames": ["lcov.info"],
	"coverage-gutters.coverageBaseDir": "{web/bible-on-site/.coverage/{unit,e2e,merged},web/api/.coverage,.coverage}",
	"coverage-gutters.showLineCoverage": true,
	"coverage-gutters.showGutterCoverage": true,
	"editor.codeActionsOnSave": {
		"source.organizeImports.biome": "explicit",
		"source.fixAll.biome": "explicit"
	},
	"github.copilot.enable": {
		"*": true,
		"plaintext": false,
		"markdown": true,
		"scminput": false
	},
	"python-envs.defaultEnvManager": "ms-python.python:system",
	"python-envs.pythonProjects": [],
	"dart.analysisExcludedFolders": ["legacy-app"]
}
