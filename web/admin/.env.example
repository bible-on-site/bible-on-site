# ===========================================
# Admin App Environment Configuration
# ===========================================

# Database connection (omit DB_URL locally to use tanah-dev in dev; see src/server/db-config.ts)
DB_URL=mysql://root:test_123@localhost:3306/tanah-dev

# API URL (for client-side calls - legacy)
VITE_API_URL=http://localhost:3004/api

# ===========================================
# AWS S3 Configuration (server-side)
# ===========================================
S3_REGION=us-east-1
S3_BUCKET=bible-on-site-assets-dev
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key

# ===========================================
# Local S3 (RustFS)
# ===========================================
# Uncomment these for local development with docker-compose:
# S3_ENDPOINT=http://localhost:4566
# S3_FORCE_PATH_STYLE=true
#
# With RustFS, use these credentials (must match docker-compose.yml):
# S3_ACCESS_KEY_ID=test
# S3_SECRET_ACCESS_KEY=test_1234
#
# Start RustFS and initialize buckets: npm run docker:up

# Legacy AWS env vars (also supported as fallback)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Website invalidation endpoint
# REVALIDATE_SECRET is server-side only — never VITE_* (Vite inlines those
# into the browser bundle). Must match the website task's REVALIDATE_SECRET
# (SSM: bible-on-site-revalidate-secret).
VITE_WEBSITE_URL=http://localhost:3001
REVALIDATE_SECRET=dev-secret

# Tanahpedia LLM (server-side only — never VITE_*)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# SES bulletin delivery (server-side only; uses the ECS task role in production)
# Apply the additive database migration before enabling the worker.
# Subscriber addresses and consent belong in the database, never VITE_* variables.
# BULLETIN_SES_REGION=il-central-1
# BULLETIN_SES_FROM=bulletin@example.com
# BULLETIN_SES_REPLY_TO=publisher@example.com
# BULLETIN_SES_SENDER_NAME=תנ"ך על הפרק
# BULLETIN_SES_CONTACT_LIST=bible-on-site-daily-bulletin
# BULLETIN_SES_CONFIGURATION_SET=bible-on-site-daily-bulletin
# BULLETIN_SES_ACCOUNT_ID=123456789012
# BULLETIN_EMAIL_QUEUE_URL=https://sqs.il-central-1.amazonaws.com/123456789012/bible-on-site-daily-bulletin-worker
# BULLETIN_EMAIL_WORKER_ENABLED=false
