{
	"name": "admin",
	"version": "0.1.147",
	"private": true,
	"type": "module",
	"scripts": {
		"predev": "bun run docker:up && node ../../devops/ensure-dev-db.mts && node scripts/ensure-s3-seeded.mjs",
		"dev": "dotenv -e .dev.env -- bun run dev:app",
		"dev:app": "vite --port 3101 --strictPort",
		"build": "vite build",
		"start": "node .output/server/index.mjs",
		"lint": "biome lint",
		"format": "biome format --write",
		"check": "biome check --write",
		"test": "dotenv -e .test.env -- bun run test:all",
		"test:all": "bun run test:unit && bun run test:e2e",
		"test:unit": "vitest run",
		"test:unit:related": "vitest related --run",
		"test:e2e": "dotenv -e .test.env -- playwright test",
		"test:s3": "node scripts/check-local-s3.mjs",
		"coverage:all": "bun run coverage:unit && bun run coverage:e2e && bun run coverage:merge",
		"coverage:unit": "vitest run --coverage",
		"coverage:e2e": "dotenv -e .test.env -- cross-env MEASURE_COV=1 playwright test",
		"coverage:merge": "node ../../devops/merge-lcov.mts --out .coverage/merged/lcov.info --prefix web/admin/ --require .coverage/unit/lcov.info --hits-only .coverage/e2e/lcov.info",
		"docker:up": "docker compose -f ../../devops/docker-compose.yml up -d --wait --wait-timeout 180 && docker compose -f ../../devops/docker-compose.yml run --build --rm --no-deps rustfs-init",
		"docker:down": "docker compose -f ../../devops/docker-compose.yml down",
		"db:populate:dev": "cd ../../data && cargo make mysql-populate-dev",
		"db:populate:dev:test-articles": "cd ../../data && cargo make mysql-populate-dev-with-test-articles",
		"db:populate:test": "cd ../../data && cargo make mysql-populate-test",
		"s3:populate:dev": "cd ../../data && cargo make s3-populate-dev",
		"s3:populate:test": "cd ../../data && cargo make s3-populate-test",
		"metrics:backfill": "bun run scripts/backfill-reading-metrics.mts"
	},
	"engines": {
		"node": ">=26.10.0 <27"
	},
	"dependencies": {
		"@aws-sdk/client-lambda": "3.1156.0",
		"@aws-sdk/client-s3": "3.1156.0",
		"@aws-sdk/s3-request-presigner": "3.1156.0",
		"@tanstack/react-query": "5.104.5",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-devtools": "1.167.2",
		"@tanstack/react-start": "1.169.4",
		"@tiptap/core": "3.32.0",
		"@tiptap/extension-bullet-list": "3.32.0",
		"@tiptap/extension-document": "3.32.0",
		"@tiptap/extension-image": "3.32.0",
		"@tiptap/extension-italic": "3.32.0",
		"@tiptap/extension-link": "3.32.0",
		"@tiptap/extension-list": "3.32.0",
		"@tiptap/extension-list-item": "3.32.0",
		"@tiptap/extension-ordered-list": "3.32.0",
		"@tiptap/extension-placeholder": "3.32.0",
		"@tiptap/pm": "3.32.0",
		"@tiptap/react": "3.32.0",
		"@tiptap/starter-kit": "3.32.0",
		"dompurify": "3.4.17",
		"jose": "6.2.13",
		"mysql2": "3.24.6",
		"nitro": "3.0.260903-beta",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tiptap-footnotes": "3.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@playwright/test": "1.64.1",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@types/istanbul-lib-coverage": "2.0.6",
		"@types/istanbul-lib-instrument": "1.7.8",
		"@types/istanbul-lib-source-maps": "4.0.4",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"@vitest/coverage-v8": "5.0.5",
		"cross-env": "10.1.0",
		"dotenv-cli": "11.0.0",
		"istanbul-lib-coverage": "3.2.2",
		"istanbul-lib-instrument": "6.0.3",
		"istanbul-lib-source-maps": "5.0.6",
		"jsdom": "30.1.3",
		"monocart-reporter": "2.15.1",
		"rolldown": "1.2.15",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vite-plugin-istanbul": "9.0.1",
		"vitest": "5.0.5"
	},
	"optionalDependencies": {
		"@emnapi/core": "1.11.3",
		"@emnapi/runtime": "1.11.3",
		"@emnapi/wasi-threads": "2.2.0",
		"@napi-rs/wasm-runtime": "1.2.6",
		"@tybys/wasm-util": "0.10.4"
	},
	"packageManager": "bun@1.4.4",
	"overrides": {
		"deepmerge-ts": "8.0.2",
		"@istanbuljs/load-nyc-config": {
			"js-yaml": "^5.4.3"
		}
	}
}