{
	"name": "bible-on-site",
	"version": "0.2.420",
	"private": true,
	"license": "MIT",
	"browserslist": [
		"chrome >= 109",
		"edge >= 109",
		"firefox >= 115",
		"safari >= 16",
		"ios_saf >= 16",
		"not dead"
	],
	"scripts": {
		"update": "npx npm-check-updates --peer --deep -u && npm install && npm install && npm run update:playwright",
		"update:playwright": "npx playwright install",
		"predev": "node scripts/kill-port.mjs 3001 && node scripts/ensure-docker-desktop.mjs && node scripts/ensure-dev-db.mjs && docker compose -f ../../devops/docker-compose.yml up -d minio && node scripts/toggle-flip-book-dep.mjs local && npm install --prefer-offline",
		"dev": "dotenv -e .dev.env -- next dev -p 3001",
		"dev-webpack": "dotenv -e .dev.env -- next dev --webpack -p 3001",
		"build": "next build && npm run postbuild",
		"postinstall": "node scripts/copy-local-flip-book.mjs",
		"flip-book:local": "node scripts/toggle-flip-book-dep.mjs local && npm install",
		"flip-book:npm": "node scripts/toggle-flip-book-dep.mjs npm && npm install",
		"flip-book:check": "node scripts/toggle-flip-book-dep.mjs check",
		"postbuild": "shx cp -r public .next/standalone/ && shx cp -r .next/static .next/standalone/.next/ && shx cp -r node_modules/@img .next/standalone/node_modules/",
		"start": "cross-env PORT=3001 HOSTNAME=127.0.0.1 node .next/standalone/server.js",
		"lint": "biome lint",
		"test:all": "npm run test:unit && npm run test:e2e && npm run test:perf",
		"test:unit": "node --no-deprecation --trace-deprecation --import tsx ./node_modules/jest/bin/jest.js",
		"test:e2e": "dotenv -e .test.env -- playwright test --config=playwright.e2e.config.ts --project=Desktop",
		"test:e2e:all": "dotenv -e .test.env -- playwright test --config=playwright.e2e.config.ts",
		"test:perf": "echo 'NOTE: Perf tests require npm run build first (uses production server)' && dotenv -e .test.env -- playwright test --config=playwright.perf.config.ts",
		"coverage:all": "npm run coverage:unit && npm run coverage:e2e && npm run coverage:merge",
		"coverage:unit": "cross-env MEASURE_COV=1 node --no-deprecation --import tsx ./node_modules/jest/bin/jest.js",
		"coverage:gaps": "node scripts/coverage-gaps.mjs",
		"coverage:e2e": "dotenv -e .test.env -- cross-env MEASURE_COV=1 playwright test --config=playwright.e2e.config.ts --project=Desktop",
		"coverage:merge": "node --import tsx ./tests/util/coverage/merge-coverage.mts",
		"package": "cross-env-shell \"docker build -t bible-on-site:${npm_package_version} .\"",
		"version": "cross-env-shell echo ${npm_package_version}"
	},
	"bin": {
		"biome": "./node_modules/@biomejs/biome/bin/biome"
	},
	"engines": {
		"node": ">=26.10.0 <27"
	},
	"overrides": {
		"brace-expansion": "5.0.9",
		"deepmerge-ts": "8.0.2",
		"postcss": "8.5.28",
		"sharp": "0.35.5"
	},
	"dependencies": {
		"@aws-sdk/client-lambda": "3.1142.0",
		"@hebcal/core": "6.10.0",
		"@pdf-lib/fontkit": "1.1.1",
		"flowbite": "4.0.2",
		"flowbite-react": "0.12.17",
		"gematry": "1.0.2",
		"html-flip-book-react": "0.0.0-alpha.36",
		"isomorphic-dompurify": "4.4.0",
		"leaflet": "1.9.4",
		"moment-timezone": "0.6.4",
		"mysql2": "3.24.4",
		"next": "16.4.0-canary.52",
		"nuqs": "2.10.1",
		"pdf-lib": "1.17.1",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-phone-number-input": "3.4.18",
		"sharp": "0.35.5",
		"sunrise-sunset-js": "3.3.1",
		"temporal-polyfill": "1.0.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@playwright/test": "1.63.0",
		"@swc/core": "1.16.12",
		"@swc/jest": "0.2.39",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@types/jest": "30.0.0",
		"@types/leaflet": "1.9.22",
		"@types/node": "26.6.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"cross-env": "10.1.0",
		"dotenv-cli": "11.0.0",
		"get-port": "7.2.0",
		"jest": "30.5.2",
		"jest-environment-jsdom": "30.5.2",
		"jest-junit": "17.0.0",
		"lighthouse": "13.5.0",
		"monocart-reporter": "2.13.1",
		"picomatch": "4.0.7",
		"postcss": "8.5.28",
		"sass": "1.105.0",
		"schema-dts": "2.0.0",
		"shx": "0.4.0",
		"swc-plugin-coverage-instrument": "0.0.33",
		"ts-jest": "29.4.14",
		"ts-node": "10.9.2",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"web-vitals": "6.2.2"
	}
}
