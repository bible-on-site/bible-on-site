{
	// TODO: make dedicated tsconfig for different kind of tests (unit, e2e, performance, etc)
	"compilerOptions": {
		"target": "esnext",
		"module": "ESNext",
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"strictPropertyInitialization": true,
		"resolveJsonModule": true,
		"allowJs": true,
		"noImplicitThis": true,
		"alwaysStrict": true,
		"noEmit": true,
		"declaration": true,
		"declarationMap": true,
		"moduleResolution": "node",
		"outDir": "./dist",
		"rootDir": "../..",
		"baseUrl": ".",
		"ignoreDeprecations": "6.0",
		"types": ["node", "jest"],
		"jsx": "preserve"
	},

	"include": [
		"../shared/**/*.ts",
		"globals.d.ts",
		"./**/*.ts",
		"util/coverage/merge-coverage.mts",
		"playwright.config.js"
	]
}
