# S3 Configuration (RustFS)
S3_REGION=us-east-1
S3_BUCKET=bible-on-site-assets-dev
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test_1234
S3_ENDPOINT=http://localhost:4566
